{
  "$contract": "soter://contracts/host-projection-definition/v2",
  "contractVersion": "2.0.0",
  "id": "host-projection.codex",
  "host": "codex",
  "version": "0.3.0",
  "generator": {
    "id": "core.host-projection-generator",
    "version": "2.1.0"
  },
  "target": {
    "root": "consumer-root",
    "pathPolicy": "normalized-relative",
    "symlinkPolicy": "reject"
  },
  "ownership": {
    "mode": "whole-file",
    "collision": "reject-unmanaged",
    "localEdit": "fail-closed",
    "sharedOutput": "prohibited",
    "retirement": "remove-managed"
  },
  "renderContext": [
    "configuration-id", "host-id", "pack-ids", "capability-ids",
    "workflow-guide-ids", "effect-policy-modes", "provider-requirements",
    "development-guards"
  ],
  "outputs": [
    {
      "id": "output.codex.instructions",
      "path": "AGENTS.md",
      "role": "instructions",
      "template": "soter/hosts/codex/templates/AGENTS.md.tmpl",
      "encoding": "utf-8",
      "newline": "lf",
      "finalNewline": true,
      "mode": "0644",
      "renderContext": [
        "configuration-id", "host-id", "pack-ids", "capability-ids",
        "provider-requirements", "development-guards"
      ]
    },
    {
      "id": "output.codex.tools",
      "path": ".codex/config.toml",
      "role": "tools",
      "template": "soter/hosts/codex/templates/config.toml.tmpl",
      "encoding": "utf-8",
      "newline": "lf",
      "finalNewline": true,
      "mode": "0644",
      "renderContext": ["host-id"]
    }
  ],
  "collections": [
    {
      "id": "collection.codex.workflow-guides",
      "role": "skills",
      "sourceContract": "soter://contracts/workflow-guide/v2",
      "selection": "selected-pack-active",
      "pathPrefix": ".agents/skills/",
      "outputs": [
        {
          "id": "skill",
          "relativePath": "SKILL.md",
          "format": "codex-skill-v1",
          "template": "soter/hosts/codex/templates/workflow-guide.SKILL.md.tmpl",
          "encoding": "utf-8",
          "newline": "lf",
          "finalNewline": true,
          "mode": "0644"
        },
        {
          "id": "metadata",
          "relativePath": "agents/openai.yaml",
          "format": "codex-openai-yaml-v1",
          "template": "soter/hosts/codex/templates/workflow-guide.openai.yaml.tmpl",
          "encoding": "utf-8",
          "newline": "lf",
          "finalNewline": true,
          "mode": "0644"
        }
      ]
    }
  ],
  "limitations": [
    "This definition projects local deterministic guidance, the Soter Core route, and selected active explicit-only workflow skills; it excludes unselected guides and does not install Codex or prove launch, discovery, authentication, provider reachability, connected behavior, or health."
  ]
}
