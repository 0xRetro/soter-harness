{
  "$contract": "soter://contracts/host-projection-definition/v2",
  "contractVersion": "2.0.0",
  "id": "host-projection.claude",
  "host": "claude",
  "version": "0.3.1",
  "generator": {
    "id": "core.host-projection-generator",
    "version": "2.1.0"
  },
  "target": {
    "root": "consumer-root",
    "pathPolicy": "normalized-relative",
    "symlinkPolicy": "reject"
  },
  "ownership": {
    "mode": "whole-file",
    "collision": "reject-unmanaged",
    "localEdit": "fail-closed",
    "sharedOutput": "prohibited",
    "retirement": "remove-managed"
  },
  "renderContext": [
    "configuration-id", "host-id", "pack-ids", "capability-ids",
    "workflow-guide-ids", "effect-policy-modes", "provider-requirements",
    "development-guards"
  ],
  "outputs": [
    {
      "id": "output.claude.instructions",
      "path": "CLAUDE.md",
      "role": "instructions",
      "template": "soter/hosts/claude/templates/CLAUDE.md.tmpl",
      "encoding": "utf-8",
      "newline": "lf",
      "finalNewline": true,
      "mode": "0644",
      "renderContext": [
        "configuration-id", "host-id", "pack-ids", "capability-ids",
        "provider-requirements", "development-guards"
      ]
    },
    {
      "id": "output.claude.tools",
      "path": ".mcp.json",
      "role": "tools",
      "template": "soter/hosts/claude/templates/mcp.json.tmpl",
      "encoding": "utf-8",
      "newline": "lf",
      "finalNewline": true,
      "mode": "0644",
      "renderContext": ["host-id"]
    }
  ],
  "collections": [
    {
      "id": "collection.claude.workflow-guides",
      "role": "skills",
      "sourceContract": "soter://contracts/workflow-guide/v2",
      "selection": "selected-pack-active",
      "pathPrefix": ".claude/skills/",
      "outputs": [
        {
          "id": "skill",
          "relativePath": "SKILL.md",
          "format": "claude-skill-v1",
          "template": "soter/hosts/claude/templates/workflow-guide.SKILL.md.tmpl",
          "encoding": "utf-8",
          "newline": "lf",
          "finalNewline": true,
          "mode": "0644"
        }
      ]
    }
  ],
  "limitations": [
    "This definition projects local deterministic guidance, the Soter Core route, and selected active explicit-only workflow skills; candidate and legacy Claude skills, hooks, settings, plugin files, task allowlists, and checker delivery are not silently adopted as generated outputs."
  ]
}
