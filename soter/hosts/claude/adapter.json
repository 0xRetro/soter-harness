{
  "$contract": "soter://contracts/host-adapter/v2",
  "contractVersion": "2.0.0",
  "id": "host.claude",
  "host": "claude",
  "version": "0.3.1",
  "releaseStage": "experimental",
  "evidenceMaturity": "declared",
  "summary": "Maps the working Claude-oriented prototype into the target host-adapter boundary for later behavior-level conformance.",
  "projectionDefinition": {
    "id": "host-projection.claude",
    "version": "0.3.1",
    "path": "soter/hosts/claude/projection.json"
  },
  "projections": [
    { "path": "CLAUDE.md", "role": "instructions" },
    { "path": ".mcp.json", "role": "tools" }
  ],
  "projectionCollections": [
    {
      "id": "collection.claude.workflow-guides",
      "role": "skills",
      "pathPrefix": ".claude/skills/",
      "sourceContract": "soter://contracts/workflow-guide/v2",
      "selection": "selected-pack-active"
    }
  ],
  "mcpServers": [
    {
      "id": "soter",
      "delivery": "project",
      "state": "configured",
      "configurationPath": ".mcp.json",
      "toolMappings": [],
      "reason": "The project config exposes the provider-neutral Core service through a local stdio MCP server."
    },
    {
      "id": "notion",
      "delivery": "plugin",
      "state": "declared",
      "toolMappings": [
        {
          "logical": "fetch",
          "native": "Notion:notion-fetch",
          "responseProfile": "notion.claude.plugin.v1"
        },
        {
          "logical": "query_data_sources",
          "native": "Notion:notion-query-data-sources",
          "responseProfile": "notion.claude.plugin.v1"
        },
        {
          "logical": "create_pages",
          "native": "Notion:notion-create-pages",
          "responseProfile": "notion.claude.plugin.v1"
        },
        {
          "logical": "update_page",
          "native": "Notion:notion-update-page",
          "responseProfile": "notion.claude.plugin.v1"
        }
      ],
      "reason": "Existing unmanaged plugin files are not silently adopted by the deterministic host projection."
    },
    {
      "id": "otter",
      "delivery": "project",
      "state": "declared",
      "toolMappings": [
        {
          "logical": "fetch",
          "native": "mcp__otter__fetch",
          "responseProfile": "otter.mcp.v1"
        },
        {
          "logical": "get_user_info",
          "native": "mcp__otter__get_user_info",
          "responseProfile": "otter.mcp.v1"
        }
      ],
      "reason": "The adapter maps the Otter route, but the deterministic projection does not embed provider endpoints or authentication configuration."
    },
    {
      "id": "slack",
      "delivery": "plugin",
      "state": "declared",
      "toolMappings": [
        {
          "logical": "list_workspaces",
          "native": "mcp__plugin_slack_slack__slack_list_workspaces",
          "responseProfile": "slack.claude.plugin.v1"
        },
        {
          "logical": "list_user_conversations",
          "native": "mcp__plugin_slack_slack__slack_list_user_conversations",
          "responseProfile": "slack.claude.plugin.v1"
        },
        {
          "logical": "list_channel_members",
          "native": "mcp__plugin_slack_slack__slack_list_channel_members",
          "responseProfile": "slack.claude.plugin.v1"
        },
        {
          "logical": "read_channel",
          "native": "mcp__plugin_slack_slack__slack_read_channel",
          "responseProfile": "slack.claude.plugin.v1"
        },
        {
          "logical": "read_thread",
          "native": "mcp__plugin_slack_slack__slack_read_thread",
          "responseProfile": "slack.claude.plugin.v1"
        }
      ],
      "reason": "The declared Slack plugin route supplies exact read-only workspace, conversation, participant, message, and thread tools; it is not silently adopted by host realization and does not prove launch, discovery, authentication, pagination conformance, readiness, verification, or health."
    }
  ],
  "mechanisms": {
    "instructions": "available",
    "skills": "available",
    "tools": "available",
    "lifecycle": "declared",
    "compactionRehydration": "declared",
    "backgroundRuns": "declared",
    "structuredOutput": "declared"
  },
  "conformance": {
    "maxLevel": "static",
    "scenarios": []
  },
  "limitations": [
    "The adapter can deterministically project selected active workflow guides as explicit-only skills, while unselected and unmanaged skills remain excluded from generated ownership; host launch, discovery, authentication, connected behavior, and health are not proven."
  ]
}
