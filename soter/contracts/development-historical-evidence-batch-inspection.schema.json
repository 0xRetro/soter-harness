{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/development-historical-evidence-batch-inspection/v1",
  "title": "Development Historical Evidence Batch Inspection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "requestFingerprint",
    "createdAt",
    "validUntil",
    "state",
    "basis",
    "progress",
    "outputs",
    "failure",
    "authority",
    "privacy",
    "claimBoundary",
    "health"
  ],
  "properties": {
    "$contract": {
      "const": "soter://contracts/development-historical-evidence-batch-inspection/v1"
    },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^development-historical-evidence-batch[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
    "createdAt": { "$ref": "#/$defs/instant" },
    "validUntil": { "$ref": "#/$defs/instant" },
    "state": {
      "enum": ["request-ready", "running", "completed", "rolled-back", "needs-attention"]
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicTreeFingerprint",
        "developmentTreeFingerprint",
        "hostGraphFingerprints",
        "workflowCount",
        "hostCount",
        "chainCount"
      ],
      "properties": {
        "publicTreeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "developmentTreeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "hostGraphFingerprints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claude", "codex"],
          "properties": {
            "claude": { "$ref": "#/$defs/fingerprint" },
            "codex": { "$ref": "#/$defs/fingerprint" }
          }
        },
        "workflowCount": { "const": 7 },
        "hostCount": { "const": 2 },
        "chainCount": { "const": 14 }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "total", "currentPath", "pending"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0, "maximum": 14 },
        "total": { "const": 14 },
        "currentPath": {
          "type": ["string", "null"],
          "pattern": "^soter/evidence/development/development-agent-migration-evidence[.](?:codex|claude)[.][a-z0-9]+(?:-[a-z0-9]+)*[.]json$"
        },
        "pending": { "type": "integer", "minimum": 0, "maximum": 14 }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "path",
          "documentFingerprint",
          "contentFingerprint",
          "state"
        ],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1, "maximum": 14 },
          "path": {
            "type": "string",
            "pattern": "^soter/evidence/development/development-agent-migration-evidence[.](?:codex|claude)[.][a-z0-9]+(?:-[a-z0-9]+)*[.]json$"
          },
          "documentFingerprint": { "$ref": "#/$defs/fingerprint" },
          "contentFingerprint": { "$ref": "#/$defs/fingerprint" },
          "state": { "enum": ["pending", "exact", "interrupted", "rolled-back", "blocked"] }
        }
      }
    },
    "failure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reasonCode", "summary"],
          "properties": {
            "reasonCode": {
              "type": "string",
              "pattern": "^DEVELOPMENT_HISTORICAL_EVIDENCE_BATCH_[A-Z0-9_]+$"
            },
            "summary": {
              "enum": [
                "Historical evidence publication stopped and exact rollback completed.",
                "Historical evidence publication requires checkpoint-bound reconciliation."
              ]
            }
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "grantsExecution",
        "grantsApproval",
        "grantsActivation",
        "grantsFixtureMutation",
        "grantsFinalLockMutation",
        "grantsProviderRead",
        "grantsProviderWrite",
        "grantsHostCall"
      ],
      "properties": {
        "kind": { "const": "historical-evidence-publication-only" },
        "grantsExecution": { "const": false },
        "grantsApproval": { "const": false },
        "grantsActivation": { "const": false },
        "grantsFixtureMutation": { "const": false },
        "grantsFinalLockMutation": { "const": false },
        "grantsProviderRead": { "const": false },
        "grantsProviderWrite": { "const": false },
        "grantsHostCall": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privateRequestPathsIncluded",
        "privateRequestIdsIncluded",
        "privateStateIncluded",
        "absolutePathsIncluded",
        "rawDiffsIncluded",
        "credentialsIncluded",
        "providerResponsesIncluded"
      ],
      "properties": {
        "privateRequestPathsIncluded": { "const": false },
        "privateRequestIdsIncluded": { "const": false },
        "privateStateIncluded": { "const": false },
        "absolutePathsIncluded": { "const": false },
        "rawDiffsIncluded": { "const": false },
        "credentialsIncluded": { "const": false },
        "providerResponsesIncluded": { "const": false }
      }
    },
    "claimBoundary": {
      "const": "Exact create-only local historical evidence bytes only; lifecycle activation, fixture materialization, final locks, provider behavior, host behavior, readiness, connected verification, and health are not evaluated."
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "ready", "verified", "healthy"],
      "properties": {
        "valid": { "enum": ["passed", "unknown"] },
        "ready": { "const": "unknown" },
        "verified": { "const": "unknown" },
        "healthy": { "const": "unknown" }
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "completed" } }, "required": ["state"] },
      "then": {
        "properties": {
          "failure": { "type": "null" },
          "health": { "properties": { "valid": { "const": "passed" } } }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "enum": ["request-ready", "running"] } },
        "required": ["state"]
      },
      "then": { "properties": { "failure": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "state": { "enum": ["rolled-back", "needs-attention"] } },
        "required": ["state"]
      },
      "then": { "properties": { "failure": { "type": "object" } } }
    }
  ]
}
