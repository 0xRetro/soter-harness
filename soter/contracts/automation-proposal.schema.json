{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/automation-proposal/v1",
  "title": "Soter durable private Automation proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "id", "automation", "runId", "createdAt",
    "configurationLockFingerprint", "graphFingerprint", "decision", "producer",
    "state", "proposalType", "review", "limitations", "authority", "privacy",
    "proposalFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/automation-proposal/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^proposal\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "automation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^automation\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "runId": { "type": "string", "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "configurationLockFingerprint": { "$ref": "#/$defs/fingerprint" },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "fingerprint", "decisionType", "contextSnapshotId",
        "contextSnapshotFingerprint"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^decision\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "decisionType": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "contextSnapshotId": { "type": "string", "pattern": "^context\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "contextSnapshotFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "host"],
      "properties": {
        "kind": { "enum": ["host", "user", "fixture"] },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "host": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      },
      "allOf": [{
        "if": { "properties": { "kind": { "const": "host" } } },
        "then": { "properties": { "host": { "type": "string" } } },
        "else": { "properties": { "host": { "type": "null" } } }
      }]
    },
    "state": { "const": "ready-for-review" },
    "proposalType": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "review": { "type": "object", "minProperties": 1 },
    "limitations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 12 }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "reasonCode", "permittedNextAction"],
      "properties": {
        "state": { "const": "none" },
        "reasonCode": { "const": "AUTOMATION_PROPOSAL_REVIEW_ONLY" },
        "permittedNextAction": { "const": "inspect-private-proposal-material" }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "scope", "rawProviderResponsesIncluded", "credentialValuesIncluded",
        "privateValuesIncluded", "workspaceInspectionIncluded", "evidenceIncluded",
        "canonicalArtifactsWritten", "externalWritesPerformed"
      ],
      "properties": {
        "scope": { "const": "private-sanitized-proposal" },
        "rawProviderResponsesIncluded": { "const": false },
        "credentialValuesIncluded": { "const": false },
        "privateValuesIncluded": { "const": false },
        "workspaceInspectionIncluded": { "const": false },
        "evidenceIncluded": { "const": false },
        "canonicalArtifactsWritten": { "const": false },
        "externalWritesPerformed": { "const": false }
      }
    },
    "proposalFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
