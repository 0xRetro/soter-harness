{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/development-run-inspection/v1",
  "title": "Soter sanitized development run inspection",
  "type": "object",
  "additionalProperties": false,
  "required": ["$contract", "contractVersion", "request", "result", "workflow", "host", "configuration", "workspace", "invocation", "applicability", "requestBoundary", "progress", "changes", "checks", "effects", "promotion", "authority", "privacy", "limitations", "inspectionFingerprint"],
  "properties": {
    "$contract": { "const": "soter://contracts/development-run-inspection/v1" },
    "contractVersion": { "const": "1.0.0" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/requestId" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "createdAt": { "$ref": "#/$defs/instant" }
      }
    },
    "result": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "fingerprint", "state", "completedAt", "evidenceBasis"],
          "properties": {
            "id": { "$ref": "#/$defs/resultId" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "state": { "enum": ["passed", "failed", "blocked", "partial"] },
            "completedAt": { "$ref": "#/$defs/instant" },
            "evidenceBasis": {
              "oneOf": [
                { "$ref": "#/$defs/hostReportedEvidenceBasis" },
                { "$ref": "#/$defs/independentlyEvaluatedEvidenceBasis" }
              ]
            }
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "evaluatedSubjectFingerprint", "definitionFingerprint", "guideContentFingerprint", "evaluationSetFingerprint"],
      "properties": {
        "id": { "$ref": "#/$defs/workflowId" },
        "version": { "$ref": "#/$defs/version" },
        "evaluatedSubjectFingerprint": { "$ref": "#/$defs/fingerprint" },
        "definitionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "guideContentFingerprint": { "$ref": "#/$defs/fingerprint" },
        "evaluationSetFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapterFingerprint", "evaluatedInstructionFingerprint", "candidateProjectionFingerprint", "managedManifestFingerprint"],
      "properties": {
        "id": { "enum": ["codex", "claude"] },
        "adapterFingerprint": { "$ref": "#/$defs/fingerprint" },
        "evaluatedInstructionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidateProjectionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "managedManifestFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lockFingerprint", "graphFingerprint"],
      "properties": {
        "name": { "$ref": "#/$defs/slug" },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootIdentityFingerprint", "revisionFingerprint", "treeFingerprint", "untargetedTreeFingerprint", "exactInputState", "policyFingerprint", "settingsFingerprint"],
      "properties": {
        "rootIdentityFingerprint": { "$ref": "#/$defs/fingerprint" },
        "revisionFingerprint": { "$ref": "#/$defs/nullableFingerprint" },
        "treeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "untargetedTreeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "exactInputState": { "enum": ["clean", "dirty", "unknown"] },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "settingsFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "profile", "requestedLocalEffects", "targetIds", "plannedRuns"],
      "properties": {
        "kind": { "enum": ["develop", "evaluation-suite"] },
        "profile": { "enum": ["exact", "bounded", "open"] },
        "requestedLocalEffects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["local-workspace-read", "local-workspace-write", "local-command", "subagent-dispatch"] }
        },
        "targetIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "plannedRuns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sequence", "caseId", "arm", "guideState"],
            "properties": {
              "id": { "$ref": "#/$defs/evaluationRunId" },
              "sequence": { "type": "integer", "minimum": 1 },
              "caseId": { "$ref": "#/$defs/slug" },
              "arm": { "enum": ["baseline", "guided"] },
              "guideState": { "enum": ["withheld", "candidate"] }
            }
          }
        }
      }
    },
    "applicability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reasonCode"],
          "properties": {
            "state": { "const": "current" },
            "reasonCode": { "const": "DEVELOPMENT_REQUEST_CURRENT" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reasonCode"],
          "properties": {
            "state": { "const": "stale" },
            "reasonCode": {
              "enum": [
                "DEVELOPMENT_REQUEST_BINDING_STALE",
                "DEVELOPMENT_REQUEST_HOST_REALIZATION_STALE",
                "DEVELOPMENT_REQUEST_TARGET_STALE",
                "DEVELOPMENT_REQUEST_WORKSPACE_STALE"
              ]
            }
          }
        }
      ]
    },
    "requestBoundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reasonCode", "permittedNextAction", "declared", "effective"],
          "properties": {
            "state": { "const": "current" },
            "reasonCode": { "const": "DEVELOPMENT_REQUEST_CURRENT" },
            "permittedNextAction": { "const": "perform-request-scoped-development" },
            "declared": { "$ref": "#/$defs/effectBoundary" },
            "effective": { "$ref": "#/$defs/effectBoundary" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reasonCode", "permittedNextAction", "declared", "effective"],
          "properties": {
            "state": { "const": "stale" },
            "reasonCode": {
              "enum": [
                "DEVELOPMENT_REQUEST_BINDING_STALE",
                "DEVELOPMENT_REQUEST_HOST_REALIZATION_STALE",
                "DEVELOPMENT_REQUEST_TARGET_STALE",
                "DEVELOPMENT_REQUEST_WORKSPACE_STALE"
              ]
            },
            "permittedNextAction": { "const": "create-new-development-request" },
            "declared": { "$ref": "#/$defs/effectBoundary" },
            "effective": { "$ref": "#/$defs/closedEffectBoundary" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reasonCode", "permittedNextAction", "declared", "effective"],
          "properties": {
            "state": { "const": "closed" },
            "reasonCode": { "const": "DEVELOPMENT_RESULT_RECORDED" },
            "permittedNextAction": { "const": "none" },
            "declared": { "$ref": "#/$defs/effectBoundary" },
            "effective": { "$ref": "#/$defs/closedEffectBoundary" }
          }
        }
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "completedRuns", "totalRuns", "judgments"],
      "properties": {
        "state": { "enum": ["requested", "passed", "failed", "blocked", "partial"] },
        "completedRuns": { "type": "integer", "minimum": 0 },
        "totalRuns": { "type": "integer", "minimum": 0 },
        "judgments": { "type": "integer", "minimum": 0 }
      }
    },
    "changes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/change" }
    },
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "observedFingerprint"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "state": { "enum": ["passed", "failed", "blocked", "unknown"] },
          "observedFingerprint": { "$ref": "#/$defs/nullableFingerprint" }
        }
      }
    },
    "effects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/effect" }
    },
    "promotion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "artifactFingerprint", "reasonCode", "decisionEvidenceIds"],
          "properties": {
            "state": { "enum": ["not-requested", "held"] },
            "artifactFingerprint": { "type": "null" },
            "reasonCode": { "$ref": "#/$defs/reasonCode" },
            "decisionEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "artifactFingerprint", "reasonCode", "decisionEvidenceIds"],
          "properties": {
            "state": { "enum": ["proposed", "accepted", "declined"] },
            "artifactFingerprint": { "$ref": "#/$defs/fingerprint" },
            "reasonCode": { "$ref": "#/$defs/reasonCode" },
            "decisionEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "grantsExecution", "grantsApproval", "grantsProviderRead", "grantsProviderWrite", "grantsPublication", "grantsMerge", "grantsProtectedRootMutation", "grantsHostRealization"],
      "properties": {
        "kind": { "const": "inspection-only" },
        "grantsExecution": { "const": false },
        "grantsApproval": { "const": false },
        "grantsProviderRead": { "const": false },
        "grantsPublication": { "const": false },
        "grantsMerge": { "const": false },
        "grantsProviderWrite": { "const": false },
        "grantsProtectedRootMutation": { "const": false },
        "grantsHostRealization": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolutePathsIncluded", "targetPathsIncluded", "requestedOutcomeIncluded", "rawDiffsIncluded", "rawTranscriptsIncluded", "providerResponsesIncluded", "credentialsIncluded"],
      "properties": {
        "absolutePathsIncluded": { "const": false },
        "targetPathsIncluded": { "const": false },
        "requestedOutcomeIncluded": { "const": false },
        "rawDiffsIncluded": { "const": false },
        "rawTranscriptsIncluded": { "const": false },
        "providerResponsesIncluded": { "const": false },
        "credentialsIncluded": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 12, "maxLength": 500 }
    },
    "inspectionFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "allOf": [
    {
      "if": {
        "required": ["invocation"],
        "properties": {
          "invocation": {
            "required": ["kind"],
            "properties": { "kind": { "const": "develop" } }
          }
        }
      },
      "then": {
        "properties": {
          "invocation": {
            "properties": {
              "targetIds": { "minItems": 1 },
              "plannedRuns": { "maxItems": 0 }
            }
          },
          "progress": {
            "properties": {
              "completedRuns": { "const": 0 },
              "totalRuns": { "const": 0 },
              "judgments": { "const": 0 }
            }
          },
          "result": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["evidenceBasis"],
                "properties": {
                  "evidenceBasis": { "$ref": "#/$defs/hostReportedEvidenceBasis" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["invocation"],
        "properties": {
          "invocation": {
            "required": ["kind"],
            "properties": { "kind": { "const": "evaluation-suite" } }
          }
        }
      },
      "then": {
        "properties": {
          "invocation": {
            "properties": {
              "targetIds": { "maxItems": 0 },
              "plannedRuns": { "minItems": 2 }
            }
          },
          "result": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["evidenceBasis"],
                "properties": {
                  "evidenceBasis": { "$ref": "#/$defs/independentlyEvaluatedEvidenceBasis" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "result": { "type": "null" },
            "requestBoundary": { "properties": { "state": { "enum": ["current", "stale"] } } },
            "progress": {
              "properties": {
                "state": { "const": "requested" },
                "completedRuns": { "const": 0 },
                "judgments": { "const": 0 }
              }
            },
            "changes": { "maxItems": 0 },
            "checks": { "maxItems": 0 },
            "effects": { "maxItems": 0 },
            "promotion": {
              "properties": {
                "state": { "const": "not-requested" },
                "artifactFingerprint": { "type": "null" },
                "reasonCode": { "const": "DEVELOPMENT_RESULT_NOT_RECORDED" },
                "decisionEvidenceIds": { "maxItems": 0 }
              }
            }
          }
        },
        {
          "properties": {
            "result": { "type": "object", "properties": { "state": { "const": "passed" } } },
            "requestBoundary": { "properties": { "state": { "const": "closed" } } },
            "progress": { "properties": { "state": { "const": "passed" } } },
            "checks": {
              "minItems": 1,
              "items": {
                "properties": {
                  "state": { "const": "passed" },
                  "observedFingerprint": { "$ref": "#/$defs/fingerprint" }
                }
              }
            },
            "effects": { "minItems": 10, "maxItems": 10 }
          }
        },
        {
          "properties": {
            "result": { "type": "object", "properties": { "state": { "const": "failed" } } },
            "requestBoundary": { "properties": { "state": { "const": "closed" } } },
            "progress": { "properties": { "state": { "const": "failed" } } },
            "effects": { "minItems": 10, "maxItems": 10 }
          }
        },
        {
          "properties": {
            "result": { "type": "object", "properties": { "state": { "const": "blocked" } } },
            "requestBoundary": { "properties": { "state": { "const": "closed" } } },
            "progress": { "properties": { "state": { "const": "blocked" } } },
            "effects": { "minItems": 10, "maxItems": 10 }
          }
        },
        {
          "properties": {
            "result": { "type": "object", "properties": { "state": { "const": "partial" } } },
            "requestBoundary": { "properties": { "state": { "const": "closed" } } },
            "progress": { "properties": { "state": { "const": "partial" } } },
            "effects": { "minItems": 10, "maxItems": 10 }
          }
        }
      ]
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "requestId": { "type": "string", "pattern": "^development-request[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "resultId": { "type": "string", "pattern": "^development-result[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "workflowId": { "type": "string", "pattern": "^automation[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "evaluationRunId": { "type": "string", "pattern": "^evaluation-run[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)$" },
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]{3})?Z$" },
    "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "beforeFingerprint", "afterFingerprint"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "create" },
            "beforeFingerprint": { "type": "null" },
            "afterFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "beforeFingerprint", "afterFingerprint"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "modify" },
            "beforeFingerprint": { "$ref": "#/$defs/fingerprint" },
            "afterFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "beforeFingerprint", "afterFingerprint"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "remove" },
            "beforeFingerprint": { "$ref": "#/$defs/fingerprint" },
            "afterFingerprint": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "beforeFingerprint", "afterFingerprint"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "unchanged" },
            "beforeFingerprint": { "$ref": "#/$defs/nullableFingerprint" },
            "afterFingerprint": { "$ref": "#/$defs/nullableFingerprint" }
          }
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "scope", "state", "count", "observedFingerprint"],
          "properties": {
            "category": { "enum": ["local-workspace-read", "local-workspace-write", "local-command", "subagent-dispatch"] },
            "scope": { "const": "request-scoped" },
            "state": { "const": "observed" },
            "count": { "type": "integer", "minimum": 1 },
            "observedFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "scope", "state", "count", "observedFingerprint"],
          "properties": {
            "category": { "enum": ["local-workspace-read", "local-workspace-write", "local-command", "subagent-dispatch"] },
            "scope": { "const": "request-scoped" },
            "state": { "enum": ["not-observed", "blocked", "unknown"] },
            "count": { "const": 0 },
            "observedFingerprint": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "scope", "state", "count", "observedFingerprint"],
          "properties": {
            "category": { "enum": ["provider-read", "provider-write", "publication", "merge", "protected-root-mutation", "host-realization"] },
            "scope": { "const": "separate-authority" },
            "state": { "const": "not-observed" },
            "count": { "const": 0 },
            "observedFingerprint": { "type": "null" }
          }
        }
      ]
    },
    "hostReportedEvidenceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCode", "independentlyVerified"],
      "properties": {
        "state": { "const": "host-reported" },
        "reasonCode": { "const": "DEVELOPMENT_RESULT_HOST_REPORTED_UNVERIFIED" },
        "independentlyVerified": { "const": false }
      }
    },
    "independentlyEvaluatedEvidenceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCode", "independentlyVerified"],
      "properties": {
        "state": { "const": "independently-evaluated" },
        "reasonCode": { "const": "DEVELOPMENT_RESULT_INDEPENDENT_EVALUATION_RECORDED" },
        "independentlyVerified": { "const": true }
      }
    },
    "effectBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localWorkspaceRead", "localWorkspaceWrite", "localCommand", "subagentDispatch", "providerRead", "providerWrite", "publication", "merge", "protectedRootMutation", "hostRealization"],
      "properties": {
        "localWorkspaceRead": { "enum": ["request-scoped", "not-requested"] },
        "localWorkspaceWrite": { "enum": ["request-scoped", "not-requested"] },
        "localCommand": { "enum": ["request-scoped", "not-requested"] },
        "subagentDispatch": { "enum": ["request-scoped", "not-requested"] },
        "providerRead": { "const": "separate-authority" },
        "providerWrite": { "const": "separate-authority" },
        "publication": { "const": "separate-authority" },
        "merge": { "const": "separate-authority" },
        "protectedRootMutation": { "const": "separate-authority" },
        "hostRealization": { "const": "separate-authority" }
      }
    },
    "closedEffectBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localWorkspaceRead", "localWorkspaceWrite", "localCommand", "subagentDispatch", "providerRead", "providerWrite", "publication", "merge", "protectedRootMutation", "hostRealization"],
      "properties": {
        "localWorkspaceRead": { "const": "closed" },
        "localWorkspaceWrite": { "const": "closed" },
        "localCommand": { "const": "closed" },
        "subagentDispatch": { "const": "closed" },
        "providerRead": { "const": "separate-authority" },
        "providerWrite": { "const": "separate-authority" },
        "publication": { "const": "separate-authority" },
        "merge": { "const": "separate-authority" },
        "protectedRootMutation": { "const": "separate-authority" },
        "hostRealization": { "const": "separate-authority" }
      }
    }
  }
}
