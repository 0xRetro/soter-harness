{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/approval-request/v1",
  "title": "Soter exact connected operation approval request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "id", "createdAt", "expiresAt",
    "configuration", "run", "batch", "batchFingerprint", "changeSet",
    "changeSetFingerprint", "scope", "reason", "requestFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/approval-request/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^approval-request\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "expiresAt": { "type": "string", "minLength": 20 },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "configurationBasis", "path", "lockPath",
        "lockFingerprint", "graphFingerprint", "host"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "configurationBasis": { "const": "private-active" },
        "path": { "type": "string", "minLength": 1 },
        "lockPath": { "type": "string", "minLength": 1 },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "host": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "fingerprint"],
      "properties": {
        "id": { "type": "string", "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "path": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "batch": { "type": "object" },
    "batchFingerprint": { "$ref": "#/$defs/fingerprint" },
    "changeSet": { "type": "object" },
    "changeSetFingerprint": { "$ref": "#/$defs/fingerprint" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeSetId", "changeSetFingerprint", "operationBatchId",
        "operationBatchFingerprint", "configurationLockFingerprint", "effects"
      ],
      "properties": {
        "changeSetId": { "type": "string", "minLength": 1 },
        "changeSetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "operationBatchId": { "type": "string", "minLength": 1 },
        "operationBatchFingerprint": { "$ref": "#/$defs/fingerprint" },
        "configurationLockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "effects": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["write", "destructive"] }
        }
      }
    },
    "reason": { "type": "string", "minLength": 8 },
    "requestFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
