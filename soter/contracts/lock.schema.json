{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/lock/v1",
  "title": "Soter resolved configuration lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "configuration",
    "resolver",
    "host",
    "packs",
    "dependencies",
    "capabilities",
    "bindings",
    "sources",
    "authorities",
    "effectPolicies",
    "settings",
    "projections",
    "graphFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/lock/v1" },
    "contractVersion": { "const": "1.0.0" },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "fingerprint", "hostSelection"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "hostSelection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "source"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "source": { "enum": ["configuration", "override"] }
          }
        }
      }
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "core.resolver" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "adapter", "version", "manifestFingerprint",
        "projectionDefinition", "projectionGenerator"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "manifestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "projectionDefinition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "path", "fingerprint"],
          "properties": {
            "id": { "type": "string", "pattern": "^host-projection\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
            "version": { "$ref": "#/$defs/version" },
            "path": { "type": "string", "pattern": "^soter/hosts/[a-z0-9-]+/projection\\.json$" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        "projectionGenerator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "core.host-projection-generator" },
            "version": { "$ref": "#/$defs/version" }
          }
        }
      }
    },
    "packs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "layer",
          "releaseStage",
          "evidenceMaturity",
          "source",
          "reason",
          "manifestFingerprint",
          "artifacts"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "$ref": "#/$defs/version" },
          "layer": {
            "enum": ["kernel", "core", "context", "automation", "integration"]
          },
          "releaseStage": {
            "enum": ["experimental", "preview", "stable", "deprecated"]
          },
          "evidenceMaturity": {
            "enum": ["declared", "fixture-proven", "contained-proven", "live-proven"]
          },
          "source": {
            "enum": ["base", "user", "bundle", "recommendation", "dependency", "binding"]
          },
          "reason": { "type": "string", "minLength": 12 },
          "manifestFingerprint": { "$ref": "#/$defs/fingerprint" },
          "artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "role", "fingerprint"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "role": {
                  "enum": ["definition", "implementation", "projection", "evaluation", "fixture", "migration"]
                },
                "fingerprint": { "$ref": "#/$defs/fingerprint" }
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "version", "optional", "reason"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 12 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "contractFingerprint"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "$ref": "#/$defs/version" },
          "contractFingerprint": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "capabilityVersion",
          "providerPack",
          "providerVersion",
          "authorities",
          "effects",
          "reason"
        ],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "capabilityVersion": { "$ref": "#/$defs/version" },
          "providerPack": { "type": "string", "minLength": 1 },
          "providerVersion": { "$ref": "#/$defs/version" },
          "authorities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "effects": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/effect" }
          },
          "reason": { "type": "string", "minLength": 12 }
        }
      }
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "capabilityVersion",
          "authority",
          "input",
          "inputFingerprint",
          "readiness",
          "consumers",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^source\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "capability": { "type": "string", "minLength": 3 },
          "capabilityVersion": { "$ref": "#/$defs/version" },
          "authority": {
            "type": "string",
            "pattern": "^authority\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "input": { "type": "object" },
          "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
          "readiness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "reason"],
            "properties": {
              "mode": { "enum": ["probe-read", "runtime-only"] },
              "reason": { "type": "string", "minLength": 20 }
            }
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pack", "purpose", "subjects", "reason"],
              "properties": {
                "pack": { "type": "string", "minLength": 3 },
                "purpose": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "subjects": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                  }
                },
                "reason": { "type": "string", "minLength": 20 }
              }
            }
          },
          "reason": { "type": "string", "minLength": 20 }
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "subject", "uri", "reason", "declarationFingerprint"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": {
            "enum": ["definition", "instance", "provider", "projection", "evidence"]
          },
          "subject": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 12 },
          "declarationFingerprint": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "effectPolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "disclosure", "write", "dispatch", "destructive"],
      "properties": {
        "read": { "$ref": "#/$defs/effectPolicy" },
        "disclosure": { "$ref": "#/$defs/effectPolicy" },
        "write": { "$ref": "#/$defs/effectPolicy" },
        "dispatch": { "$ref": "#/$defs/effectPolicy" },
        "destructive": { "$ref": "#/$defs/effectPolicy" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": true
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "path", "role", "mode", "templatePath", "templateFingerprint",
          "contentFingerprint", "fingerprint"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^output\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "path": { "type": "string", "minLength": 1 },
          "role": {
            "enum": ["instructions", "skills", "tools", "lifecycle", "configuration"]
          },
          "mode": { "const": "0644" },
          "templatePath": { "type": "string", "pattern": "^soter/hosts/[a-z0-9-]+/templates/[A-Za-z0-9._-]+$" },
          "templateFingerprint": { "$ref": "#/$defs/fingerprint" },
          "contentFingerprint": { "$ref": "#/$defs/fingerprint" },
          "fingerprint": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "effect": {
      "enum": ["read", "disclosure", "write", "dispatch", "destructive"]
    },
    "effectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": { "enum": ["allow", "confirm", "prohibit"] },
        "reason": { "type": "string", "minLength": 8 }
      }
    }
  }
}
