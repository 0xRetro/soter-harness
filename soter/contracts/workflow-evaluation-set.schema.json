{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/workflow-evaluation-set/v2",
  "title": "Soter active host-guided workflow evaluation set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "workflow",
    "version",
    "lifecycle",
    "cases",
    "evaluationPolicy",
    "privacy",
    "limitations"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/workflow-evaluation-set/v2" },
    "contractVersion": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^evaluation-set[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "workflow": { "type": "string", "pattern": "^automation[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": { "$ref": "#/$defs/version" },
    "lifecycle": { "$ref": "#/$defs/activeLifecycle" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "evaluationPolicy": { "$ref": "#/$defs/hostGuidedPolicy" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawPromptsIncluded", "workspaceSpecificValuesIncluded", "privateInputsIncluded", "rawTranscriptsIncluded", "absolutePathsIncluded"],
      "properties": {
        "rawPromptsIncluded": { "const": false },
        "workspaceSpecificValuesIncluded": { "const": false },
        "privateInputsIncluded": { "const": false },
        "rawTranscriptsIncluded": { "const": false },
        "absolutePathsIncluded": { "const": false }
      }
    },
    "limitations": { "$ref": "#/$defs/limitations" }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)$" },
    "contractReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^soter://contracts/[a-z0-9]+(?:-[a-z0-9]+)*/v[0-9]+$" },
        "path": { "type": "string", "pattern": "^soter/contracts/[a-z0-9]+(?:-[a-z0-9]+)*[.]schema[.]json$" }
      }
    },
    "activeLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authority", "permittedNextAction"],
      "properties": {
        "state": { "const": "active-host-guided" },
        "authority": { "const": "request-bound-development-evidence" },
        "permittedNextAction": { "const": "run-exact-evaluation-suite" }
      }
    },
    "hostGuidedPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "requestContract", "resultContract", "freshWorkerPerCase", "expectationsWithheld", "baselineRequired", "baselineCaseId", "baselineOutcome", "supportedHosts", "authority"],
      "properties": {
        "runner": { "const": "core-development-request" },
        "requestContract": { "$ref": "#/$defs/contractReference" },
        "resultContract": { "$ref": "#/$defs/contractReference" },
        "freshWorkerPerCase": { "const": true },
        "expectationsWithheld": { "const": true },
        "baselineRequired": { "const": true },
        "baselineCaseId": { "const": "happy-path" },
        "baselineOutcome": { "const": "observed-not-gating" },
        "supportedHosts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["codex", "claude"] }
        },
        "authority": { "const": "request-bound-evidence-only" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "kind", "stimulus", "expectedObservations", "prohibitedOutcomes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 100 },
        "kind": { "enum": ["happy-path", "invariant", "pressure", "regression"] },
        "stimulus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "conditions"],
          "properties": {
            "summary": { "type": "string", "minLength": 12, "maxLength": 500 },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 8, "maxLength": 300 }
            }
          }
        },
        "expectedObservations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 8, "maxLength": 400 }
        },
        "prohibitedOutcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 8, "maxLength": 400 }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 12, "maxLength": 400 }
    }
  }
}
