{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/connected-transaction-checkpoint/v2",
  "title": "Soter pack-compiled verified connected transaction checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "id", "kind", "profile", "createdAt",
    "updatedAt", "startedAt", "state", "configuration", "configurationLock", "graphFingerprint",
    "host", "run", "batch", "batchFingerprint", "changeSet",
    "changeSetFingerprint", "approval", "approvalFingerprint", "operations",
    "current", "result", "privacy", "checkpointFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/connected-transaction-checkpoint/v2" },
    "contractVersion": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^checkpoint\\.transaction\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "kind": { "const": "connected-transaction" },
    "profile": { "const": "verified-write-sequence" },
    "createdAt": { "type": "string", "minLength": 20 },
    "updatedAt": { "type": "string", "minLength": 20 },
    "startedAt": { "type": "string", "minLength": 20 },
    "state": { "enum": ["requested", "completed", "failed", "needs-attention"] },
    "configuration": { "$ref": "#/$defs/configurationSelection" },
    "configurationLock": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "fingerprint"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "adapter", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourcePath", "statePath", "fingerprint"],
      "properties": {
        "id": { "type": "string", "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "statePath": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "batch": { "type": "object" },
    "batchFingerprint": { "$ref": "#/$defs/fingerprint" },
    "changeSet": { "type": "object" },
    "changeSetFingerprint": { "$ref": "#/$defs/fingerprint" },
    "approval": { "type": "object" },
    "approvalFingerprint": { "$ref": "#/$defs/fingerprint" },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": { "$ref": "#/$defs/operation" }
    },
    "current": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/current" }
      ]
    },
    "result": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/result" }
      ]
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "rawProviderResponsePersisted", "hostCredentialValuesPersisted"],
      "properties": {
        "scope": { "const": "private" },
        "rawProviderResponsePersisted": { "const": false },
        "hostCredentialValuesPersisted": { "const": false }
      }
    },
    "checkpointFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "failure": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "authentication" },
            "code": { "const": "HOST_CALL_AUTHENTICATION_FAILED" },
            "message": { "const": "The exact host operation could not authenticate." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "authorization" },
            "code": { "const": "HOST_CALL_AUTHORIZATION_FAILED" },
            "message": { "const": "The exact host operation was not authorized." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "HOST_CALL_VALIDATION_FAILED" },
            "message": { "const": "The exact host operation failed governed validation." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message", "diagnosticFingerprint"],
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "HOST_CALL_SCHEMA_INVALID" },
            "message": { "const": "The exact host operation data did not satisfy its governed schema." },
            "diagnosticFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "conflict" },
            "code": { "const": "HOST_CALL_CONFLICT" },
            "message": { "const": "The exact host operation encountered a conflict." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "rate-limit" },
            "code": { "const": "HOST_CALL_RATE_LIMITED" },
            "message": { "const": "The exact host operation was rate limited." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "unavailable" },
            "code": { "const": "HOST_CALL_UNAVAILABLE" },
            "message": { "const": "The exact host operation was unavailable." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "retryable" },
            "code": { "const": "HOST_CALL_RETRYABLE_FAILURE" },
            "message": { "const": "The exact host operation reported a retryable failure." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "not-found" },
            "code": { "const": "HOST_CALL_NOT_FOUND" },
            "message": { "const": "The exact host operation did not find its governed subject." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "unknown" },
            "code": { "const": "HOST_CALL_FAILED" },
            "message": { "const": "The exact host operation failed." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "reasonCode", "message"],
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "HOST_REQUEST_NOT_EMITTED" },
            "reasonCode": { "const": "HOST_REQUEST_NOT_EMITTED" },
            "message": { "const": "The exact host request was not emitted." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "reasonCode", "message"],
          "properties": {
            "kind": { "const": "conflict" },
            "code": { "const": "CONNECTED_RECONCILIATION_MISMATCH" },
            "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
            "message": { "const": "Reconciliation did not observe the exact approved state." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "reasonCode", "message"],
          "properties": {
            "kind": { "const": "conflict" },
            "code": { "const": "CONNECTED_PRECONDITION_MISMATCH" },
            "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
            "message": { "const": "The exact compare-before-write precondition was not satisfied." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "reasonCode", "message"],
          "properties": {
            "kind": { "const": "conflict" },
            "code": { "const": "CONNECTED_VERIFICATION_MISMATCH" },
            "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
            "message": { "const": "Read-after-write verification did not observe the exact approved state." }
          }
        }
      ]
    },
    "configurationSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "configurationBasis", "path", "lockPath",
        "lockFingerprint", "graphFingerprint"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "configurationBasis": { "const": "private-active" },
        "path": { "type": "string", "minLength": 1 },
        "lockPath": { "type": "string", "minLength": 1 },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "phase": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["call", "output", "outputFingerprint", "error"],
          "properties": {
            "call": { "type": "object" },
            "output": { "type": ["object", "null"] },
            "outputFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
            "error": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/failure" }
              ]
            }
          }
        }
      ]
    },
    "requiredPhase": {
      "type": "object", "additionalProperties": false,
      "required": ["call", "output", "outputFingerprint", "error"],
      "properties": {
        "call": { "type": "object" },
        "output": { "type": ["object", "null"] },
        "outputFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "error": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/failure" }
          ]
        }
      }
    },
    "ambiguity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stage", "callId", "createdAt", "error", "status", "resolvedAt", "resolution"],
      "properties": {
        "id": { "type": "string", "pattern": "^ambiguity\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "stage": { "enum": ["write", "verify"] },
        "callId": { "type": ["string", "null"], "pattern": "^toolcall\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "createdAt": { "type": "string", "minLength": 20 },
        "error": { "$ref": "#/$defs/failure" },
        "status": { "enum": ["unresolved", "resolved"] },
        "resolvedAt": { "type": ["string", "null"], "minLength": 20 },
        "resolution": { "enum": ["expected-state", "unexpected-state", null] }
      }
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ambiguityId", "createdAt", "phase", "outcome", "observedFingerprint"],
      "properties": {
        "id": { "type": "string", "pattern": "^reconciliation\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "ambiguityId": { "type": "string", "pattern": "^ambiguity\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "createdAt": { "type": "string", "minLength": 20 },
        "phase": { "$ref": "#/$defs/requiredPhase" },
        "outcome": { "enum": ["passed", "failed", "read-failed", null] },
        "observedFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "sequence", "state", "precondition", "write", "verification",
        "ambiguity", "reconciliations", "observedFingerprint", "error"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["pending", "preconditioning", "writing", "verifying", "applied", "failed", "needs-attention", "reconciling"] },
        "precondition": { "$ref": "#/$defs/phase" },
        "write": { "$ref": "#/$defs/phase" },
        "verification": { "$ref": "#/$defs/phase" },
        "ambiguity": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ambiguity" }
          ]
        },
        "reconciliations": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/reconciliation" } },
        "observedFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "error": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/failure" }
          ]
        }
      }
    },
    "current": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "stage", "callId", "reconciliationId"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["precondition", "write", "verify", "reconcile"] },
        "callId": { "type": "string", "pattern": "^toolcall\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "reconciliationId": { "type": ["string", "null"], "pattern": "^reconciliation\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "appliedOperationIds", "error"],
      "properties": {
        "state": { "enum": ["completed", "failed", "needs-attention"] },
        "appliedOperationIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "error": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/failure" }
          ]
        }
      }
    }
  }
}
