{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/connected-change-set/v2",
  "title": "Soter provider-neutral connected change set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "id", "runId", "createdAt",
    "configurationLockFingerprint", "basis", "state", "scopeFingerprint",
    "operations", "approvalId", "transaction", "verification"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/connected-change-set/v2" },
    "contractVersion": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^changeset\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "runId": { "type": "string", "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "configurationLockFingerprint": { "$ref": "#/$defs/fingerprint" },
    "basis": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "proposal", "decision", "automation", "actionIds", "selectionFingerprint"],
      "properties": {
        "kind": { "const": "automation-proposal" },
        "proposal": { "$ref": "#/$defs/reference" },
        "decision": { "$ref": "#/$defs/reference" },
        "automation": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "pattern": "^automation\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
            "version": { "$ref": "#/$defs/version" }
          }
        },
        "actionIds": {
          "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "selectionFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "state": { "enum": ["proposed", "approved", "executing", "committed", "failed"] },
    "scopeFingerprint": { "$ref": "#/$defs/fingerprint" },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "id", "sequence", "sourceActionId", "capability", "authority", "reason",
          "input", "inputFingerprint", "state", "effectId", "outputFingerprint", "error"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^operation\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "sequence": { "type": "integer", "minimum": 1 },
          "sourceActionId": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "authority": { "type": "string", "minLength": 3 },
          "reason": { "type": "string", "minLength": 8 },
          "input": { "type": "object" },
          "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
          "state": { "enum": ["pending", "passed", "failed"] },
          "effectId": { "type": ["string", "null"] },
          "outputFingerprint": { "$ref": "#/$defs/nullableFingerprint" },
          "error": { "type": ["object", "null"] }
        }
      }
    },
    "approvalId": { "type": ["string", "null"] },
    "transaction": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpointFingerprint", "state", "rollbackState", "restoredFingerprint"],
      "properties": {
        "checkpointFingerprint": { "$ref": "#/$defs/fingerprint" },
        "state": { "enum": ["not-started", "committed", "failed"] },
        "rollbackState": { "const": "not-available" },
        "restoredFingerprint": { "type": "null" }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "effectId", "criteria", "observedFingerprint"],
      "properties": {
        "state": { "enum": ["passed", "failed", "unknown"] },
        "effectId": { "type": ["string", "null"] },
        "criteria": { "type": "array", "items": { "type": "string" } },
        "observedFingerprint": { "$ref": "#/$defs/nullableFingerprint" }
      }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
