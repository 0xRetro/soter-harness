{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/configuration-change-plan/v1",
  "title": "Soter private exact configuration change plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "id", "createdAt", "target", "configuration",
    "currentConfiguration", "candidateConfiguration", "currentLock", "candidateLock",
    "priorActiveLock", "changes", "scopeFingerprint", "planFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/configuration-change-plan/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^configuration-change-plan\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "target": { "$ref": "#/$defs/target" },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "templatePath", "desiredStatePath", "activeLockPath", "permissions",
        "templateFingerprint", "currentSourceKind", "currentDocumentFingerprint",
        "currentLockFingerprint", "currentGraphFingerprint", "candidateDocumentFingerprint",
        "candidateLockFingerprint", "candidateGraphFingerprint", "projectionFingerprint"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "templatePath": { "type": "string", "pattern": "^soter/configurations/[a-z0-9]+(?:-[a-z0-9]+)*\\.config\\.json$" },
        "desiredStatePath": { "type": "string", "pattern": "^\\.soter/state/configurations/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$" },
        "activeLockPath": { "type": "string", "pattern": "^\\.soter/state/configuration-locks/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$" },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["privateDirectories", "desiredConfiguration", "activeLock", "authorityFiles"],
          "properties": {
            "privateDirectories": { "const": "0700" },
            "desiredConfiguration": { "const": "0600" },
            "activeLock": { "const": "0600" },
            "authorityFiles": { "const": "0600" }
          }
        },
        "templateFingerprint": { "$ref": "#/$defs/fingerprint" },
        "currentSourceKind": { "enum": ["tracked-template", "private-active"] },
        "currentDocumentFingerprint": { "$ref": "#/$defs/fingerprint" },
        "currentLockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "currentGraphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidateDocumentFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidateLockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidateGraphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "projectionFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "currentConfiguration": { "type": "object" },
    "candidateConfiguration": { "type": "object" },
    "currentLock": { "type": "object" },
    "candidateLock": { "type": "object" },
    "priorActiveLock": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "fingerprint", "lock"],
          "properties": {
            "state": { "const": "absent" },
            "fingerprint": { "const": null },
            "lock": { "const": null }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "fingerprint", "lock"],
          "properties": {
            "state": { "const": "present" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "lock": { "type": "object" }
          }
        }
      ]
    },
    "changes": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/change" }
    },
    "scopeFingerprint": { "$ref": "#/$defs/fingerprint" },
    "planFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedPath", "realPath", "device", "inode", "fingerprint"],
      "properties": {
        "requestedPath": { "type": "string", "minLength": 1 },
        "realPath": { "type": "string", "minLength": 1 },
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 0 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "subject", "state", "beforeDescriptor", "afterDescriptor", "beforeFingerprint", "afterFingerprint"],
      "properties": {
        "id": { "type": "string", "pattern": "^configuration-change\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "category": { "enum": ["host", "pack", "binding", "source", "authority", "effect-policy", "secret-reference", "setting", "resolution", "lock"] },
        "subject": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "state": { "enum": ["added", "removed", "changed"] },
        "beforeDescriptor": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "afterDescriptor": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "beforeFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "afterFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "allOf": [{
        "if": {
          "properties": { "category": { "const": "lock" } },
          "required": ["category"]
        },
        "then": {
          "properties": {
            "id": { "const": "configuration-change.lock.active" },
            "subject": { "const": "active-lock" },
            "afterDescriptor": { "const": "candidate-active-lock" },
            "afterFingerprint": { "$ref": "#/$defs/fingerprint" }
          },
          "oneOf": [
            {
              "properties": {
                "state": { "const": "added" },
                "beforeDescriptor": { "const": null },
                "beforeFingerprint": { "const": null }
              }
            },
            {
              "properties": {
                "state": { "const": "changed" },
                "beforeDescriptor": { "const": "prior-active-lock" },
                "beforeFingerprint": { "$ref": "#/$defs/fingerprint" }
              }
            }
          ]
        }
      }]
    }
  }
}
