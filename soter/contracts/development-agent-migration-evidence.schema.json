{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/development-agent-migration-evidence/v1",
  "title": "Soter sanitized historical candidate agent migration evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "evidenceFingerprint",
    "createdAt",
    "sourceObservation",
    "applicability",
    "request",
    "result",
    "workflow",
    "evaluatedSubject",
    "evaluationSet",
    "host",
    "workspace",
    "environment",
    "runs",
    "artifacts",
    "externalEffects",
    "conclusion",
    "authority",
    "privacy",
    "limitations"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/development-agent-migration-evidence/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^development-agent-migration-evidence[.](?:codex|claude)[.][a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "evidenceFingerprint": { "$ref": "#/$defs/fingerprint" },
    "createdAt": { "$ref": "#/$defs/instant" },
    "sourceObservation": { "$ref": "#/$defs/sourceObservation" },
    "applicability": { "$ref": "#/$defs/applicability" },
    "request": { "$ref": "#/$defs/requestBinding" },
    "result": { "$ref": "#/$defs/resultBinding" },
    "workflow": { "$ref": "#/$defs/workflowBinding" },
    "evaluatedSubject": { "$ref": "#/$defs/evaluatedSubject" },
    "evaluationSet": { "$ref": "#/$defs/evaluationSetBinding" },
    "host": { "$ref": "#/$defs/hostBinding" },
    "workspace": { "$ref": "#/$defs/workspaceTransition" },
    "environment": { "$ref": "#/$defs/environment" },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/runObservation" }
    },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "externalEffects": { "$ref": "#/$defs/externalEffects" },
    "conclusion": { "$ref": "#/$defs/conclusion" },
    "authority": { "$ref": "#/$defs/authority" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DEVELOPMENT_AGENT_MIGRATION_EVIDENCE_HISTORICAL_CANDIDATE_ONLY",
          "DEVELOPMENT_AGENT_MIGRATION_EVIDENCE_LOCAL_BINARY_IDENTITY_ONLY",
          "DEVELOPMENT_AGENT_MIGRATION_EVIDENCE_NO_AUTHORITY",
          "DEVELOPMENT_AGENT_MIGRATION_EVIDENCE_NO_CURRENT_RUNTIME_APPLICABILITY"
        ]
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)$"
    },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]{3})?Z$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "sourceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "observedAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^development-host-observation[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "observedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "candidateBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationName",
        "lockFingerprint",
        "graphFingerprint",
        "candidateProjectionFingerprint"
      ],
      "properties": {
        "configurationName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidateProjectionFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evaluatedSubjectFingerprint",
        "candidate",
        "finalGraph",
        "finalProjection",
        "currentRuntime",
        "activation",
        "fallbackRemoval"
      ],
      "properties": {
        "kind": { "const": "historical-candidate-only" },
        "evaluatedSubjectFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidate": { "$ref": "#/$defs/candidateBasis" },
        "finalGraph": { "const": "not-claimed" },
        "finalProjection": { "const": "not-claimed" },
        "currentRuntime": { "const": "not-claimed" },
        "activation": { "const": "not-granted" },
        "fallbackRemoval": { "const": "not-granted" }
      }
    },
    "requestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^development-request[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "createdAt": { "$ref": "#/$defs/instant" }
      }
    },
    "resultBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "createdAt", "completedAt", "state"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^development-result[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "createdAt": { "$ref": "#/$defs/instant" },
        "completedAt": { "$ref": "#/$defs/instant" },
        "state": { "const": "passed" }
      }
    },
    "workflowBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "definitionFingerprint"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^automation[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": { "$ref": "#/$defs/version" },
        "definitionFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "evaluatedSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "fingerprint",
        "contentFingerprint",
        "candidateProjectionFingerprint"
      ],
      "properties": {
        "kind": { "const": "workflow-guide" },
        "id": {
          "type": "string",
          "pattern": "^workflow-guide[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": { "$ref": "#/$defs/version" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "contentFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidateProjectionFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "evaluationSetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "fingerprint"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evaluation-set[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": { "$ref": "#/$defs/version" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "hostBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapter",
        "version",
        "adapterFingerprint",
        "projectionDefinitionId",
        "projectionDefinitionFingerprint",
        "evaluatedInstructionFingerprint",
        "candidateProjectionFingerprint",
        "observer"
      ],
      "properties": {
        "id": { "enum": ["codex", "claude"] },
        "adapter": { "enum": ["host.codex", "host.claude"] },
        "version": { "$ref": "#/$defs/version" },
        "adapterFingerprint": { "$ref": "#/$defs/fingerprint" },
        "projectionDefinitionId": {
          "enum": ["host-projection.codex", "host-projection.claude"]
        },
        "projectionDefinitionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "evaluatedInstructionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidateProjectionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "observer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "implementationFingerprint", "transport"],
          "properties": {
            "id": {
              "enum": ["development-host-observer.codex", "development-host-observer.claude"]
            },
            "version": { "$ref": "#/$defs/version" },
            "implementationFingerprint": { "$ref": "#/$defs/fingerprint" },
            "transport": { "const": "trusted-local-host-adapter" }
          }
        }
      }
    },
    "workspaceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootIdentityFingerprint",
        "revisionFingerprint",
        "treeFingerprint",
        "exactInputState",
        "policyFingerprint",
        "settingsFingerprint"
      ],
      "properties": {
        "rootIdentityFingerprint": { "$ref": "#/$defs/fingerprint" },
        "revisionFingerprint": { "$ref": "#/$defs/nullableFingerprint" },
        "treeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "exactInputState": { "enum": ["clean", "dirty", "unknown"] },
        "policyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "settingsFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "workspaceTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre", "post"],
      "properties": {
        "pre": { "$ref": "#/$defs/workspaceBasis" },
        "post": { "$ref": "#/$defs/workspaceBasis" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containment", "runtimeFingerprint"],
      "properties": {
        "containment": { "enum": ["offline", "fixture", "isolated-host-process"] },
        "runtimeFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "criterionObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "sequence", "state", "evidenceFingerprint"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*[.](?:expected|prohibited)[.][1-9][0-9]*$"
            },
            "kind": { "const": "expected" },
            "sequence": { "type": "integer", "minimum": 1, "maximum": 500 },
            "state": { "enum": ["observed", "not-observed", "unknown"] },
            "evidenceFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "sequence", "state", "evidenceFingerprint"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*[.](?:expected|prohibited)[.][1-9][0-9]*$"
            },
            "kind": { "const": "prohibited" },
            "sequence": { "type": "integer", "minimum": 1, "maximum": 500 },
            "state": { "enum": ["observed", "not-observed", "unknown"] },
            "evidenceFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        }
      ]
    },
    "guidedCriterionObservation": {
      "allOf": [
        { "$ref": "#/$defs/criterionObservation" },
        {
          "if": {
            "properties": { "kind": { "const": "expected" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "state": { "const": "observed" } }
          },
          "else": {
            "properties": { "state": { "const": "not-observed" } }
          }
        }
      ]
    },
    "runObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "caseId",
        "caseFingerprint",
        "stimulusFingerprint",
        "arm",
        "guideState",
        "startedAt",
        "completedAt",
        "worker",
        "judgment"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "arm": { "const": "baseline" } },
            "required": ["arm"]
          },
          "then": {
            "properties": {
              "guideState": { "const": "withheld" }
            }
          },
          "else": {
            "properties": {
              "arm": { "const": "guided" },
              "guideState": { "const": "candidate" },
              "worker": {
                "properties": {
                  "state": { "const": "passed" }
                }
              },
              "judgment": {
                "properties": {
                  "verdict": { "const": "passed" },
                  "criteria": {
                    "items": { "$ref": "#/$defs/guidedCriterionObservation" }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evaluation-run[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 500 },
        "caseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "caseFingerprint": { "$ref": "#/$defs/fingerprint" },
        "stimulusFingerprint": { "$ref": "#/$defs/fingerprint" },
        "arm": { "enum": ["baseline", "guided"] },
        "guideState": { "enum": ["withheld", "candidate"] },
        "startedAt": { "$ref": "#/$defs/instant" },
        "completedAt": { "$ref": "#/$defs/instant" },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "workerFingerprint",
            "dispatchFingerprint",
            "transcriptFingerprint",
            "expectationsIncluded",
            "answerKeyAccess",
            "state"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^worker-run[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
            },
            "workerFingerprint": { "$ref": "#/$defs/fingerprint" },
            "dispatchFingerprint": { "$ref": "#/$defs/fingerprint" },
            "transcriptFingerprint": { "$ref": "#/$defs/fingerprint" },
            "expectationsIncluded": { "const": false },
            "answerKeyAccess": { "const": "not-observed" },
            "state": { "enum": ["passed", "failed"] }
          }
        },
        "judgment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "verdict", "criteria"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^judgment[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
            },
            "verdict": { "enum": ["passed", "failed", "blocked"] },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": { "$ref": "#/$defs/criterionObservation" }
            }
          }
        }
      }
    },
    "migrationSourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "subjectId", "path", "fingerprint"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^artifact[.]migration-source[.](?:[1-9]|[1-9][0-9]|[1-4][0-9]{2}|500)$"
        },
        "role": { "const": "migration-source" },
        "subjectId": {
          "type": "string",
          "pattern": "^automation[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "path": { "$ref": "#/$defs/relativePath" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "migrationTargetArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "subjectId", "path", "fingerprint"],
      "properties": {
        "id": { "const": "artifact.migration-target" },
        "role": { "const": "migration-target" },
        "subjectId": {
          "type": "string",
          "pattern": "^workflow-guide[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "path": { "$ref": "#/$defs/relativePath" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "developmentRequestArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "subjectId", "fingerprint"],
      "properties": {
        "id": { "const": "artifact.development-request" },
        "role": { "const": "development-request" },
        "subjectId": {
          "type": "string",
          "pattern": "^development-request[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "developmentResultArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "subjectId", "fingerprint"],
      "properties": {
        "id": { "const": "artifact.development-result" },
        "role": { "const": "development-result" },
        "subjectId": {
          "type": "string",
          "pattern": "^development-result[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "hostObservationArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "subjectId", "fingerprint"],
      "properties": {
        "id": { "const": "artifact.host-observation" },
        "role": { "const": "host-observation" },
        "subjectId": {
          "type": "string",
          "pattern": "^development-host-observation[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "evaluationSetArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "subjectId", "fingerprint"],
      "properties": {
        "id": { "const": "artifact.evaluation-set" },
        "role": { "const": "evaluation-set" },
        "subjectId": {
          "type": "string",
          "pattern": "^evaluation-set[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "candidateProjectionArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "subjectId", "fingerprint"],
      "properties": {
        "id": { "const": "artifact.candidate-projection" },
        "role": { "const": "candidate-projection" },
        "subjectId": {
          "type": "string",
          "pattern": "^workflow-guide[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 506,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/migrationSourceArtifact" },
          { "$ref": "#/$defs/migrationTargetArtifact" },
          { "$ref": "#/$defs/developmentRequestArtifact" },
          { "$ref": "#/$defs/developmentResultArtifact" },
          { "$ref": "#/$defs/hostObservationArtifact" },
          { "$ref": "#/$defs/evaluationSetArtifact" },
          { "$ref": "#/$defs/candidateProjectionArtifact" }
        ]
      }
    },
    "effectObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "count", "observedFingerprint"],
      "properties": {
        "state": { "const": "not-observed" },
        "count": { "const": 0 },
        "observedFingerprint": { "type": "null" }
      }
    },
    "externalEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerRead",
        "providerWrite",
        "publication",
        "merge",
        "protectedRootMutation",
        "hostRealization"
      ],
      "properties": {
        "providerRead": { "$ref": "#/$defs/effectObservation" },
        "providerWrite": { "$ref": "#/$defs/effectObservation" },
        "publication": { "$ref": "#/$defs/effectObservation" },
        "merge": { "$ref": "#/$defs/effectObservation" },
        "protectedRootMutation": { "$ref": "#/$defs/effectObservation" },
        "hostRealization": { "$ref": "#/$defs/effectObservation" }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "behaviorParity",
        "baselineRole",
        "guidedRunsPassed",
        "prohibitedOutcomesObserved",
        "externalEffectsObserved"
      ],
      "properties": {
        "state": { "const": "passed" },
        "behaviorParity": { "const": "passed" },
        "baselineRole": { "const": "observed-non-gating" },
        "guidedRunsPassed": { "const": true },
        "prohibitedOutcomesObserved": { "type": "boolean" },
        "externalEffectsObserved": { "const": false }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "grantsExecution",
        "grantsApproval",
        "grantsActivation",
        "grantsMigration",
        "grantsPublication",
        "grantsMerge",
        "grantsProviderRead",
        "grantsProviderWrite",
        "grantsHostRealization",
        "grantsPromotion",
        "grantsFallbackRemoval"
      ],
      "properties": {
        "kind": { "const": "migration-evidence-only" },
        "grantsExecution": { "const": false },
        "grantsApproval": { "const": false },
        "grantsActivation": { "const": false },
        "grantsMigration": { "const": false },
        "grantsPublication": { "const": false },
        "grantsMerge": { "const": false },
        "grantsProviderRead": { "const": false },
        "grantsProviderWrite": { "const": false },
        "grantsHostRealization": { "const": false },
        "grantsPromotion": { "const": false },
        "grantsFallbackRemoval": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "absolutePathsIncluded",
        "targetPathsIncluded",
        "requestedOutcomeIncluded",
        "rawDiffsIncluded",
        "rawContentIncluded",
        "rawTranscriptsIncluded",
        "providerResponsesIncluded",
        "credentialsIncluded"
      ],
      "properties": {
        "scope": { "const": "shareable-sanitized" },
        "absolutePathsIncluded": { "const": false },
        "targetPathsIncluded": { "const": false },
        "requestedOutcomeIncluded": { "const": false },
        "rawDiffsIncluded": { "const": false },
        "rawContentIncluded": { "const": false },
        "rawTranscriptsIncluded": { "const": false },
        "providerResponsesIncluded": { "const": false },
        "credentialsIncluded": { "const": false }
      }
    }
  }
}
