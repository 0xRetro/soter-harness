{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/host-realization-consumption/v1",
  "title": "Soter one-time host realization confirmation consumption",
  "type": "object", "additionalProperties": false,
  "required": ["$contract", "contractVersion", "id", "createdAt", "updatedAt", "state", "confirmation", "request", "plan", "checkpointId", "reservationFingerprint", "checkpointFingerprint", "consumptionFingerprint"],
  "properties": {
    "$contract": { "const": "soter://contracts/host-realization-consumption/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^host-realization-consumption[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "updatedAt": { "type": "string", "minLength": 20 },
    "state": { "enum": ["reserved", "started"] },
    "confirmation": { "$ref": "#/$defs/reference" },
    "request": { "$ref": "#/$defs/reference" },
    "plan": { "$ref": "#/$defs/reference" },
    "checkpointId": { "type": "string", "pattern": "^checkpoint[.]host-realization[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "reservationFingerprint": { "$ref": "#/$defs/fingerprint" },
    "checkpointFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "consumptionFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fingerprint"],
      "properties": { "id": { "type": "string" }, "fingerprint": { "$ref": "#/$defs/fingerprint" } }
    }
  }
}
