{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/prepared-work-review-material/v1",
  "title": "Soter private prepared-work review material",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "fingerprint", "createdAt", "workId",
    "preparedWorkFingerprint", "checkpointId", "checkpointFingerprint",
    "automation", "configuration", "inputContractFingerprint",
    "applicability", "fields", "privacy"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/prepared-work-review-material/v1" },
    "contractVersion": { "const": "1.0.0" },
    "fingerprint": { "$ref": "#/$defs/fingerprint" },
    "createdAt": { "type": "string", "minLength": 1 },
    "workId": { "type": "string", "pattern": "^work\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "preparedWorkFingerprint": { "$ref": "#/$defs/fingerprint" },
    "checkpointId": { "type": "string", "minLength": 1 },
    "checkpointFingerprint": { "$ref": "#/$defs/fingerprint" },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^automation\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lockFingerprint"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "inputContractFingerprint": { "$ref": "#/$defs/fingerprint" },
    "applicability": { "enum": ["current", "stale"] },
    "fields": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/omittedField" },
          { "$ref": "#/$defs/providedField" }
        ]
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "authority", "projection"],
      "properties": {
        "scope": { "const": "private-local-review" },
        "authority": { "const": "none" },
        "projection": { "const": "selected-work-only" }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "omittedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "exposure", "state", "fingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "exposure": { "enum": ["identifier", "private"] },
        "state": { "const": "omitted" },
        "fingerprint": { "type": "null" }
      }
    },
    "providedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "exposure", "state", "fingerprint", "reviewValue"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "exposure": { "enum": ["identifier", "private"] },
        "state": { "const": "provided" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "reviewValue": { "type": ["string", "boolean"] }
      }
    }
  }
}
