{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contexts/process/process-capture-policy/v1",
  "title": "Soter process-capture policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "name",
    "createRequiresConfirmation",
    "defaultStatus",
    "statusLifecycle",
    "processOsLifecycle",
    "duplicateCandidateLimit",
    "maximumSteps",
    "maximumWorkItemsPerStep",
    "requiredSections",
    "triggerKinds",
    "frequencyAliases",
    "categoryAliases",
    "taskSpawnMode",
    "bodyShapeVersion"
  ],
  "properties": {
    "$contract": { "const": "soter://contexts/process/process-capture-policy/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^policy[.]context[.]process[.]capture(?:[.-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createRequiresConfirmation": { "const": true },
    "defaultStatus": { "type": "string", "minLength": 1, "maxLength": 100 },
    "statusLifecycle": { "type": "array", "minItems": 2, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
    "processOsLifecycle": { "type": "array", "minItems": 2, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
    "duplicateCandidateLimit": { "type": "integer", "minimum": 1, "maximum": 25 },
    "maximumSteps": { "type": "integer", "minimum": 1, "maximum": 50 },
    "maximumWorkItemsPerStep": { "const": 1 },
    "requiredSections": {
      "const": ["Purpose", "Trigger", "Cadence", "Roles", "Initialization", "Steps", "Exception Handling", "Post Run Summary Report"]
    },
    "triggerKinds": { "const": ["Request", "Event", "Schedule", "Emergency"] },
    "frequencyAliases": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/alias" } },
    "categoryAliases": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/alias" } },
    "taskSpawnMode": { "const": "definition-prohibited-run-handoff-only" },
    "bodyShapeVersion": { "const": "1.0.0" }
  },
  "$defs": {
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "value"],
      "properties": {
        "input": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  }
}
