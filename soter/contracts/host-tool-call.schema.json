{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/host-tool-call/v1",
  "title": "Soter host-dispatched tool call",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "runId",
    "createdAt",
    "completedAt",
    "state",
    "configurationLockFingerprint",
    "graphFingerprint",
    "host",
    "provider",
    "capability",
    "authority",
    "declaredEffects",
    "policyDecisions",
    "inputFingerprint",
    "transport",
    "arguments",
    "argumentsFingerprint",
    "responseFingerprint",
    "outputFingerprint",
    "error",
    "secretValuesExcluded"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/host-tool-call/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^toolcall\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "createdAt": { "type": "string", "minLength": 20 },
    "completedAt": { "type": ["string", "null"], "minLength": 20 },
    "state": { "enum": ["requested", "completed", "failed", "blocked"] },
    "configuration": { "$ref": "#/$defs/configurationSelection" },
    "configurationLockFingerprint": { "$ref": "#/$defs/fingerprint" },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "implementation", "version", "containment"],
      "properties": {
        "pack": { "type": "string", "minLength": 3 },
        "implementation": {
          "type": "string",
          "pattern": "^provider\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": { "$ref": "#/$defs/version" },
        "containment": { "enum": ["connected", "canary", "live"] }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "authority": { "type": "string", "minLength": 3 },
    "declaredEffects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/effect" }
    },
    "policyDecisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect", "mode", "decision", "reason"],
        "properties": {
          "effect": { "$ref": "#/$defs/effect" },
          "mode": { "enum": ["allow", "confirm", "prohibit"] },
          "decision": { "enum": ["allowed", "confirmed", "blocked"] },
          "reason": { "type": "string", "minLength": 3 }
        }
      }
    },
    "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
    "transport": { "$ref": "#/$defs/transport" },
    "arguments": { "type": ["object", "null"] },
    "argumentsFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "responseFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "outputFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "pagination": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseCallId",
            "maximumPages",
            "currentPage",
            "pages",
            "currentRequestFingerprint",
            "cursorValuesExcluded",
            "rawProviderResponsesExcluded"
          ],
          "properties": {
            "baseCallId": {
              "type": "string",
              "pattern": "^toolcall\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            },
            "maximumPages": { "type": "integer", "minimum": 2, "maximum": 101 },
            "currentPage": { "type": "integer", "minimum": 1, "maximum": 101 },
            "pages": {
              "type": "array",
              "maxItems": 101,
              "items": { "$ref": "#/$defs/pageReceipt" }
            },
            "currentRequestFingerprint": { "$ref": "#/$defs/fingerprint" },
            "failedRequestFingerprint": { "$ref": "#/$defs/fingerprint" },
            "cursorValuesExcluded": { "const": true },
            "rawProviderResponsesExcluded": { "const": true }
          }
        }
      ]
    },
    "secretValuesExcluded": { "const": true }
  },
  "$defs": {
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "server", "operation", "tool", "responseProfile"],
      "properties": {
        "protocol": { "const": "mcp" },
        "server": { "type": "string", "minLength": 1 },
        "operation": { "type": ["string", "null"], "minLength": 1 },
        "tool": { "type": ["string", "null"], "minLength": 1 },
        "responseProfile": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "configurationSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "configurationBasis",
        "path",
        "lockPath",
        "lockFingerprint",
        "graphFingerprint"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "configurationBasis": {
          "enum": ["tracked-contained", "private-active"]
        },
        "path": { "type": "string", "minLength": 1 },
        "lockPath": { "type": "string", "minLength": 1 },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "failure": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "authentication" },
            "code": { "const": "HOST_CALL_AUTHENTICATION_FAILED" },
            "message": { "const": "The exact host operation could not authenticate." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "authorization" },
            "code": { "const": "HOST_CALL_AUTHORIZATION_FAILED" },
            "message": { "const": "The exact host operation was not authorized." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "HOST_CALL_VALIDATION_FAILED" },
            "message": { "const": "The exact host operation failed governed validation." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message", "diagnosticFingerprint"],
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "HOST_CALL_SCHEMA_INVALID" },
            "message": { "const": "The exact host operation data did not satisfy its governed schema." },
            "diagnosticFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "conflict" },
            "code": { "const": "HOST_CALL_CONFLICT" },
            "message": { "const": "The exact host operation encountered a conflict." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "rate-limit" },
            "code": { "const": "HOST_CALL_RATE_LIMITED" },
            "message": { "const": "The exact host operation was rate limited." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "unavailable" },
            "code": { "const": "HOST_CALL_UNAVAILABLE" },
            "message": { "const": "The exact host operation was unavailable." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "retryable" },
            "code": { "const": "HOST_CALL_RETRYABLE_FAILURE" },
            "message": { "const": "The exact host operation reported a retryable failure." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "not-found" },
            "code": { "const": "HOST_CALL_NOT_FOUND" },
            "message": { "const": "The exact host operation did not find its governed subject." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "unknown" },
            "code": { "const": "HOST_CALL_FAILED" },
            "message": { "const": "The exact host operation failed." }
          }
        }
      ]
    },
    "effect": {
      "enum": ["read", "disclosure", "write", "dispatch", "destructive"]
    },
    "pageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "callId",
        "transport",
        "argumentsFingerprint",
        "responseFingerprint",
        "inputCursorFingerprint",
        "continuationState",
        "nextCursorFingerprint",
        "page",
        "pageFingerprint",
        "requestFingerprint"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 101 },
        "callId": {
          "type": "string",
          "pattern": "^toolcall\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "transport": { "$ref": "#/$defs/transport" },
        "argumentsFingerprint": { "$ref": "#/$defs/fingerprint" },
        "responseFingerprint": { "$ref": "#/$defs/fingerprint" },
        "inputCursorFingerprint": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "continuationState": { "enum": ["more", "exhausted"] },
        "nextCursorFingerprint": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observedCount",
            "includedCount",
            "excludedCount",
            "observedIdentityFingerprints",
            "data"
          ],
          "properties": {
            "observedCount": { "type": "integer", "minimum": 0 },
            "includedCount": { "type": "integer", "minimum": 0 },
            "excludedCount": { "type": "integer", "minimum": 0 },
            "observedIdentityFingerprints": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/fingerprint" }
            },
            "data": { "type": "object" }
          }
        },
        "pageFingerprint": { "$ref": "#/$defs/fingerprint" },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
