{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contexts/tasks/task-work-policy/v1",
  "title": "Soter Tasks Context task-work policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "name",
    "createRequiresConfirmation",
    "duplicateCandidateLimit",
    "duplicateKeyFields",
    "defaultStatus",
    "allowedContexts",
    "projectRequired",
    "assigneePolicy"
  ],
  "properties": {
    "$contract": { "const": "soter://contexts/tasks/task-work-policy/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^policy\\.context\\.tasks\\.task-work(?:[.-][a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createRequiresConfirmation": { "const": true },
    "duplicateCandidateLimit": { "type": "integer", "minimum": 1, "maximum": 25 },
    "duplicateKeyFields": {
      "type": "array",
      "items": { "const": "title" },
      "minItems": 1,
      "maxItems": 1
    },
    "defaultStatus": { "type": "string", "minLength": 1, "maxLength": 100 },
    "allowedContexts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "enum": ["Internal", "Service", "Project", "Client"] }
    },
    "projectRequired": { "const": true },
    "assigneePolicy": { "const": "current-user-or-unassigned" }
  }
}
