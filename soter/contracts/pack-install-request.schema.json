{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/pack-install-request/v1",
  "title": "Soter expiring exact local pack install request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "id", "createdAt", "expiresAt",
    "plan", "scopeFingerprint", "reason", "requestFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/pack-install-request/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^pack-install-request[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "expiresAt": { "type": "string", "minLength": 20 },
    "plan": { "$ref": "#/$defs/reference" },
    "scopeFingerprint": { "$ref": "#/$defs/fingerprint" },
    "reason": { "type": "string", "minLength": 12 },
    "requestFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint"],
      "properties": {
        "id": { "type": "string" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
