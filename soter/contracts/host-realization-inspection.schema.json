{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/host-realization-inspection/v1",
  "title": "Soter sanitized host realization inspection",
  "type": "object", "additionalProperties": false,
  "required": ["$contract", "contractVersion", "plan", "target", "host", "configuration", "scope", "request", "confirmation", "consumption", "checkpoint", "resume", "claims", "inspectionFingerprint"],
  "properties": {
    "$contract": { "const": "soter://contracts/host-realization-inspection/v1" },
    "contractVersion": { "const": "1.0.0" },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fingerprint", "createdAt", "validUntil", "applicability"],
      "properties": {
        "id": { "type": "string" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "createdAt": { "type": "string" },
        "validUntil": { "type": "string" },
        "applicability": { "enum": ["current", "stale", "expired", "applied"] }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint"],
      "properties": { "fingerprint": { "$ref": "#/$defs/fingerprint" } }
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "adapter", "definition", "generator"],
      "properties": {
        "id": { "type": "string" },
        "adapter": { "type": "string" },
        "definition": { "$ref": "#/$defs/versionedReference" },
        "generator": { "$ref": "#/$defs/versionedReference" }
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "lockFingerprint", "graphFingerprint"],
      "properties": {
        "name": { "type": "string" },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint", "outputs"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "sequence", "path", "role", "action", "mode", "beforeFingerprint", "afterFingerprint"],
            "properties": {
              "id": { "type": "string" },
              "sequence": { "type": "integer", "minimum": 0 },
              "path": { "type": "string" },
              "role": { "enum": ["instructions", "skills", "tools", "lifecycle", "configuration"] },
              "action": { "enum": ["create", "replace", "remove"] },
              "mode": { "type": ["string", "null"] },
              "beforeFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
              "afterFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "request": { "$ref": "#/$defs/requestRecord" },
    "confirmation": { "$ref": "#/$defs/confirmationRecord" },
    "consumption": { "$ref": "#/$defs/consumptionRecord" },
    "checkpoint": {
      "oneOf": [
        { "const": null },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "fingerprint", "state", "phase", "currentOutputId", "outputs", "failure"],
          "properties": {
            "id": { "type": "string" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "state": { "enum": ["prepared", "applying", "verifying", "completed", "rolling-back", "rolled-back", "needs-attention"] },
            "phase": { "enum": ["prepared", "directories", "outputs", "manifest", "verifying", "rollback", "terminal"] },
            "currentOutputId": { "type": ["string", "null"] },
            "outputs": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "sequence", "state"],
                "properties": {
                  "id": { "type": "string" },
                  "sequence": { "type": "integer" },
                  "state": { "enum": ["pending", "applied", "verified", "rolled-back"] }
                }
              }
            },
            "failure": {
              "oneOf": [
                { "const": null },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["reasonCode", "summary"],
                  "properties": {
                    "reasonCode": { "type": "string", "pattern": "^HOST_REALIZATION_[A-Z0-9_]+$" },
                    "summary": { "type": "string" }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "resume": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "reasonCode", "reason", "permittedNextAction"],
      "properties": {
        "classification": { "enum": ["safe", "requires-review", "unavailable"] },
        "reasonCode": { "type": "string", "pattern": "^HOST_REALIZATION_[A-Z0-9_]+$" },
        "reason": { "type": "string", "minLength": 8 },
        "permittedNextAction": { "enum": ["request-confirmation", "confirm", "start", "execute-checkpoint", "recover-checkpoint", "inspect-checkpoint", "replan", "none"] }
      },
      "oneOf": [
        { "properties": { "classification": { "const": "unavailable" }, "reasonCode": { "const": "HOST_REALIZATION_COMPLETED" }, "reason": { "const": "The exact deterministic local projection is complete." }, "permittedNextAction": { "const": "none" } } },
        { "properties": { "classification": { "const": "unavailable" }, "reasonCode": { "const": "HOST_REALIZATION_ROLLED_BACK" }, "reason": { "const": "The exact host realization checkpoint was rolled back and is terminal." }, "permittedNextAction": { "const": "none" } } },
        { "properties": { "classification": { "const": "requires-review" }, "reasonCode": { "pattern": "^HOST_REALIZATION_[A-Z0-9_]+$" }, "reason": { "const": "Checkpoint state requires exact local inspection before any further action." }, "permittedNextAction": { "const": "inspect-checkpoint" } } },
        { "properties": { "classification": { "const": "safe" }, "reasonCode": { "const": "HOST_REALIZATION_CHECKPOINT_READY" }, "reason": { "const": "The one-time start is bound to an exact prepared checkpoint." }, "permittedNextAction": { "const": "execute-checkpoint" } } },
        { "properties": { "classification": { "const": "requires-review" }, "reasonCode": { "const": "HOST_REALIZATION_CHECKPOINT_REVIEW_REQUIRED" }, "reason": { "const": "The prepared checkpoint must be inspected because its plan is no longer current." }, "permittedNextAction": { "const": "inspect-checkpoint" } } },
        { "properties": { "classification": { "const": "safe" }, "reasonCode": { "const": "HOST_REALIZATION_CHECKPOINT_RECOVERABLE" }, "reason": { "const": "The exact checkpoint may continue through Core recovery." }, "permittedNextAction": { "const": "recover-checkpoint" } } },
        { "properties": { "classification": { "const": "requires-review" }, "reasonCode": { "const": "HOST_REALIZATION_CHECKPOINT_REVIEW_REQUIRED" }, "reason": { "const": "The exact checkpoint must be inspected because its plan is no longer current." }, "permittedNextAction": { "const": "inspect-checkpoint" } } },
        { "properties": { "classification": { "const": "requires-review" }, "reasonCode": { "const": "HOST_REALIZATION_CONSUMPTION_INCOMPLETE" }, "reason": { "const": "The one-time start was reserved without its exact durable checkpoint." }, "permittedNextAction": { "const": "inspect-checkpoint" } } },
        { "properties": { "classification": { "const": "unavailable" }, "reasonCode": { "const": "HOST_REALIZATION_PLAN_EXPIRED" }, "reason": { "const": "The private host realization plan is no longer current." }, "permittedNextAction": { "const": "replan" } } },
        { "properties": { "classification": { "const": "unavailable" }, "reasonCode": { "const": "HOST_REALIZATION_PLAN_STALE" }, "reason": { "const": "The private host realization plan is no longer current." }, "permittedNextAction": { "const": "replan" } } },
        { "properties": { "classification": { "const": "unavailable" }, "reasonCode": { "const": "HOST_REALIZATION_CONFIRMATION_EXPIRED" }, "reason": { "const": "The exact confirmation can no longer start work because its request expired." }, "permittedNextAction": { "const": "request-confirmation" } } },
        { "properties": { "classification": { "const": "safe" }, "reasonCode": { "const": "HOST_REALIZATION_CONFIRMATION_CURRENT" }, "reason": { "const": "The exact confirmation may be consumed once before its request expires." }, "permittedNextAction": { "const": "start" } } },
        { "properties": { "classification": { "const": "unavailable" }, "reasonCode": { "const": "HOST_REALIZATION_REQUEST_EXPIRED" }, "reason": { "const": "The exact confirmation request expired." }, "permittedNextAction": { "const": "request-confirmation" } } },
        { "properties": { "classification": { "const": "safe" }, "reasonCode": { "const": "HOST_REALIZATION_CONFIRMATION_PENDING" }, "reason": { "const": "The exact expiring request is awaiting local operator confirmation." }, "permittedNextAction": { "const": "confirm" } } },
        { "properties": { "classification": { "const": "safe" }, "reasonCode": { "const": "HOST_REALIZATION_PLAN_CURRENT" }, "reason": { "const": "The exact private plan is current and may request confirmation." }, "permittedNextAction": { "const": "request-confirmation" } } }
      ]
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["localProjection", "hostLaunch", "toolDiscovery", "authentication", "providerReachability", "connectedBehavior", "health"],
      "properties": {
        "localProjection": { "enum": ["unknown", "passed"] },
        "hostLaunch": { "const": "unknown" },
        "toolDiscovery": { "const": "unknown" },
        "authentication": { "const": "unknown" },
        "providerReachability": { "const": "unknown" },
        "connectedBehavior": { "const": "unknown" },
        "health": { "const": "unknown" }
      }
    },
    "inspectionFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "allOf": [
    {
      "if": { "properties": { "confirmation": { "type": "object" } }, "required": ["confirmation"] },
      "then": { "properties": { "request": { "type": "object" } } }
    },
    {
      "if": { "properties": { "consumption": { "type": "object" } }, "required": ["consumption"] },
      "then": { "properties": { "request": { "type": "object" }, "confirmation": { "type": "object" } } }
    },
    {
      "if": { "properties": { "checkpoint": { "type": "object" } }, "required": ["checkpoint"] },
      "then": { "properties": { "request": { "type": "object" }, "confirmation": { "type": "object" }, "consumption": { "type": "object", "properties": { "state": { "const": "started" } } } } }
    },
    {
      "if": { "properties": { "consumption": { "type": "object", "properties": { "state": { "const": "reserved" } }, "required": ["state"] } }, "required": ["consumption"] },
      "then": {
        "properties": {
          "checkpoint": { "const": null },
          "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_CONSUMPTION_INCOMPLETE" } } }
        }
      }
    },
    {
      "if": { "properties": { "consumption": { "type": "object", "properties": { "state": { "const": "started" } }, "required": ["state"] } }, "required": ["consumption"] },
      "then": { "properties": { "checkpoint": { "type": "object" } } }
    },
    {
      "if": { "properties": { "checkpoint": { "type": "object", "properties": { "state": { "const": "prepared" } }, "required": ["state"] } }, "required": ["checkpoint"] },
      "then": { "properties": { "checkpoint": { "properties": { "phase": { "const": "prepared" }, "currentOutputId": { "const": null }, "outputs": { "items": { "properties": { "state": { "const": "pending" } } } }, "failure": { "const": null } } } } }
    },
    {
      "if": { "properties": { "checkpoint": { "type": "object", "properties": { "state": { "enum": ["applying", "verifying"] } }, "required": ["state"] } }, "required": ["checkpoint"] },
      "then": { "properties": { "checkpoint": { "properties": { "failure": { "const": null } } } } }
    },
    {
      "if": { "properties": { "checkpoint": { "type": "object", "properties": { "state": { "const": "applying" } }, "required": ["state"] } }, "required": ["checkpoint"] },
      "then": { "properties": { "checkpoint": { "properties": { "phase": { "enum": ["directories", "outputs", "manifest"] }, "outputs": { "items": { "properties": { "state": { "enum": ["pending", "applied"] } } } } } } } }
    },
    {
      "if": { "properties": { "checkpoint": { "type": "object", "properties": { "state": { "const": "verifying" } }, "required": ["state"] } }, "required": ["checkpoint"] },
      "then": {
        "properties": {
          "checkpoint": {
            "properties": {
              "phase": { "const": "verifying" },
              "outputs": { "items": { "properties": { "state": { "const": "applied" } } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "checkpoint": { "type": "object", "properties": { "state": { "const": "completed" } }, "required": ["state"] } }, "required": ["checkpoint"] },
      "then": {
        "properties": {
          "plan": { "properties": { "applicability": { "const": "applied" } } },
          "checkpoint": {
            "properties": {
              "phase": { "const": "terminal" },
              "currentOutputId": { "const": null },
              "outputs": { "items": { "properties": { "state": { "const": "verified" } } } },
              "failure": { "const": null }
            }
          },
          "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_COMPLETED" } } },
          "claims": { "properties": { "localProjection": { "const": "passed" } } }
        }
      }
    },
    {
      "if": { "properties": { "checkpoint": { "type": "object", "properties": { "state": { "const": "rolling-back" } }, "required": ["state"] } }, "required": ["checkpoint"] },
      "then": { "properties": { "checkpoint": { "properties": { "phase": { "const": "rollback" }, "failure": { "type": "object" } } } } }
    },
    {
      "if": { "properties": { "checkpoint": { "type": "object", "properties": { "state": { "const": "rolled-back" } }, "required": ["state"] } }, "required": ["checkpoint"] },
      "then": {
        "properties": {
          "checkpoint": {
            "properties": {
              "phase": { "const": "terminal" },
              "currentOutputId": { "const": null },
              "outputs": { "items": { "properties": { "state": { "const": "rolled-back" } } } },
              "failure": { "type": "object" }
            }
          },
          "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_ROLLED_BACK" } } },
          "claims": { "properties": { "localProjection": { "const": "unknown" } } }
        }
      }
    },
    {
      "if": { "properties": { "checkpoint": { "type": "object", "properties": { "state": { "const": "needs-attention" } }, "required": ["state"] } }, "required": ["checkpoint"] },
      "then": {
        "properties": {
          "checkpoint": { "properties": { "phase": { "const": "terminal" }, "failure": { "type": "object" } } },
          "resume": {
            "properties": {
              "classification": { "const": "requires-review" },
              "reason": { "const": "Checkpoint state requires exact local inspection before any further action." },
              "permittedNextAction": { "const": "inspect-checkpoint" }
            }
          },
          "claims": { "properties": { "localProjection": { "const": "unknown" } } }
        }
      }
    },
    {
      "if": { "properties": { "checkpoint": { "const": null } }, "required": ["checkpoint"] },
      "then": { "properties": { "plan": { "properties": { "applicability": { "enum": ["current", "stale", "expired"] } } }, "claims": { "properties": { "localProjection": { "const": "unknown" } } } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "const": "applied" } }, "required": ["applicability"] } }, "required": ["plan"] },
      "then": { "properties": { "checkpoint": { "type": "object", "properties": { "state": { "const": "completed" } }, "required": ["state"] } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "const": "current" } }, "required": ["applicability"] }, "checkpoint": { "type": "object", "properties": { "state": { "const": "prepared" } }, "required": ["state"] } }, "required": ["plan", "checkpoint"] },
      "then": { "properties": { "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_CHECKPOINT_READY" } } } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "enum": ["stale", "expired"] } }, "required": ["applicability"] }, "checkpoint": { "type": "object", "properties": { "state": { "const": "prepared" } }, "required": ["state"] } }, "required": ["plan", "checkpoint"] },
      "then": { "properties": { "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_CHECKPOINT_REVIEW_REQUIRED" } } } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "const": "current" } }, "required": ["applicability"] }, "checkpoint": { "type": "object", "properties": { "state": { "enum": ["applying", "verifying", "rolling-back"] } }, "required": ["state"] } }, "required": ["plan", "checkpoint"] },
      "then": { "properties": { "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_CHECKPOINT_RECOVERABLE" } } } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "enum": ["stale", "expired"] } }, "required": ["applicability"] }, "checkpoint": { "type": "object", "properties": { "state": { "enum": ["applying", "verifying", "rolling-back"] } }, "required": ["state"] } }, "required": ["plan", "checkpoint"] },
      "then": { "properties": { "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_CHECKPOINT_REVIEW_REQUIRED" } } } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "const": "stale" } }, "required": ["applicability"] }, "checkpoint": { "const": null }, "consumption": { "const": null } }, "required": ["plan", "checkpoint", "consumption"] },
      "then": { "properties": { "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_PLAN_STALE" } } } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "const": "expired" } }, "required": ["applicability"] }, "checkpoint": { "const": null }, "consumption": { "const": null } }, "required": ["plan", "checkpoint", "consumption"] },
      "then": { "properties": { "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_PLAN_EXPIRED" } } } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "const": "current" } }, "required": ["applicability"] }, "request": { "const": null }, "confirmation": { "const": null }, "consumption": { "const": null }, "checkpoint": { "const": null } }, "required": ["plan", "request", "confirmation", "consumption", "checkpoint"] },
      "then": { "properties": { "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_PLAN_CURRENT" } } } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "const": "current" } }, "required": ["applicability"] }, "request": { "type": "object", "properties": { "state": { "const": "current" } }, "required": ["state"] }, "confirmation": { "const": null }, "consumption": { "const": null }, "checkpoint": { "const": null } }, "required": ["plan", "request", "confirmation", "consumption", "checkpoint"] },
      "then": { "properties": { "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_CONFIRMATION_PENDING" } } } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "const": "current" } }, "required": ["applicability"] }, "request": { "type": "object", "properties": { "state": { "const": "expired" } }, "required": ["state"] }, "confirmation": { "const": null }, "consumption": { "const": null }, "checkpoint": { "const": null } }, "required": ["plan", "request", "confirmation", "consumption", "checkpoint"] },
      "then": { "properties": { "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_REQUEST_EXPIRED" } } } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "const": "current" } }, "required": ["applicability"] }, "request": { "type": "object", "properties": { "state": { "const": "current" } }, "required": ["state"] }, "confirmation": { "type": "object" }, "consumption": { "const": null }, "checkpoint": { "const": null } }, "required": ["plan", "request", "confirmation", "consumption", "checkpoint"] },
      "then": { "properties": { "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_CONFIRMATION_CURRENT" } } } } }
    },
    {
      "if": { "properties": { "plan": { "properties": { "applicability": { "const": "current" } }, "required": ["applicability"] }, "request": { "type": "object", "properties": { "state": { "const": "expired" } }, "required": ["state"] }, "confirmation": { "type": "object" }, "consumption": { "const": null }, "checkpoint": { "const": null } }, "required": ["plan", "request", "confirmation", "consumption", "checkpoint"] },
      "then": { "properties": { "resume": { "properties": { "reasonCode": { "const": "HOST_REALIZATION_CONFIRMATION_EXPIRED" } } } } }
    }
  ],
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "version": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" },
    "versionedReference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "fingerprint"],
      "properties": {
        "id": { "type": "string" },
        "version": { "$ref": "#/$defs/version" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "requestRecord": {
      "oneOf": [
        { "const": null },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "fingerprint", "state", "at"],
          "properties": {
            "id": { "type": "string" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "state": { "enum": ["current", "expired"] },
            "at": { "type": "string", "minLength": 20 }
          }
        }
      ]
    },
    "consumptionRecord": {
      "oneOf": [
        { "const": null },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "fingerprint", "state", "at"],
          "properties": {
            "id": { "type": "string" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "state": { "enum": ["reserved", "started"] },
            "at": { "type": "string", "minLength": 20 }
          }
        }
      ]
    },
    "confirmationRecord": {
      "oneOf": [
        { "const": null },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "fingerprint", "state", "at", "actor"],
          "properties": {
            "id": { "type": "string" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "state": { "const": "confirmed" },
            "at": { "type": "string" },
            "actor": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
          }
        }
      ]
    }
  }
}
