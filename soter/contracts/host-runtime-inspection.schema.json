{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/host-runtime-inspection/v1",
  "title": "Soter host runtime inspection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "inspectedAt",
    "host",
    "server",
    "runtime",
    "authority",
    "privacy",
    "inspectionFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/host-runtime-inspection/v1" },
    "contractVersion": { "const": "1.0.0" },
    "inspectedAt": { "type": "string", "minLength": 20 },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "startedAt"],
      "properties": {
        "name": { "const": "soter-core" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "startedAt": { "type": "string", "minLength": 20 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "startupFingerprint",
        "currentFingerprint",
        "reasonCode",
        "restartRequired",
        "permittedNextAction"
      ],
      "properties": {
        "state": { "enum": ["current", "not-realized", "stale"] },
        "startupFingerprint": { "$ref": "#/$defs/nullableFingerprint" },
        "currentFingerprint": { "$ref": "#/$defs/nullableFingerprint" },
        "reasonCode": {
          "enum": [
            "SOTER_HOST_RUNTIME_CURRENT",
            "SOTER_HOST_RUNTIME_NOT_REALIZED",
            "SOTER_HOST_RUNTIME_STALE"
          ]
        },
        "restartRequired": { "type": ["boolean", "null"] },
        "permittedNextAction": {
          "enum": [
            "continue",
            "realize-host-runtime",
            "none",
            "restart-host-runtime"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": { "const": "current" },
            "startupFingerprint": { "$ref": "#/$defs/fingerprint" },
            "currentFingerprint": { "$ref": "#/$defs/fingerprint" },
            "reasonCode": { "const": "SOTER_HOST_RUNTIME_CURRENT" },
            "restartRequired": { "const": false },
            "permittedNextAction": { "const": "continue" }
          }
        },
        {
          "properties": {
            "state": { "const": "not-realized" },
            "startupFingerprint": { "const": null },
            "currentFingerprint": { "const": null },
            "reasonCode": { "const": "SOTER_HOST_RUNTIME_NOT_REALIZED" },
            "restartRequired": { "const": true },
            "permittedNextAction": { "const": "realize-host-runtime" }
          }
        },
        {
          "properties": {
            "state": { "const": "stale" },
            "startupFingerprint": { "$ref": "#/$defs/nullableFingerprint" },
            "currentFingerprint": { "const": null },
            "reasonCode": { "const": "SOTER_HOST_RUNTIME_STALE" },
            "restartRequired": { "const": null },
            "permittedNextAction": { "const": "none" }
          }
        },
        {
          "properties": {
            "state": { "const": "stale" },
            "startupFingerprint": { "$ref": "#/$defs/nullableFingerprint" },
            "currentFingerprint": { "$ref": "#/$defs/fingerprint" },
            "reasonCode": { "const": "SOTER_HOST_RUNTIME_STALE" },
            "restartRequired": { "const": true },
            "permittedNextAction": { "const": "restart-host-runtime" }
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grants", "providerCallsPermitted", "writesPermitted"],
      "properties": {
        "grants": { "const": "none" },
        "providerCallsPermitted": { "const": false },
        "writesPermitted": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentialValuesIncluded", "providerResponsesIncluded", "privateStateIncluded"],
      "properties": {
        "credentialValuesIncluded": { "const": false },
        "providerResponsesIncluded": { "const": false },
        "privateStateIncluded": { "const": false }
      }
    },
    "inspectionFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
