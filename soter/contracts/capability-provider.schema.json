{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/capability-provider/v1",
  "title": "Soter capability provider implementation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "pack",
    "version",
    "containment",
    "runtime",
    "capabilities",
    "authorities",
    "effects",
    "mappings",
    "fixtures",
    "limitations"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/capability-provider/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^provider\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "pack": {
      "type": "string",
      "pattern": "^integration\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": { "$ref": "#/$defs/version" },
    "containment": {
      "enum": ["fixture", "contained", "connected", "canary", "live"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "module"],
      "properties": {
        "engine": { "enum": ["node", "mcp"] },
        "module": { "type": "string", "minLength": 1 },
        "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "prepareExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "completeExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "probePlanExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "probeStepCompleteExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "probeFinalizeExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "responseProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          }
        },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilities", "completePageExport", "finalizeExport", "maximumPages"],
          "properties": {
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 3 }
            },
            "completePageExport": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
            },
            "finalizeExport": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
            },
            "maximumPages": { "type": "integer", "minimum": 2, "maximum": 101 }
          }
        },
        "server": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "endpointProvisioning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "state", "hosts"],
          "properties": {
            "target": { "const": "host-project-config" },
            "state": { "const": "required" },
            "hosts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["codex", "claude"]
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "probeTools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "engine": { "const": "mcp" } },
            "required": ["engine"]
          },
          "then": {
            "required": [
              "engine",
              "module",
              "prepareExport",
              "completeExport",
              "probePlanExport",
              "probeStepCompleteExport",
              "probeFinalizeExport",
              "responseProfiles",
              "server",
              "tools",
              "probeTools"
            ]
          }
        },
        {
          "if": { "required": ["endpointProvisioning"] },
          "then": {
            "properties": { "engine": { "const": "mcp" } },
            "required": ["engine"]
          }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "$ref": "#/$defs/version" }
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "subject"],
        "properties": {
          "role": {
            "enum": ["definition", "instance", "provider", "projection", "evidence"]
          },
          "subject": { "type": "string", "minLength": 1 }
        }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/effect" }
    },
    "mappings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fixtures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "effect": {
      "enum": ["read", "disclosure", "write", "dispatch", "destructive"]
    }
  }
}
