{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/configuration-transaction-checkpoint/v1",
  "title": "Soter durable local configuration transaction checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "id", "createdAt", "updatedAt", "state", "phase",
    "plan", "request", "confirmation", "consumption", "configuration", "observation",
    "failure", "checkpointFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/configuration-transaction-checkpoint/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^checkpoint\\.configuration\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "updatedAt": { "type": "string", "minLength": 20 },
    "state": { "enum": ["prepared", "applying", "verifying", "completed", "rolling-back", "rolled-back", "needs-attention"] },
    "phase": { "enum": ["prepared", "configuration-unchanged", "configuration-written", "active-lock-written", "verifying", "rollback-configuration", "rollback-active-lock", "terminal"] },
    "plan": { "$ref": "#/$defs/reference" },
    "request": { "$ref": "#/$defs/reference" },
    "confirmation": { "$ref": "#/$defs/reference" },
    "consumption": { "$ref": "#/$defs/reference" },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sourceKind", "currentDocumentFingerprint", "candidateDocumentFingerprint", "currentLockFingerprint", "candidateLockFingerprint"],
      "properties": {
        "name": { "type": "string" },
        "sourceKind": { "const": "private-active" },
        "currentDocumentFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidateDocumentFingerprint": { "$ref": "#/$defs/fingerprint" },
        "currentLockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidateLockFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceKind", "templateFingerprint", "documentFingerprint", "activeLockFingerprint", "resolutionFingerprint"],
      "properties": {
        "sourceKind": { "enum": ["tracked-template", "private-active", "invalid"] },
        "templateFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "documentFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "activeLockFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "resolutionFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "failure": {
      "oneOf": [
        { "const": null },
        {
          "type": "object", "additionalProperties": false, "required": ["reasonCode", "summary"],
          "properties": {
            "reasonCode": { "type": "string", "pattern": "^CONFIGURATION_[A-Z0-9_]+$" },
            "summary": { "type": "string", "minLength": 8 }
          }
        }
      ]
    },
    "checkpointFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "prepared" } }, "required": ["state"] },
      "then": { "properties": { "phase": { "const": "prepared" }, "failure": { "const": null } } }
    },
    {
      "if": { "properties": { "state": { "const": "applying" } }, "required": ["state"] },
      "then": {
        "properties": {
          "phase": { "enum": ["prepared", "configuration-unchanged", "configuration-written", "active-lock-written"] },
          "failure": { "const": null }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "verifying" } }, "required": ["state"] },
      "then": { "properties": { "phase": { "const": "verifying" }, "failure": { "const": null } } }
    },
    {
      "if": { "properties": { "state": { "const": "completed" } }, "required": ["state"] },
      "then": {
        "properties": {
          "phase": { "const": "terminal" },
          "failure": { "const": null },
          "observation": {
            "properties": {
              "sourceKind": { "const": "private-active" },
              "templateFingerprint": { "$ref": "#/$defs/fingerprint" },
              "documentFingerprint": { "$ref": "#/$defs/fingerprint" },
              "activeLockFingerprint": { "$ref": "#/$defs/fingerprint" },
              "resolutionFingerprint": { "$ref": "#/$defs/fingerprint" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "rolling-back" } }, "required": ["state"] },
      "then": {
        "properties": {
          "phase": { "enum": ["rollback-configuration", "rollback-active-lock"] },
          "failure": { "$ref": "#/$defs/failure" }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "rolled-back" } }, "required": ["state"] },
      "then": { "properties": { "phase": { "const": "terminal" }, "failure": { "$ref": "#/$defs/failure" } } }
    },
    {
      "if": { "properties": { "state": { "const": "needs-attention" } }, "required": ["state"] },
      "then": { "properties": { "phase": { "const": "terminal" }, "failure": { "$ref": "#/$defs/failure" } } }
    }
  ],
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "failure": {
      "type": "object", "additionalProperties": false, "required": ["reasonCode", "summary"],
      "properties": {
        "reasonCode": { "type": "string", "pattern": "^CONFIGURATION_[A-Z0-9_]+$" },
        "summary": { "type": "string", "minLength": 8 }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["id", "fingerprint"],
      "properties": { "id": { "type": "string" }, "fingerprint": { "$ref": "#/$defs/fingerprint" } }
    }
  }
}
