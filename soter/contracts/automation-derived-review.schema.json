{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/automation-derived-review/v1",
  "title": "Soter Automation-owned derived review declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$contract", "contractVersion", "automation", "kind", "items"],
  "properties": {
    "$contract": { "const": "soter://contracts/automation-derived-review/v1" },
    "contractVersion": { "const": "1.0.0" },
    "automation": {
      "type": "string", "pattern": "^automation\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "kind": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "fields"],
        "properties": {
          "kind": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "fields": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "label", "type"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "type": { "enum": ["text", "boolean", "string-list"] }
              }
            }
          }
        }
      }
    }
  }
}
