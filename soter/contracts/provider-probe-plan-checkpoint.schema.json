{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/provider-probe-plan-checkpoint/v1",
  "title": "Soter durable sequential provider probe checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "kind",
    "createdAt",
    "updatedAt",
    "state",
    "configuration",
    "configurationLock",
    "graphFingerprint",
    "host",
    "provider",
    "plan",
    "planFingerprint",
    "steps",
    "currentStepId",
    "result",
    "privacy",
    "checkpointFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/provider-probe-plan-checkpoint/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^checkpoint\\.probeplan\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "kind": { "const": "provider-probe" },
    "createdAt": { "type": "string", "minLength": 20 },
    "updatedAt": { "type": "string", "minLength": 20 },
    "state": { "enum": ["requested", "completed", "failed"] },
    "configuration": { "$ref": "#/$defs/configurationSelection" },
    "configurationLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fingerprint"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
    "host": { "$ref": "#/$defs/host" },
    "provider": { "$ref": "#/$defs/provider" },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "probeId",
        "configuration",
        "scope",
        "validForSeconds",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^probeplan\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "probeId": {
          "type": "string",
          "pattern": "^probe\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "configuration": { "$ref": "#/$defs/configurationSelection" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credentialRefs", "authorities", "capabilities"],
          "properties": {
            "credentialRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^secret-ref\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
              }
            },
            "authorities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^authority\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
              }
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 3 }
            }
          }
        },
        "validForSeconds": { "type": "integer", "minimum": 60, "maximum": 900 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/planStep" }
        }
      }
    },
    "planFingerprint": { "$ref": "#/$defs/fingerprint" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/runtimeStep" }
    },
    "currentStepId": {
      "type": ["string", "null"],
      "pattern": "^step\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "result": { "type": ["object", "null"] },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "rawProviderResponsePersisted",
        "hostCredentialValuesPersisted"
      ],
      "properties": {
        "scope": { "const": "private" },
        "rawProviderResponsePersisted": { "const": false },
        "hostCredentialValuesPersisted": { "const": false }
      }
    },
    "checkpointFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "failure": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "authentication" },
            "code": { "const": "HOST_CALL_AUTHENTICATION_FAILED" },
            "message": { "const": "The exact host operation could not authenticate." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "authorization" },
            "code": { "const": "HOST_CALL_AUTHORIZATION_FAILED" },
            "message": { "const": "The exact host operation was not authorized." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "HOST_CALL_VALIDATION_FAILED" },
            "message": { "const": "The exact host operation failed governed validation." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message", "diagnosticFingerprint"],
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "HOST_CALL_SCHEMA_INVALID" },
            "message": { "const": "The exact host operation data did not satisfy its governed schema." },
            "diagnosticFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "conflict" },
            "code": { "const": "HOST_CALL_CONFLICT" },
            "message": { "const": "The exact host operation encountered a conflict." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "rate-limit" },
            "code": { "const": "HOST_CALL_RATE_LIMITED" },
            "message": { "const": "The exact host operation was rate limited." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "unavailable" },
            "code": { "const": "HOST_CALL_UNAVAILABLE" },
            "message": { "const": "The exact host operation was unavailable." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "retryable" },
            "code": { "const": "HOST_CALL_RETRYABLE_FAILURE" },
            "message": { "const": "The exact host operation reported a retryable failure." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "not-found" },
            "code": { "const": "HOST_CALL_NOT_FOUND" },
            "message": { "const": "The exact host operation did not find its governed subject." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "unknown" },
            "code": { "const": "HOST_CALL_FAILED" },
            "message": { "const": "The exact host operation failed." }
          }
        }
      ]
    },
    "configurationSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "configurationBasis", "path", "lockPath",
        "lockFingerprint", "graphFingerprint"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "configurationBasis": { "const": "private-active" },
        "path": { "type": "string", "minLength": 1 },
        "lockPath": { "type": "string", "minLength": 1 },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "implementation", "version", "containment"],
      "properties": {
        "pack": { "type": "string", "minLength": 3 },
        "implementation": {
          "type": "string",
          "pattern": "^provider\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": { "$ref": "#/$defs/version" },
        "containment": { "const": "connected" }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "server", "operation", "tool", "responseProfile"],
      "properties": {
        "protocol": { "const": "mcp" },
        "server": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "responseProfile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        }
      }
    },
    "planStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "subject",
        "scopeFingerprint",
        "transport",
        "argumentsFingerprint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^step\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "kind": { "enum": ["identity", "schema", "read", "document"] },
        "subject": { "$ref": "#/$defs/fingerprint" },
        "scopeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "transport": { "$ref": "#/$defs/transport" },
        "argumentsFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "requestedCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt",
        "completedAt",
        "state",
        "transport",
        "arguments",
        "argumentsFingerprint",
        "responseFingerprint",
        "error"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^probecall\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "createdAt": { "type": "string", "minLength": 20 },
        "completedAt": { "type": "null" },
        "state": { "const": "requested" },
        "transport": { "$ref": "#/$defs/transport" },
        "arguments": { "type": "object" },
        "argumentsFingerprint": { "$ref": "#/$defs/fingerprint" },
        "responseFingerprint": { "type": "null" },
        "error": { "type": "null" }
      }
    },
    "completedCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt",
        "completedAt",
        "state",
        "transport",
        "argumentsFingerprint",
        "responseFingerprint",
        "error"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^probecall\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "createdAt": { "type": "string", "minLength": 20 },
        "completedAt": { "type": "string", "minLength": 20 },
        "state": { "const": "completed" },
        "transport": { "$ref": "#/$defs/transport" },
        "argumentsFingerprint": { "$ref": "#/$defs/fingerprint" },
        "responseFingerprint": { "$ref": "#/$defs/fingerprint" },
        "error": { "type": "null" }
      }
    },
    "failedCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt",
        "completedAt",
        "state",
        "transport",
        "argumentsFingerprint",
        "responseFingerprint",
        "error"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^probecall\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "createdAt": { "type": "string", "minLength": 20 },
        "completedAt": { "type": "string", "minLength": 20 },
        "state": { "const": "failed" },
        "transport": { "$ref": "#/$defs/transport" },
        "argumentsFingerprint": { "$ref": "#/$defs/fingerprint" },
        "responseFingerprint": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "error": { "$ref": "#/$defs/failure" }
      }
    },
    "failureSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message"],
      "properties": {
        "kind": {
          "enum": [
            "authentication", "authorization", "validation", "conflict",
            "rate-limit", "unavailable", "retryable", "not-found", "unknown"
          ]
        },
        "code": {
          "enum": [
            "HOST_CALL_AUTHENTICATION_FAILED",
            "HOST_CALL_AUTHORIZATION_FAILED",
            "HOST_CALL_VALIDATION_FAILED",
            "HOST_CALL_SCHEMA_INVALID",
            "HOST_CALL_CONFLICT",
            "HOST_CALL_RATE_LIMITED",
            "HOST_CALL_UNAVAILABLE",
            "HOST_CALL_RETRYABLE_FAILURE",
            "HOST_CALL_NOT_FOUND",
            "HOST_CALL_FAILED"
          ]
        },
        "message": {
          "enum": [
            "The exact host operation could not authenticate.",
            "The exact host operation was not authorized.",
            "The exact host operation failed governed validation.",
            "The exact host operation data did not satisfy its governed schema.",
            "The exact host operation encountered a conflict.",
            "The exact host operation was rate limited.",
            "The exact host operation was unavailable.",
            "The exact host operation reported a retryable failure.",
            "The exact host operation did not find its governed subject.",
            "The exact host operation failed."
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "authentication" },
            "code": { "const": "HOST_CALL_AUTHENTICATION_FAILED" },
            "message": { "const": "The exact host operation could not authenticate." }
          }
        },
        {
          "properties": {
            "kind": { "const": "authorization" },
            "code": { "const": "HOST_CALL_AUTHORIZATION_FAILED" },
            "message": { "const": "The exact host operation was not authorized." }
          }
        },
        {
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "HOST_CALL_VALIDATION_FAILED" },
            "message": { "const": "The exact host operation failed governed validation." }
          }
        },
        {
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "HOST_CALL_SCHEMA_INVALID" },
            "message": { "const": "The exact host operation data did not satisfy its governed schema." }
          }
        },
        {
          "properties": {
            "kind": { "const": "conflict" },
            "code": { "const": "HOST_CALL_CONFLICT" },
            "message": { "const": "The exact host operation encountered a conflict." }
          }
        },
        {
          "properties": {
            "kind": { "const": "rate-limit" },
            "code": { "const": "HOST_CALL_RATE_LIMITED" },
            "message": { "const": "The exact host operation was rate limited." }
          }
        },
        {
          "properties": {
            "kind": { "const": "unavailable" },
            "code": { "const": "HOST_CALL_UNAVAILABLE" },
            "message": { "const": "The exact host operation was unavailable." }
          }
        },
        {
          "properties": {
            "kind": { "const": "retryable" },
            "code": { "const": "HOST_CALL_RETRYABLE_FAILURE" },
            "message": { "const": "The exact host operation reported a retryable failure." }
          }
        },
        {
          "properties": {
            "kind": { "const": "not-found" },
            "code": { "const": "HOST_CALL_NOT_FOUND" },
            "message": { "const": "The exact host operation did not find its governed subject." }
          }
        },
        {
          "properties": {
            "kind": { "const": "unknown" },
            "code": { "const": "HOST_CALL_FAILED" },
            "message": { "const": "The exact host operation failed." }
          }
        }
      ]
    },
    "minimizedResultValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer", "minimum": 0 },
        { "$ref": "#/$defs/fingerprint" },
        {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/minimizedResultValue" }
        },
        { "$ref": "#/$defs/minimizedResultObject" }
      ]
    },
    "minimizedResultField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityFingerprint", "value"],
      "properties": {
        "identityFingerprint": { "$ref": "#/$defs/fingerprint" },
        "value": { "$ref": "#/$defs/minimizedResultValue" }
      }
    },
    "minimizedResultObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/minimizedResultField" }
        }
      }
    },
    "failedRuntimeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "sequence", "state", "call", "result", "resultFingerprint", "error"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^step\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "sequence": { "type": "integer", "minimum": 1 },
        "state": { "const": "failed" },
        "call": { "$ref": "#/$defs/failedCall" },
        "result": { "type": "null" },
        "resultFingerprint": { "type": "null" },
        "error": { "$ref": "#/$defs/failureSummary" }
      },
      "oneOf": [
        {
          "properties": {
            "call": { "properties": { "error": { "properties": { "code": { "const": "HOST_CALL_AUTHENTICATION_FAILED" } } } } },
            "error": { "properties": { "code": { "const": "HOST_CALL_AUTHENTICATION_FAILED" } } }
          }
        },
        {
          "properties": {
            "call": { "properties": { "error": { "properties": { "code": { "const": "HOST_CALL_AUTHORIZATION_FAILED" } } } } },
            "error": { "properties": { "code": { "const": "HOST_CALL_AUTHORIZATION_FAILED" } } }
          }
        },
        {
          "properties": {
            "call": { "properties": { "error": { "properties": { "code": { "const": "HOST_CALL_VALIDATION_FAILED" } } } } },
            "error": { "properties": { "code": { "const": "HOST_CALL_VALIDATION_FAILED" } } }
          }
        },
        {
          "properties": {
            "call": { "properties": { "error": { "properties": { "code": { "const": "HOST_CALL_SCHEMA_INVALID" } } } } },
            "error": { "properties": { "code": { "const": "HOST_CALL_SCHEMA_INVALID" } } }
          }
        },
        {
          "properties": {
            "call": { "properties": { "error": { "properties": { "code": { "const": "HOST_CALL_CONFLICT" } } } } },
            "error": { "properties": { "code": { "const": "HOST_CALL_CONFLICT" } } }
          }
        },
        {
          "properties": {
            "call": { "properties": { "error": { "properties": { "code": { "const": "HOST_CALL_RATE_LIMITED" } } } } },
            "error": { "properties": { "code": { "const": "HOST_CALL_RATE_LIMITED" } } }
          }
        },
        {
          "properties": {
            "call": { "properties": { "error": { "properties": { "code": { "const": "HOST_CALL_UNAVAILABLE" } } } } },
            "error": { "properties": { "code": { "const": "HOST_CALL_UNAVAILABLE" } } }
          }
        },
        {
          "properties": {
            "call": { "properties": { "error": { "properties": { "code": { "const": "HOST_CALL_RETRYABLE_FAILURE" } } } } },
            "error": { "properties": { "code": { "const": "HOST_CALL_RETRYABLE_FAILURE" } } }
          }
        },
        {
          "properties": {
            "call": { "properties": { "error": { "properties": { "code": { "const": "HOST_CALL_NOT_FOUND" } } } } },
            "error": { "properties": { "code": { "const": "HOST_CALL_NOT_FOUND" } } }
          }
        },
        {
          "properties": {
            "call": { "properties": { "error": { "properties": { "code": { "const": "HOST_CALL_FAILED" } } } } },
            "error": { "properties": { "code": { "const": "HOST_CALL_FAILED" } } }
          }
        }
      ]
    },
    "runtimeStep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "sequence", "state", "call", "result", "resultFingerprint", "error"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^step\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            },
            "sequence": { "type": "integer", "minimum": 1 },
            "state": { "const": "pending" },
            "call": { "type": "null" },
            "result": { "type": "null" },
            "resultFingerprint": { "type": "null" },
            "error": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "sequence", "state", "call", "result", "resultFingerprint", "error"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^step\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            },
            "sequence": { "type": "integer", "minimum": 1 },
            "state": { "const": "requested" },
            "call": { "$ref": "#/$defs/requestedCall" },
            "result": { "type": "null" },
            "resultFingerprint": { "type": "null" },
            "error": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "sequence", "state", "call", "result", "resultFingerprint", "error"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^step\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            },
            "sequence": { "type": "integer", "minimum": 1 },
            "state": { "const": "completed" },
            "call": { "$ref": "#/$defs/completedCall" },
            "result": { "$ref": "#/$defs/minimizedResultObject" },
            "resultFingerprint": { "$ref": "#/$defs/fingerprint" },
            "error": { "type": "null" }
          }
        },
        { "$ref": "#/$defs/failedRuntimeStep" }
      ]
    }
  }
}
