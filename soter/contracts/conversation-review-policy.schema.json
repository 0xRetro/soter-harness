{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/conversation-review-policy/v1",
  "title": "Soter provider-neutral collaboration conversation-review policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "name",
    "windows",
    "maximumSelectedConversations",
    "maximumConversationObservations",
    "maximumMessagesPerConversation",
    "maximumThreadsPerReview",
    "maximumMessagesPerThread",
    "allowedConversationKinds",
    "directMessagesIncluded",
    "threadReadsRequireWindowRootOrExplicitSelection",
    "threadExpansionMode",
    "completeCoverageRequired",
    "contentClassification",
    "suspectedInjectionSurfaced",
    "persistenceProposalsAllowed",
    "writesAllowed",
    "limitations"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/conversation-review-policy/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "const": "policy.context.communications.collaboration.conversation-review"
    },
    "name": { "type": "string", "minLength": 3, "maxLength": 120 },
    "windows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "durationHours"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "durationHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 744
          }
        }
      }
    },
    "maximumSelectedConversations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "maximumConversationObservations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "maximumMessagesPerConversation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maximumThreadsPerReview": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "maximumMessagesPerThread": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "allowedConversationKinds": {
      "const": ["public-channel", "private-channel"]
    },
    "directMessagesIncluded": { "const": false },
    "threadReadsRequireWindowRootOrExplicitSelection": { "const": true },
    "threadExpansionMode": { "const": "explicit-selection-only" },
    "completeCoverageRequired": { "const": true },
    "contentClassification": { "const": "private-untrusted" },
    "suspectedInjectionSurfaced": { "const": true },
    "persistenceProposalsAllowed": { "const": false },
    "writesAllowed": { "const": false },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 12 }
    }
  }
}
