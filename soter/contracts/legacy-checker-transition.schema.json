{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/legacy-checker-transition/v1",
  "title": "Soter legacy checker authority transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "source",
    "coverage",
    "rules",
    "limitations",
    "transitionFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/legacy-checker-transition/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "const": "kernel.legacy-checker-transition" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fingerprint", "effectiveCodeCount", "effectiveCodesFingerprint"],
      "properties": {
        "path": { "const": ".claude/scripts/check.mjs" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "effectiveCodeCount": { "const": 47 },
        "effectiveCodesFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernelRule", "intentionalRetirement", "total"],
      "properties": {
        "kernelRule": { "type": "integer", "minimum": 1 },
        "intentionalRetirement": { "type": "integer", "minimum": 1 },
        "total": { "const": 47 }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 47,
      "maxItems": 47,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/kernelRule" },
          { "$ref": "#/$defs/intentionalRetirement" }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 20, "maxLength": 500 }
    },
    "transitionFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "legacyCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "targetPath": { "type": "string", "pattern": "^soter/[A-Za-z0-9._+/-]+$" },
    "baseRule": {
      "type": "object",
      "required": ["sequence", "legacyCode", "disposition", "rationale"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 47 },
        "legacyCode": { "$ref": "#/$defs/legacyCode" },
        "disposition": { "enum": ["kernel-rule", "intentional-retirement"] },
        "rationale": { "type": "string", "minLength": 20, "maxLength": 700 }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "path", "anchors"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9._:/#-]+$" },
        "path": { "$ref": "#/$defs/targetPath" },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 160 }
        }
      }
    },
    "kernelRule": {
      "allOf": [
        { "$ref": "#/$defs/baseRule" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence", "legacyCode", "disposition", "coverageKind", "enforcements", "rationale"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 1, "maximum": 47 },
            "legacyCode": { "$ref": "#/$defs/legacyCode" },
            "disposition": { "const": "kernel-rule" },
            "coverageKind": { "enum": ["equivalent", "intentional-change"] },
            "enforcements": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/enforcement" }
            },
            "rationale": { "type": "string", "minLength": 20, "maxLength": 700 }
          }
        }
      ]
    },
    "intentionalRetirement": {
      "allOf": [
        { "$ref": "#/$defs/baseRule" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence", "legacyCode", "disposition", "reasonCode", "replacementBoundary", "rationale"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 1, "maximum": 47 },
            "legacyCode": { "$ref": "#/$defs/legacyCode" },
            "disposition": { "const": "intentional-retirement" },
            "reasonCode": { "type": "string", "pattern": "^LEGACY_[A-Z0-9_]+_RETIRED$" },
            "replacementBoundary": { "type": "string", "minLength": 20, "maxLength": 500 },
            "rationale": { "type": "string", "minLength": 20, "maxLength": 700 }
          }
        }
      ]
    }
  }
}
