{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contexts/crm/organization-capture-policy/v1",
  "title": "Soter CRM organization-capture policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "name",
    "createRequiresConfirmation",
    "duplicateCandidateLimit",
    "maximumAliases",
    "aliasSuffixes",
    "typeRules",
    "tagRules",
    "relationsOnCreate"
  ],
  "properties": {
    "$contract": { "const": "soter://contexts/crm/organization-capture-policy/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^policy\\.context\\.crm\\.organization-capture(?:[.-][a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createRequiresConfirmation": { "const": true },
    "duplicateCandidateLimit": { "type": "integer", "minimum": 1, "maximum": 25 },
    "maximumAliases": { "type": "integer", "minimum": 1, "maximum": 12 },
    "aliasSuffixes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 80 }
    },
    "typeRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/classificationRule" }
    },
    "tagRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/classificationRule" }
    },
    "relationsOnCreate": { "const": "empty" }
  },
  "$defs": {
    "classificationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "value"],
      "properties": {
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "value": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
