{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/development-host-execution/v1",
  "title": "Soter private trusted host evaluation execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "executionFingerprint",
    "startedAt",
    "completedAt",
    "request",
    "workflow",
    "host",
    "adapter",
    "runs",
    "authority",
    "privacy",
    "limitations"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/development-host-execution/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^development-host-execution[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "executionFingerprint": { "$ref": "#/$defs/fingerprint" },
    "startedAt": { "$ref": "#/$defs/instant" },
    "completedAt": { "$ref": "#/$defs/instant" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^development-request[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evaluatedSubjectFingerprint", "evaluationSetFingerprint"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^automation[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "evaluatedSubjectFingerprint": { "$ref": "#/$defs/fingerprint" },
        "evaluationSetFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evaluatedInstructionFingerprint", "candidateProjectionFingerprint"],
      "properties": {
        "id": { "enum": ["codex", "claude"] },
        "evaluatedInstructionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidateProjectionFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "implementationFingerprint",
        "runtimeFingerprint",
        "executable",
        "argvTemplateFingerprint",
        "policy"
      ],
      "properties": {
        "id": {
          "enum": ["development-host-observer.codex", "development-host-observer.claude"]
        },
        "version": { "const": "1.0.0" },
        "implementationFingerprint": { "$ref": "#/$defs/fingerprint" },
        "runtimeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "mode", "binaryFingerprint"],
          "properties": {
            "id": { "enum": ["codex-cli", "claude-cli"] },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+-]*$"
            },
            "mode": { "enum": ["0500", "0550", "0555", "0700", "0750", "0755"] },
            "binaryFingerprint": { "$ref": "#/$defs/fingerprint" }
          },
          "allOf": [
            {
              "if": { "properties": { "id": { "const": "codex-cli" } } },
              "then": {
                "properties": {
                  "version": {
                    "pattern": "^codex-cli (?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.][0-9A-Za-z]+)*)?(?:[+][0-9A-Za-z.-]+)?$"
                  }
                }
              }
            },
            {
              "if": { "properties": { "id": { "const": "claude-cli" } } },
              "then": {
                "properties": {
                  "version": {
                    "pattern": "^(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.][0-9A-Za-z]+)*)?(?:[+][0-9A-Za-z.-]+)? [(]Claude Code[)]$"
                  }
                }
              }
            }
          ]
        },
        "argvTemplateFingerprint": { "$ref": "#/$defs/fingerprint" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binaryIdentity",
            "freshProcessPerRun",
            "projectCustomizations",
            "sessionPersistence",
            "toolAccess",
            "workingDirectory",
            "workerAnswerKey"
          ],
          "properties": {
            "binaryIdentity": { "const": "exact-local-bytes-version-mode-not-publisher-trust" },
            "freshProcessPerRun": { "const": true },
            "projectCustomizations": { "const": "disabled" },
            "sessionPersistence": { "const": "disabled" },
            "toolAccess": { "const": "disabled-and-observed-use-fails-closed" },
            "workingDirectory": { "const": "fresh-private-empty-directory" },
            "workerAnswerKey": { "const": "withheld" }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/run" }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "grantsExecution",
        "grantsApproval",
        "grantsPublication",
        "grantsMerge",
        "grantsProviderRead",
        "grantsProviderWrite",
        "grantsHostRealization",
        "grantsPromotion"
      ],
      "properties": {
        "kind": { "const": "private-host-evaluation-execution-only" },
        "grantsExecution": { "const": false },
        "grantsApproval": { "const": false },
        "grantsPublication": { "const": false },
        "grantsMerge": { "const": false },
        "grantsProviderRead": { "const": false },
        "grantsProviderWrite": { "const": false },
        "grantsHostRealization": { "const": false },
        "grantsPromotion": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "workspaceInspectionIncluded",
        "absoluteExecutablePathIncluded",
        "absoluteWorkerPathsIncluded",
        "stimulusIncluded",
        "evaluatedInstructionsIncluded",
        "expectedCriteriaIncluded",
        "prohibitedCriteriaIncluded",
        "rawTranscriptsIncluded",
        "rawTranscriptsStoredPrivately",
        "credentialsIncluded"
      ],
      "properties": {
        "scope": { "const": "private-runtime" },
        "workspaceInspectionIncluded": { "const": false },
        "absoluteExecutablePathIncluded": { "const": false },
        "absoluteWorkerPathsIncluded": { "const": false },
        "stimulusIncluded": { "const": false },
        "evaluatedInstructionsIncluded": { "const": false },
        "expectedCriteriaIncluded": { "const": false },
        "prohibitedCriteriaIncluded": { "const": false },
        "rawTranscriptsIncluded": { "const": false },
        "rawTranscriptsStoredPrivately": { "const": true },
        "credentialsIncluded": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DEVELOPMENT_HOST_EXECUTION_JUDGMENT_REQUIRED",
          "DEVELOPMENT_HOST_EXECUTION_NO_AUTHORITY",
          "DEVELOPMENT_HOST_EXECUTION_LOCAL_BINARY_IDENTITY_ONLY"
        ]
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]{3})?Z$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "caseId",
        "arm",
        "guideState",
        "startedAt",
        "completedAt",
        "workerId",
        "workerFingerprint",
        "dispatchFingerprint",
        "promptFingerprint",
        "transcriptFingerprint",
        "process"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evaluation-run[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 500 },
        "caseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "arm": { "enum": ["baseline", "guided"] },
        "guideState": { "enum": ["withheld", "candidate"] },
        "startedAt": { "$ref": "#/$defs/instant" },
        "completedAt": { "$ref": "#/$defs/instant" },
        "workerId": {
          "type": "string",
          "pattern": "^worker-run[.][a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "workerFingerprint": { "$ref": "#/$defs/fingerprint" },
        "dispatchFingerprint": { "$ref": "#/$defs/fingerprint" },
        "promptFingerprint": { "$ref": "#/$defs/fingerprint" },
        "transcriptFingerprint": { "$ref": "#/$defs/fingerprint" },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "exitCode", "signal", "toolCallsObserved"],
          "properties": {
            "state": { "const": "completed" },
            "exitCode": { "const": 0 },
            "signal": { "type": "null" },
            "toolCallsObserved": { "const": 0 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "arm": { "const": "baseline" } } },
          "then": { "properties": { "guideState": { "const": "withheld" } } }
        },
        {
          "if": { "properties": { "arm": { "const": "guided" } } },
          "then": { "properties": { "guideState": { "const": "candidate" } } }
        }
      ]
    }
  }
}
