{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/legacy-inventory/v2",
  "title": "Soter complete legacy artifact inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "basis",
    "stateCounts",
    "bindingStateCounts",
    "items",
    "limitations",
    "inventoryFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/legacy-inventory/v2" },
    "contractVersion": { "const": "2.0.0" },
    "id": { "const": "legacy.claude.v1-baseline" },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRoot", "baselineBranch", "baselineCommit", "fileCount", "treeFingerprint"],
      "properties": {
        "sourceRoot": { "const": ".claude" },
        "baselineBranch": { "const": "soter-harness-v1" },
        "baselineCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "treeFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "stateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapped", "bridged", "migrated", "retired"],
      "properties": {
        "mapped": { "type": "integer", "minimum": 0 },
        "bridged": { "type": "integer", "minimum": 0 },
        "migrated": { "type": "integer", "minimum": 0 },
        "retired": { "type": "integer", "minimum": 0 }
      }
    },
    "bindingStateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapped", "bridged", "migrated", "retired"],
      "properties": {
        "mapped": { "type": "integer", "minimum": 0 },
        "bridged": { "type": "integer", "minimum": 0 },
        "migrated": { "type": "integer", "minimum": 0 },
        "retired": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/item" }
    },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 12 }
    },
    "inventoryFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourcePath": { "type": "string", "pattern": "^[.]claude/[A-Za-z0-9._+/-]+$" },
    "targetPath": { "type": "string", "pattern": "^soter/[A-Za-z0-9._+/-]+$" },
    "targetId": { "type": "string", "pattern": "^(kernel|core|context|automation|integration|host|configuration)[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^soter/[A-Za-z0-9._+/-]+[.]json$"
      }
    },
    "targetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "id",
        "path",
        "responsibility",
        "state",
        "canonicalAuthority",
        "fallback",
        "parity",
        "evidence"
      ],
      "properties": {
        "status": { "enum": ["existing", "planned"] },
        "id": { "$ref": "#/$defs/targetId" },
        "path": { "$ref": "#/$defs/targetPath" },
        "responsibility": { "type": "string", "minLength": 12 },
        "state": { "enum": ["mapped", "bridged", "migrated", "retired"] },
        "canonicalAuthority": { "enum": ["legacy", "target", "none"] },
        "fallback": { "enum": ["retained", "removed"] },
        "parity": { "enum": ["not-evaluated", "intentional-change", "proven"] },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "mapped" } } },
          "then": {
            "properties": {
              "canonicalAuthority": { "const": "legacy" },
              "fallback": { "const": "retained" },
              "parity": { "const": "not-evaluated" },
              "evidence": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "bridged" } } },
          "then": {
            "properties": {
              "status": { "const": "existing" },
              "canonicalAuthority": { "const": "legacy" },
              "fallback": { "const": "retained" },
              "parity": { "const": "not-evaluated" },
              "evidence": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "migrated" } } },
          "then": {
            "properties": {
              "status": { "const": "existing" },
              "canonicalAuthority": { "const": "target" },
              "fallback": { "const": "removed" },
              "parity": { "enum": ["intentional-change", "proven"] },
              "evidence": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "retired" } } },
          "then": {
            "properties": {
              "status": { "const": "existing" },
              "canonicalAuthority": { "const": "none" },
              "fallback": { "const": "removed" },
              "parity": { "enum": ["intentional-change", "proven"] },
              "evidence": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "sourcePath",
        "sourceFingerprint",
        "sourcePresence",
        "sourceRole",
        "state",
        "targets",
        "why",
        "retirementCriteria"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "sourcePath": { "$ref": "#/$defs/sourcePath" },
        "sourceFingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourcePresence": { "enum": ["present", "removed"] },
        "sourceRole": {
          "enum": [
            "host-config",
            "rule",
            "system",
            "skill",
            "evaluation",
            "fixture",
            "standard",
            "template",
            "runtime-tool",
            "guide"
          ]
        },
        "state": { "enum": ["mapped", "bridged", "migrated", "retired"] },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/targetBinding" }
        },
        "why": { "type": "string", "minLength": 20 },
        "retirementCriteria": { "type": "string", "minLength": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "mapped" } } },
          "then": {
            "properties": {
              "sourcePresence": { "const": "present" },
              "targets": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/targetBinding" },
                    { "properties": { "state": { "const": "mapped" } } }
                  ]
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "bridged" } } },
          "then": {
            "properties": {
              "sourcePresence": { "const": "present" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "migrated" } } },
          "then": {
            "properties": {
              "sourcePresence": { "const": "removed" },
              "targets": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/targetBinding" },
                    { "properties": { "state": { "enum": ["migrated", "retired"] } } }
                  ]
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "retired" } } },
          "then": {
            "properties": {
              "sourcePresence": { "const": "removed" },
              "targets": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/targetBinding" },
                    { "properties": { "state": { "const": "retired" } } }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
