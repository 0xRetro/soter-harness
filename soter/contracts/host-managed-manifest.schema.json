{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/host-managed-manifest/v1",
  "title": "Soter private managed host output manifest",
  "type": "object", "additionalProperties": false,
  "required": ["$contract", "contractVersion", "id", "host", "targetFingerprint", "configuration", "definition", "generator", "outputs", "checkpoint", "manifestFingerprint"],
  "properties": {
    "$contract": { "const": "soter://contracts/host-managed-manifest/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^host-managed-manifest[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "host": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "targetFingerprint": { "$ref": "#/$defs/fingerprint" },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "lockFingerprint", "graphFingerprint"],
      "properties": {
        "name": { "type": "string" },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "definition": { "$ref": "#/$defs/versionedReference" },
    "generator": { "$ref": "#/$defs/versionedReference" },
    "outputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "role", "mode", "contentFingerprint", "fingerprint"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "role": { "enum": ["instructions", "skills", "tools", "lifecycle", "configuration"] },
          "mode": { "const": "0644" },
          "contentFingerprint": { "$ref": "#/$defs/fingerprint" },
          "fingerprint": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "checkpoint": { "$ref": "#/$defs/reference" },
    "manifestFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fingerprint"],
      "properties": { "id": { "type": "string" }, "fingerprint": { "$ref": "#/$defs/fingerprint" } }
    },
    "versionedReference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "fingerprint"],
      "properties": {
        "id": { "type": "string" },
        "version": { "$ref": "#/$defs/version" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
