{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/prepared-work-derived-review-material/v1",
  "title": "Soter private derived prepared-work review material",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "fingerprint", "contentFingerprint",
    "createdAt", "workId", "preparedWorkFingerprint", "checkpointId",
    "checkpointFingerprint", "automation", "configuration",
    "inputContractFingerprint", "reviewContractId", "reviewContractFingerprint",
    "applicability", "kind", "items", "privacy"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/prepared-work-derived-review-material/v1" },
    "contractVersion": { "const": "1.0.0" },
    "fingerprint": { "$ref": "#/$defs/fingerprint" },
    "contentFingerprint": { "$ref": "#/$defs/fingerprint" },
    "createdAt": { "type": "string", "minLength": 20 },
    "workId": { "type": "string", "pattern": "^work\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "preparedWorkFingerprint": { "$ref": "#/$defs/fingerprint" },
    "checkpointId": { "type": "string", "minLength": 1 },
    "checkpointFingerprint": { "$ref": "#/$defs/fingerprint" },
    "automation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^automation\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "lockFingerprint"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "inputContractFingerprint": { "$ref": "#/$defs/fingerprint" },
    "reviewContractId": { "const": "soter://contracts/automation-derived-review/v1" },
    "reviewContractFingerprint": { "$ref": "#/$defs/fingerprint" },
    "applicability": { "enum": ["current", "stale"] },
    "kind": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "sources", "fields", "fingerprint"],
        "properties": {
          "id": { "type": "string", "pattern": "^review-item\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "kind": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "sources": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["collectionId", "rowId", "rowFingerprint"],
              "properties": {
                "collectionId": {
                  "type": "string",
                  "pattern": "^collection\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                },
                "rowId": {
                  "type": "string",
                  "pattern": "^row\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                },
                "rowFingerprint": { "$ref": "#/$defs/fingerprint" }
              }
            }
          },
          "fields": {
            "type": "array", "minItems": 1,
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/textField" },
                { "$ref": "#/$defs/booleanField" },
                { "$ref": "#/$defs/stringListField" }
              ]
            }
          },
          "fingerprint": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "scope", "authority", "projection", "rawProviderResponsesIncluded",
        "rawMessageBodiesIncluded", "workspaceInspectionIncluded",
        "evidenceIncluded", "canonicalArtifactsIncluded"
      ],
      "properties": {
        "scope": { "const": "private-local-derived-review" },
        "authority": { "const": "none" },
        "projection": { "const": "selected-work-only" },
        "rawProviderResponsesIncluded": { "const": false },
        "rawMessageBodiesIncluded": { "const": false },
        "workspaceInspectionIncluded": { "const": false },
        "evidenceIncluded": { "const": false },
        "canonicalArtifactsIncluded": { "const": false }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "textField": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "type", "fingerprint", "reviewValue"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "const": "text" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "reviewValue": { "type": "string", "minLength": 1, "maxLength": 50000 }
      }
    },
    "booleanField": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "type", "fingerprint", "reviewValue"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "const": "boolean" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "reviewValue": { "type": "boolean" }
      }
    },
    "stringListField": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "type", "fingerprint", "reviewValue"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "const": "string-list" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "reviewValue": {
          "type": "array", "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
