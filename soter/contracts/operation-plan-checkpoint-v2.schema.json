{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/operation-plan-checkpoint/v2",
  "title": "Soter durable sequential bound operation plan checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "kind",
    "createdAt",
    "updatedAt",
    "state",
    "configuration",
    "configurationLock",
    "graphFingerprint",
    "host",
    "run",
    "plan",
    "planFingerprint",
    "steps",
    "currentStepId",
    "result",
    "privacy",
    "checkpointFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/operation-plan-checkpoint/v2" },
    "contractVersion": { "const": "2.0.0" },
    "id": {
      "type": "string",
      "pattern": "^checkpoint\\.plan\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "kind": { "const": "operation-plan" },
    "createdAt": { "type": "string", "minLength": 20 },
    "updatedAt": { "type": "string", "minLength": 20 },
    "state": { "enum": ["requested", "completed", "failed", "blocked"] },
    "configuration": { "$ref": "#/$defs/configurationSelection" },
    "configurationLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fingerprint"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourcePath", "statePath", "fingerprint"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "sourcePath": { "type": "string", "minLength": 1 },
        "statePath": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "plan": { "type": "object" },
    "planFingerprint": { "$ref": "#/$defs/fingerprint" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sequence",
          "state",
          "resolvedInput",
          "resolvedInputFingerprint",
          "bindingResolutions",
          "call",
          "output",
          "outputFingerprint",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^step\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "sequence": { "type": "integer", "minimum": 1 },
          "state": {
            "enum": ["pending", "requested", "completed", "skipped", "failed", "blocked"]
          },
          "resolvedInput": { "type": ["object", "null"] },
          "resolvedInputFingerprint": {
            "type": ["string", "null"],
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bindingResolutions": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/bindingResolution" }
          },
          "call": { "type": ["object", "null"] },
          "output": { "type": ["object", "null"] },
          "outputFingerprint": {
            "type": ["string", "null"],
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "error": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/failure" }
            ]
          }
        }
      }
    },
    "currentStepId": {
      "type": ["string", "null"],
      "pattern": "^step\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "result": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["stepResults"],
      "properties": {
        "stepResults": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stepId",
              "state",
              "resolvedInputFingerprint",
              "outputFingerprint"
            ],
            "properties": {
              "stepId": {
                "type": "string",
                "pattern": "^step\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
              },
              "state": { "enum": ["completed", "skipped"] },
              "resolvedInputFingerprint": { "$ref": "#/$defs/fingerprint" },
              "outputFingerprint": {
                "type": ["string", "null"],
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "rawProviderResponsePersisted",
        "hostCredentialValuesPersisted"
      ],
      "properties": {
        "scope": { "const": "private" },
        "rawProviderResponsePersisted": { "const": false },
        "hostCredentialValuesPersisted": { "const": false }
      }
    },
    "checkpointFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "failure": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "authentication" },
            "code": { "const": "HOST_CALL_AUTHENTICATION_FAILED" },
            "message": { "const": "The exact host operation could not authenticate." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "authorization" },
            "code": { "const": "HOST_CALL_AUTHORIZATION_FAILED" },
            "message": { "const": "The exact host operation was not authorized." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "HOST_CALL_VALIDATION_FAILED" },
            "message": { "const": "The exact host operation failed governed validation." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message", "diagnosticFingerprint"],
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "HOST_CALL_SCHEMA_INVALID" },
            "message": { "const": "The exact host operation data did not satisfy its governed schema." },
            "diagnosticFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "conflict" },
            "code": { "const": "HOST_CALL_CONFLICT" },
            "message": { "const": "The exact host operation encountered a conflict." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "rate-limit" },
            "code": { "const": "HOST_CALL_RATE_LIMITED" },
            "message": { "const": "The exact host operation was rate limited." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "unavailable" },
            "code": { "const": "HOST_CALL_UNAVAILABLE" },
            "message": { "const": "The exact host operation was unavailable." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "retryable" },
            "code": { "const": "HOST_CALL_RETRYABLE_FAILURE" },
            "message": { "const": "The exact host operation reported a retryable failure." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "not-found" },
            "code": { "const": "HOST_CALL_NOT_FOUND" },
            "message": { "const": "The exact host operation did not find its governed subject." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "unknown" },
            "code": { "const": "HOST_CALL_FAILED" },
            "message": { "const": "The exact host operation failed." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "OPERATION_PLAN_BINDING_INVALID" },
            "message": { "const": "The exact operation-plan binding was invalid." }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": { "const": "validation" },
            "code": { "const": "OPERATION_PLAN_BINDING_EMPTY" },
            "message": { "const": "An exact required operation-plan binding resolved no values." }
          }
        }
      ]
    },
    "configurationSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "configurationBasis", "path", "lockPath",
        "lockFingerprint", "graphFingerprint"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "configurationBasis": {
          "enum": ["tracked-contained", "private-active"]
        },
        "path": { "type": "string", "minLength": 1 },
        "lockPath": { "type": "string", "minLength": 1 },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "bindingResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceStepId",
        "sourceOutputFingerprint",
        "sourcePath",
        "targetPath",
        "transform",
        "onEmpty",
        "state",
        "valueCount",
        "valueFingerprint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^binding\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "sourceStepId": {
          "type": "string",
          "pattern": "^step\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "sourceOutputFingerprint": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sourcePath": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string" }
        },
        "targetPath": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string" }
        },
        "transform": { "enum": ["unique-string-list", "exact-string"] },
        "onEmpty": { "enum": ["skip-step", "fail-plan"] },
        "state": { "enum": ["bound", "empty"] },
        "valueCount": { "type": "integer", "minimum": 0 },
        "valueFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
