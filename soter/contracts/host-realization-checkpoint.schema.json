{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/host-realization-checkpoint/v1",
  "title": "Soter durable local host realization checkpoint",
  "type": "object", "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "id", "createdAt", "updatedAt", "state", "phase",
    "plan", "request", "confirmation", "consumption", "targetFingerprint", "configuration",
    "currentOutputId", "outputs", "createdDirectories", "observation", "failure",
    "authorityFingerprint", "checkpointFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/host-realization-checkpoint/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^checkpoint[.]host-realization[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "updatedAt": { "type": "string", "minLength": 20 },
    "state": { "enum": ["prepared", "applying", "verifying", "completed", "rolling-back", "rolled-back", "needs-attention"] },
    "phase": { "enum": ["prepared", "directories", "outputs", "manifest", "verifying", "rollback", "terminal"] },
    "plan": { "$ref": "#/$defs/reference" },
    "request": { "$ref": "#/$defs/reference" },
    "confirmation": { "$ref": "#/$defs/reference" },
    "consumption": { "$ref": "#/$defs/reference" },
    "targetFingerprint": { "$ref": "#/$defs/fingerprint" },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "lockFingerprint", "graphFingerprint"],
      "properties": {
        "name": { "type": "string" },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "currentOutputId": { "type": ["string", "null"] },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sequence", "path", "action", "state", "observedFingerprint"],
        "properties": {
          "id": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 0 },
          "path": { "type": "string" },
          "action": { "enum": ["create", "replace", "remove"] },
          "state": { "enum": ["pending", "applied", "verified", "rolled-back"] },
          "observedFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "createdDirectories": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "state"],
        "properties": {
          "path": { "type": "string" },
          "state": { "enum": ["planned", "created", "removed"] }
        }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["manifestFingerprint", "outputFingerprint"],
      "properties": {
        "manifestFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "outputFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "failure": {
      "oneOf": [
        { "const": null },
        {
          "type": "object", "additionalProperties": false,
          "required": ["reasonCode", "summary"],
          "properties": {
            "reasonCode": { "type": "string", "pattern": "^HOST_REALIZATION_[A-Z0-9_]+$" },
            "summary": { "type": "string", "minLength": 8 }
          }
        }
      ]
    },
    "authorityFingerprint": { "$ref": "#/$defs/fingerprint" },
    "checkpointFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fingerprint"],
      "properties": { "id": { "type": "string" }, "fingerprint": { "$ref": "#/$defs/fingerprint" } }
    }
  }
}
