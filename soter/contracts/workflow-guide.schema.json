{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/workflow-guide/v2",
  "title": "Soter active provider-neutral workflow guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "contentFingerprint",
    "workflow",
    "skill",
    "status",
    "authority",
    "stepDetails",
    "verification",
    "gotchas",
    "references",
    "privacy",
    "limitations"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/workflow-guide/v2" },
    "contractVersion": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^workflow-guide[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "contentFingerprint": { "$ref": "#/$defs/fingerprint" },
    "workflow": { "$ref": "#/$defs/workflowBinding" },
    "skill": { "$ref": "#/$defs/skill" },
    "status": { "$ref": "#/$defs/activeStatus" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "executionAuthority", "effectAuthority", "approvalAuthority", "providerTransactionAuthority", "reasonCode"],
      "properties": {
        "kind": { "const": "procedural-guidance" },
        "executionAuthority": { "const": "none" },
        "effectAuthority": { "const": "none" },
        "approvalAuthority": { "const": "none" },
        "providerTransactionAuthority": { "const": "none" },
        "reasonCode": { "const": "WORKFLOW_GUIDE_NO_EXECUTION_AUTHORITY" }
      }
    },
    "stepDetails": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stepDetail" }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 12, "maxLength": 500 }
    },
    "gotchas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gotcha" }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceSpecificValuesIncluded", "credentialsIncluded", "privateInputsIncluded", "providerResponsesIncluded"],
      "properties": {
        "workspaceSpecificValuesIncluded": { "const": false },
        "credentialsIncluded": { "const": false },
        "privateInputsIncluded": { "const": false },
        "providerResponsesIncluded": { "const": false }
      }
    },
    "limitations": { "$ref": "#/$defs/limitations" }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "workflowBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "definitionPath", "definitionFingerprint", "evaluationSetPath", "evaluationSetFingerprint"],
      "properties": {
        "id": { "type": "string", "pattern": "^automation[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "version": { "$ref": "#/$defs/version" },
        "definitionPath": { "type": "string", "pattern": "^soter/automations/[a-z0-9]+(?:-[a-z0-9]+)*/definition[.]json$" },
        "definitionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "evaluationSetPath": { "type": "string", "pattern": "^soter/automations/[a-z0-9]+(?:-[a-z0-9]+)*/evaluations[.]json$" },
        "evaluationSetFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "invocation", "displayName", "shortDescription", "defaultPrompt"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": { "type": "string", "minLength": 20, "maxLength": 500 },
        "invocation": { "const": "explicit-only" },
        "displayName": { "type": "string", "minLength": 3, "maxLength": 80 },
        "shortDescription": { "type": "string", "minLength": 12, "maxLength": 100 },
        "defaultPrompt": { "type": "string", "minLength": 12, "maxLength": 300 }
      }
    },
    "activeStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCode", "delivery", "permittedNextAction"],
      "properties": {
        "state": { "const": "active" },
        "reasonCode": { "const": "WORKFLOW_GUIDE_ACTIVE" },
        "delivery": { "const": "host-skill" },
        "permittedNextAction": { "const": "invoke-through-selected-host" }
      }
    },
    "stepDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "instructions", "flexibility", "stopConditions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 100 },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 12, "maxLength": 700 }
        },
        "flexibility": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 12, "maxLength": 400 }
        },
        "stopConditions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 12, "maxLength": 400 }
        }
      }
    },
    "gotcha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary", "countermeasure"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["baseline", "observed", "research", "constraint"] },
        "summary": { "type": "string", "minLength": 12, "maxLength": 500 },
        "countermeasure": { "type": "string", "minLength": 12, "maxLength": 500 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "target"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["architecture", "contract", "configuration", "pack", "workflow", "command", "capability"] },
        "label": { "type": "string", "minLength": 3, "maxLength": 120 },
        "target": { "type": "string", "minLength": 3, "maxLength": 240 }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 12, "maxLength": 500 }
    }
  }
}
