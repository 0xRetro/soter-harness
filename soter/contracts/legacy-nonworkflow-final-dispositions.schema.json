{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/legacy-nonworkflow-final-dispositions/v1",
  "title": "Soter governed non-workflow legacy final dispositions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "basis",
    "rows",
    "summary",
    "declarationFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/legacy-nonworkflow-final-dispositions/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "const": "legacy-nonworkflow-final-dispositions.v2-migration" },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryPath",
        "inventoryFingerprint",
        "unfinishedBindingSetFingerprint",
        "directWorkflowBindingCount"
      ],
      "properties": {
        "inventoryPath": { "const": "soter/migrations/legacy-inventory.json" },
        "inventoryFingerprint": { "$ref": "#/$defs/fingerprint" },
        "unfinishedBindingSetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "directWorkflowBindingCount": { "const": 42 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 66,
      "maxItems": 66,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCount",
        "bindingCount",
        "migrated",
        "retired",
        "intentionalChange"
      ],
      "properties": {
        "sourceCount": { "const": 38 },
        "bindingCount": { "const": 66 },
        "migrated": { "const": 55 },
        "retired": { "const": 11 },
        "intentionalChange": { "const": 66 }
      }
    },
    "declarationFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^[.]claude/[A-Za-z0-9._+/-]+$"
    },
    "targetPath": {
      "type": "string",
      "pattern": "^soter/[A-Za-z0-9._+/-]+$"
    },
    "evidencePath": {
      "type": "string",
      "pattern": "^soter/(?:fixtures|evidence)/(?:[A-Za-z0-9._+-]+/)*[A-Za-z0-9._+-]+[.]json$"
    },
    "rowBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "sourcePath",
        "sourceFingerprint",
        "targetId",
        "targetPath",
        "state",
        "parity",
        "finalEvidence",
        "reasonCode"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 66 },
        "sourcePath": { "$ref": "#/$defs/sourcePath" },
        "sourceFingerprint": { "$ref": "#/$defs/fingerprint" },
        "targetId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "targetPath": { "$ref": "#/$defs/targetPath" },
        "parity": { "const": "intentional-change" },
        "finalEvidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidencePath" }
        },
        "state": { "enum": ["migrated", "retired"] },
        "reasonCode": {
          "enum": [
            "AUTOMATION_AUTHORITY_INTENTIONAL_CHANGE",
            "CORE_TRANSACTION_AUTHORITY_INTENTIONAL_CHANGE",
            "GOVERNED_HOST_PROJECTION_INTENTIONAL_CHANGE",
            "KERNEL_GOVERNANCE_AUTHORITY_INTENTIONAL_CHANGE",
            "PORTABLE_CONTEXT_AUTHORITY_INTENTIONAL_CHANGE",
            "PRIVATE_CONFIGURATION_AUTHORITY_INTENTIONAL_CHANGE",
            "PROVIDER_SHAPED_WORKFLOW_INTENTIONALLY_RETIRED",
            "TYPED_INTEGRATION_AUTHORITY_INTENTIONAL_CHANGE",
            "UNSUPPORTED_CLAUDE_DELIVERY_INTENTIONALLY_RETIRED"
          ]
        }
      }
    },
    "row": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/rowBase" },
            {
              "properties": {
                "state": { "const": "migrated" },
                "reasonCode": {
                  "enum": [
                    "AUTOMATION_AUTHORITY_INTENTIONAL_CHANGE",
                    "CORE_TRANSACTION_AUTHORITY_INTENTIONAL_CHANGE",
                    "GOVERNED_HOST_PROJECTION_INTENTIONAL_CHANGE",
                    "KERNEL_GOVERNANCE_AUTHORITY_INTENTIONAL_CHANGE",
                    "PORTABLE_CONTEXT_AUTHORITY_INTENTIONAL_CHANGE",
                    "PRIVATE_CONFIGURATION_AUTHORITY_INTENTIONAL_CHANGE",
                    "TYPED_INTEGRATION_AUTHORITY_INTENTIONAL_CHANGE"
                  ]
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/rowBase" },
            {
              "properties": {
                "state": { "const": "retired" },
                "reasonCode": {
                  "enum": [
                    "PROVIDER_SHAPED_WORKFLOW_INTENTIONALLY_RETIRED",
                    "UNSUPPORTED_CLAUDE_DELIVERY_INTENTIONALLY_RETIRED"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}
