{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/evidence/v2",
  "title": "Soter evidence record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "createdAt",
    "claimFamily",
    "claim",
    "subject",
    "configurationLockFingerprint",
    "graphFingerprint",
    "dependencies",
    "host",
    "integrations",
    "authorities",
    "evaluator",
    "environment",
    "acceptanceCriteria",
    "result",
    "outcomes",
    "artifacts",
    "effects",
    "failures",
    "warnings",
    "skipped",
    "limitations",
    "freshness",
    "supersedes",
    "privacy"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/evidence/v2" },
    "contractVersion": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^evidence\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "claimFamily": {
      "enum": ["graph", "preparation", "context", "behavior", "transaction", "readiness", "health"]
    },
    "claim": { "type": "string", "minLength": 12 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version"],
      "properties": {
        "type": { "enum": ["pack", "configuration", "host", "automation", "run"] },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] }
      }
    },
    "configurationLockFingerprint": { "$ref": "#/$defs/fingerprint" },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "host": { "$ref": "#/$defs/host" },
    "integrations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/integration" }
    },
    "authorities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/authority" }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "level"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "level": {
          "enum": ["static", "graph", "fixture", "agent", "contained", "canary", "monitored"]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containment", "runtime"],
      "properties": {
        "containment": { "enum": ["offline", "fixture", "connected", "canary", "live"] },
        "runtime": { "type": "string", "minLength": 1 }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "result": { "$ref": "#/$defs/resultState" },
    "outcomes": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "effects": { "type": "array", "items": { "type": "object" } },
    "failures": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "skipped": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "validUntil"],
      "properties": {
        "policy": { "type": "string", "minLength": 3 },
        "validUntil": { "type": ["string", "null"] }
      }
    },
    "supersedes": { "type": ["string", "null"], "pattern": "^evidence\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "redactions"],
      "properties": {
        "scope": { "enum": ["private", "shareable", "public"] },
        "redactions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "privateContainedBasis": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/privateContainedBasis" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["evaluator"],
        "properties": {
          "evaluator": {
            "required": ["id"],
            "properties": {
              "id": { "pattern": "[.]contained-connected-(workflow|review)$" }
            }
          }
        }
      },
      "then": {
        "required": ["privateContainedBasis"],
        "properties": {
          "privateContainedBasis": { "$ref": "#/$defs/privateContainedBasis" }
        }
      },
      "else": {
        "properties": {
          "privateContainedBasis": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "resultState": {
      "enum": ["passed", "failed", "stale", "unknown", "skipped", "not-applicable"]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "fingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "version", "manifestFingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "manifestFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifestFingerprint", "evidenceMaturity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "manifestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "evidenceMaturity": { "enum": ["declared", "fixture-proven", "contained-proven", "live-proven"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "subject", "declarationFingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["definition", "instance", "provider", "projection", "evidence"] },
        "subject": { "type": "string", "minLength": 1 },
        "declarationFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "privateContainedBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "configurationName",
        "privateConfigurationFingerprint",
        "privateLockFingerprint",
        "privateGraphFingerprint",
        "trackedTemplateLockFingerprint",
        "trackedTemplateGraphFingerprint",
        "applicabilityProjectionFingerprint",
        "substitutions",
        "privacy",
        "basisFingerprint"
      ],
      "properties": {
        "kind": { "const": "private-active-contained" },
        "version": { "const": "1.2.0" },
        "configurationName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "privateConfigurationFingerprint": { "$ref": "#/$defs/fingerprint" },
        "privateLockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "privateGraphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "trackedTemplateLockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "trackedTemplateGraphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "applicabilityProjectionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "substitutions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "notionTargetCount",
            "notionDocumentSourceCount",
            "providerFixtureDocumentCount",
            "notionOptionMappingScopeCount",
            "notionOptionMappingEntryCount",
            "notionOptionMappingScopeFingerprint",
            "notionFieldBindingScopeCount",
            "notionFieldBindingScopeFingerprint"
          ],
          "properties": {
            "notionTargetCount": { "type": "integer", "minimum": 1 },
            "notionDocumentSourceCount": { "type": "integer", "minimum": 0 },
            "providerFixtureDocumentCount": { "type": "integer", "minimum": 0 },
            "notionOptionMappingScopeCount": { "type": "integer", "minimum": 0 },
            "notionOptionMappingEntryCount": { "type": "integer", "minimum": 0 },
            "notionOptionMappingScopeFingerprint": { "$ref": "#/$defs/fingerprint" },
            "notionFieldBindingScopeCount": { "type": "integer", "minimum": 1 },
            "notionFieldBindingScopeFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fullPrivateLockIncluded",
            "privateConfigurationPathIncluded",
            "providerTargetValuesIncluded",
            "providerSourceValuesIncluded",
            "providerOptionValuesIncluded",
            "providerFieldNamesIncluded",
            "rawProviderResponsesIncluded",
            "privateInputsIncluded"
          ],
          "properties": {
            "fullPrivateLockIncluded": { "const": false },
            "privateConfigurationPathIncluded": { "const": false },
            "providerTargetValuesIncluded": { "const": false },
            "providerSourceValuesIncluded": { "const": false },
            "providerOptionValuesIncluded": { "const": false },
            "providerFieldNamesIncluded": { "const": false },
            "rawProviderResponsesIncluded": { "const": false },
            "privateInputsIncluded": { "const": false }
          }
        },
        "basisFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
