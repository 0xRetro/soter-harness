{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/evidence/v2",
  "title": "Soter evidence record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "createdAt",
    "claimFamily",
    "claim",
    "subject",
    "configurationLockFingerprint",
    "graphFingerprint",
    "dependencies",
    "host",
    "integrations",
    "authorities",
    "evaluator",
    "environment",
    "acceptanceCriteria",
    "result",
    "outcomes",
    "artifacts",
    "effects",
    "failures",
    "warnings",
    "skipped",
    "limitations",
    "freshness",
    "supersedes",
    "privacy"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/evidence/v2" },
    "contractVersion": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^evidence\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "claimFamily": {
      "enum": ["graph", "preparation", "context", "behavior", "transaction", "readiness", "health", "migration"]
    },
    "claim": { "type": "string", "minLength": 12 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version"],
      "properties": {
        "type": { "enum": ["pack", "configuration", "host", "automation", "run"] },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] }
      }
    },
    "configurationLockFingerprint": { "$ref": "#/$defs/fingerprint" },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "host": { "$ref": "#/$defs/host" },
    "integrations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/integration" }
    },
    "authorities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/authority" }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "level"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "level": {
          "enum": ["static", "graph", "fixture", "agent", "contained", "canary", "monitored"]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containment", "runtime"],
      "properties": {
        "containment": { "enum": ["offline", "fixture", "connected", "canary", "live"] },
        "runtime": { "type": "string", "minLength": 1 }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "result": { "$ref": "#/$defs/resultState" },
    "outcomes": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "effects": { "type": "array", "items": { "type": "object" } },
    "failures": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "skipped": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "validUntil"],
      "properties": {
        "policy": { "type": "string", "minLength": 3 },
        "validUntil": { "type": ["string", "null"] }
      }
    },
    "supersedes": { "type": ["string", "null"], "pattern": "^evidence\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "redactions"],
      "properties": {
        "scope": { "enum": ["private", "shareable", "public"] },
        "redactions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "resultState": {
      "enum": ["passed", "failed", "stale", "unknown", "skipped", "not-applicable"]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "fingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "version", "manifestFingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "manifestFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifestFingerprint", "evidenceMaturity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "manifestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "evidenceMaturity": { "enum": ["declared", "fixture-proven", "contained-proven", "live-proven"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "subject", "declarationFingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["definition", "instance", "provider", "projection", "evidence"] },
        "subject": { "type": "string", "minLength": 1 },
        "declarationFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
