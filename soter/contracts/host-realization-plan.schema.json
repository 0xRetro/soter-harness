{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/host-realization-plan/v1",
  "title": "Soter private exact host realization plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "id", "createdAt", "validUntil", "target",
    "host", "configuration", "manifest", "candidateManifest", "operations", "scopeFingerprint", "planFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/host-realization-plan/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^host-realization-plan[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "$ref": "#/$defs/time" },
    "validUntil": { "$ref": "#/$defs/time" },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["requestedPath", "realPath", "device", "inode", "fingerprint"],
      "properties": {
        "requestedPath": { "type": "string", "minLength": 1 },
        "realPath": { "type": "string", "minLength": 1 },
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 0 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "adapter", "definition", "generator"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "adapter": { "$ref": "#/$defs/id" },
        "definition": { "$ref": "#/$defs/versionedReference" },
        "generator": { "$ref": "#/$defs/versionedReference" }
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "activeLockPath", "lockFingerprint", "graphFingerprint"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "activeLockPath": { "type": "string", "pattern": "^[.]soter/state/configuration-locks/.+[.]json$" },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "manifest": { "$ref": "#/$defs/manifestSnapshot" },
    "candidateManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "targetFingerprint", "configuration", "definition", "generator", "outputs"],
      "properties": {
        "host": { "$ref": "#/$defs/id" },
        "targetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "configuration": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "lockFingerprint", "graphFingerprint"],
          "properties": {
            "name": { "$ref": "#/$defs/id" },
            "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
            "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        "definition": { "$ref": "#/$defs/versionedReference" },
        "generator": { "$ref": "#/$defs/versionedReference" },
        "outputs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "path", "role", "mode", "contentFingerprint", "fingerprint"],
            "properties": {
              "id": { "type": "string" },
              "path": { "type": "string" },
              "role": { "enum": ["instructions", "skills", "tools", "lifecycle", "configuration"] },
              "mode": { "const": "0644" },
              "contentFingerprint": { "$ref": "#/$defs/fingerprint" },
              "fingerprint": { "$ref": "#/$defs/fingerprint" }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sequence", "action", "path", "role", "before", "after", "template"],
        "properties": {
          "id": { "type": "string", "pattern": "^output[.][a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "sequence": { "type": "integer", "minimum": 0 },
          "action": { "enum": ["create", "replace", "remove"] },
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["instructions", "skills", "tools", "lifecycle", "configuration"] },
          "before": { "$ref": "#/$defs/fileSnapshot" },
          "after": { "$ref": "#/$defs/fileSnapshot" },
          "template": {
            "oneOf": [
              { "const": null },
              {
                "type": "object", "additionalProperties": false,
                "required": ["path", "fingerprint"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "fingerprint": { "$ref": "#/$defs/fingerprint" }
                }
              }
            ]
          }
        }
      }
    },
    "scopeFingerprint": { "$ref": "#/$defs/fingerprint" },
    "planFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "time": { "type": "string", "minLength": 20 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "versionedReference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "fingerprint"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "fileSnapshot": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "content", "mode", "contentFingerprint", "fingerprint"],
          "properties": {
            "state": { "const": "absent" },
            "content": { "const": null },
            "mode": { "const": null },
            "contentFingerprint": { "const": null },
            "fingerprint": { "const": null }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "content", "mode", "contentFingerprint", "fingerprint"],
          "properties": {
            "state": { "const": "present" },
            "content": { "type": "string" },
            "mode": { "const": "0644" },
            "contentFingerprint": { "$ref": "#/$defs/fingerprint" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        }
      ]
    },
    "manifestSnapshot": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["path", "state", "fingerprint", "document"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "state": { "const": "absent" },
            "fingerprint": { "const": null },
            "document": { "const": null }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["path", "state", "fingerprint", "document"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "state": { "const": "present" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "document": { "type": "object" }
          }
        }
      ]
    }
  }
}
