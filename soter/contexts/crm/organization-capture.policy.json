    { "terms": ["facilitator", "facilitation team"], "value": "Facilitator Team" },
    { "terms": ["governance operations", "govops"], "value": "GovOps" },
    { "terms": ["prime agent"], "value": "Prime Agent" },
    { "terms": ["halo agent"], "value": "Halo Agent" },
    { "terms": ["executor agent"], "value": "Executor Agent" },
    { "terms": ["core developer", "core devs"], "value": "Core Devs" },
    { "terms": ["ecosystem actor", "ecosystem program", "grants program"], "value": "Ecosystem Actor" }
  ],
  "tagRules": [
    { "terms": ["defi", "decentralized finance"], "value": "DeFi" },
    { "terms": ["l2", "layer 2", "rollup"], "value": "L2" },
    { "terms": ["grant", "grants"], "value": "Grants" }
  ],
  "relationsOnCreate": "empty"
