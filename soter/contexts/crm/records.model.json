{
  "$contract": "soter://contracts/context-record-model/v1",
  "contractVersion": "1.0.0",
  "id": "model.context.crm.records",
  "pack": "context.crm",
  "version": "0.1.0",
  "subject": "crm.records",
  "recordTypes": [
    {
      "id": "organization-capture-policy",
      "summary": "An external selection record that binds one governed organization-capture definition.",
      "fields": [
        {
          "id": "name",
          "type": "string",
          "requiredOnCreate": true,
          "nullable": false,
          "mutable": true,
          "summary": "The exact human-readable organization policy title."
        }
      ],
      "content": {
        "kind": "none",
        "requiredOnCreate": false,
        "summary": "The exact governed rules live in the selected Context definition artifact."
      },
      "deduplicationFields": [
        "name"
      ]
    },
    {
      "id": "contact-capture-policy",
      "summary": "An external selection record that binds one governed contact-capture definition.",
      "fields": [
        {
          "id": "name",
          "type": "string",
          "requiredOnCreate": true,
          "nullable": false,
          "mutable": true,
          "summary": "The exact human-readable contact policy title."
        }
      ],
      "content": {
        "kind": "none",
        "requiredOnCreate": false,
        "summary": "The exact governed rules live in the selected Context definition artifact."
      },
      "deduplicationFields": [
        "name"
      ]
    },
    {
      "id": "organization",
      "summary": "An organization participating in CRM relationships and work.",
      "fields": [
        {
          "id": "name",
          "type": "string",
          "requiredOnCreate": true,
          "nullable": false,
          "mutable": true,
          "summary": "The organization display name."
        },
        {
          "id": "organizationType",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "The configured organization classification."
        },
        {
          "id": "status",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "The portable organization lifecycle state."
        },
        {
          "id": "tags",
          "type": "string-list",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "Portable organization classification tags."
        },
        {
          "id": "website",
          "type": "string",
          "format": "resource-uri",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "The normalized canonical organization website."
        },
        {
          "id": "twitter",
          "type": "string",
          "format": "resource-uri",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "The normalized organization social profile URI."
        },
        {
          "id": "projectUris",
          "type": "string-list",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "Exact related project resource identities.",
          "reference": {
            "subject": "projects.records.project",
            "identity": "resource-uri"
          }
        },
        {
          "id": "contactUris",
          "type": "string-list",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "Exact related contact resource identities.",
          "reference": {
            "subject": "crm.records.person",
            "identity": "resource-uri"
          }
        }
      ],
      "content": {
        "kind": "none",
        "requiredOnCreate": false,
        "summary": "Organization records have no portable body content."
      },
      "deduplicationFields": [
        "name"
      ]
    },
    {
      "id": "person",
      "summary": "A CRM contact whose authority and relationships remain explicit.",
      "fields": [
        {
          "id": "name",
          "type": "string",
          "requiredOnCreate": true,
          "nullable": false,
          "mutable": true,
          "summary": "The contact display name."
        },
        {
          "id": "email",
          "type": "string",
          "format": "email",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "The contact email address when known."
        },
        {
          "id": "role",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "The contact role classification."
        },
        {
          "id": "status",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "The contact lifecycle state."
        },
        {
          "id": "disposition",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "The configured relationship disposition."
        },
        {
          "id": "authority",
          "type": "string-list",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "Explicit authority labels assigned to this contact."
        },
        {
          "id": "tags",
          "type": "string-list",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "Current provider-defined contact classification tags."
        },
        {
          "id": "telegram",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "A bounded Telegram contact identity when explicitly supplied."
        },
        {
          "id": "signal",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "A bounded Signal contact identity when explicitly supplied."
        },
        {
          "id": "discordId",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "A bounded Discord identity when explicitly supplied."
        },
        {
          "id": "github",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "A bounded GitHub identity when explicitly supplied."
        },
        {
          "id": "timezoneUtc",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "Explicit timezone text; Context does not infer it from location or address."
        },
        {
          "id": "source",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "A factual bounded description of how the contact was encountered."
        },
        {
          "id": "skyForum",
          "type": "string",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "A bounded Sky Forum identity when explicitly supplied."
        },
        {
          "id": "scheduleAppointment",
          "type": "string",
          "format": "resource-uri",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "An explicit appointment-scheduling resource URI."
        },
        {
          "id": "organizationUris",
          "type": "string-list",
          "requiredOnCreate": false,
          "nullable": true,
          "mutable": true,
          "summary": "Exact related organization resource identities.",
          "reference": {
            "subject": "crm.records.organization",
            "identity": "resource-uri"
          }
        }
      ],
      "content": {
        "kind": "none",
        "requiredOnCreate": false,
        "summary": "Contact records have no portable body content."
      },
      "deduplicationFields": [
        "email",
        "name"
      ]
    }
  ],
  "limitations": [
    "The governed context.crm vocabulary artifact owns portable CRM terminology; compatibility pointers and provider labels are non-canonical projections.",
    "This model owns portable organizations, people, customer relationships, and CRM identity only; Communications, Projects, Tasks, and Meetings are separate selectable Context packs.",
    "Cross-context project links are typed resource identities; selecting CRM alone does not require or imply that the Projects Context is installed or resolved.",
    "Provider-scoped workspace actor identities are not CRM contact identities without a separate governed resolution contract.",
    "Policy bodies remain external canonical sources and are not embedded in CRM records."
  ]
}
