{
  "$contract": "soter://contexts/projects/project-work-policy/v1",
  "contractVersion": "1.0.0",
  "id": "policy.context.projects.project-work",
  "name": "Projects",
  "progressRequiresPromotedTasks": true,
  "milestoneWorkItemsRemainDistinct": true,
  "healthMustBeOperatorJudgment": true,
  "writesRequireConfirmation": true,
  "updateCategory": "Status",
  "defaultProcessed": false,
  "allowedUpdateCategories": ["Update", "Status", "Decision", "Question", "Milestone"],
  "allowedVisibilities": ["Internal", "Agent", "Public"],
  "duplicateCandidateLimit": 2,
  "doneTaskStatuses": ["done", "closed"],
  "blockedTaskStatuses": ["blocked"],
  "notStartedTaskStatuses": ["backlog", "to-do", "open"],
  "allowedProgressStates": ["todo", "in-progress", "done"],
  "allowedHealthStates": ["on-track", "at-risk", "off-track"],
  "milestoneSyntaxVersion": "project-milestone-line/v1",
  "workItemSyntaxVersion": "dated-owner-action-line/v1",
  "milestoneProgressRule": "promoted-task-state-with-human-completion",
  "promotionBoundary": "tracked-execution-only",
  "coordinationDisposition": "complete-in-place",
  "promotionTaskContext": "Project",
  "promotionMarksTrackedWorkComplete": false,
  "decisionCategory": "Decision",
  "questionCategory": "Question",
  "decisionSummaryGrammar": "what-decided-by-why/v1",
  "questionSummaryGrammar": "question-owner-needed-by/v1",
  "missingDecisionWhyMarker": "[why not supplied]",
  "decisionResolutionRequiresQuestion": true,
  "decisionResolutionRequiresWorkItem": true
}
