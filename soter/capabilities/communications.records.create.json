{
  "$contract": "soter://contracts/capability/v1",
  "contractVersion": "1.0.0",
  "id": "communications.records.create",
  "version": "1.0.0",
  "purpose": "Creates one typed Communications directory record through the selected provider using a required deduplication key and explicit effect evidence.",
  "portability": "portable",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["recordType", "deduplicationKey", "fields"],
    "properties": {
      "recordType": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
      "deduplicationKey": { "type": "string", "minLength": 1 },
      "deduplicationFilter": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      },
      "fields": { "type": "object" },
      "body": { "type": ["string", "object", "null"] }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["record", "created", "provenance", "observedAt"],
    "properties": {
      "record": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "fields"],
        "properties": {
          "type": { "type": "string" },
          "id": { "type": "string" },
          "fields": { "type": "object" },
          "version": { "type": "string", "minLength": 1 },
          "deduplicationKey": { "type": "string", "minLength": 1 },
          "body": { "type": ["string", "object", "null"] }
        }
      },
      "created": { "type": "boolean" },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "authority", "mapping", "mappingVersion"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 },
          "mapping": { "type": "string", "minLength": 1 },
          "mappingVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "sourceKind": { "enum": ["fixture", "connected"] },
          "sourceReferenceFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "observedAt": { "type": "string", "minLength": 20 }
    }
  },
  "authentication": { "required": true, "minimumScopes": ["records:write"] },
  "effects": ["write"],
  "idempotency": { "mode": "conditional", "key": "deduplicationKey" },
  "retry": { "safe": false, "maxAttempts": 0, "checkpoint": "Ambiguous creates require exact read-only reconciliation by provider identity fingerprint; never retry the create automatically." },
  "errors": ["authentication", "authorization", "validation", "conflict", "rate-limit", "unavailable", "retryable", "not-found", "unknown"],
  "freshness": { "returnsProvenance": true, "returnsObservedAt": true, "maxAgeSeconds": null },
  "health": {
    "check": "Validate one contained Communications record create and exact deduplication replay.",
    "fixture": "soter/fixtures/providers/notion/workspace-records.json",
    "containedVerification": "Prove one create, immutable identity fields, replay safety, normalized conflicts, and read-after-write evidence."
  },
  "providerLimitations": [
    "Create is not exposed through preparation; it requires the existing exact batch, approval, single-use start, checkpoint, and verification authority chain."
  ]
}
