{
  "$contract": "soter://contracts/capability/v1",
  "contractVersion": "1.0.0",
  "id": "meetings.schema.read",
  "version": "1.0.0",
  "purpose": "Reads one exact provider-neutral record-schema observation, including current writable choice values, without exposing provider target identities or raw schema payloads.",
  "portability": "portable",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "recordType"
    ],
    "properties": {
      "recordType": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "provenance",
      "observedAt"
    ],
    "properties": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordType",
          "fields",
          "fingerprint"
        ],
        "properties": {
          "recordType": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "writable",
                "options"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9]*$"
                },
                "writable": {
                  "type": "boolean"
                },
                "options": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    }
                  ]
                }
              }
            }
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "authority",
          "mapping",
          "mappingVersion",
          "sourceKind",
          "sourceReferenceFingerprint"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "mapping": {
            "type": "string",
            "minLength": 1
          },
          "mappingVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "sourceKind": {
            "enum": [
              "fixture",
              "connected"
            ]
          },
          "sourceReferenceFingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "observedAt": {
        "type": "string",
        "minLength": 20
      }
    }
  },
  "authentication": {
    "required": true,
    "minimumScopes": [
      "records:read"
    ]
  },
  "effects": [
    "read",
    "disclosure"
  ],
  "idempotency": {
    "mode": "not-applicable",
    "key": null
  },
  "retry": {
    "safe": true,
    "maxAttempts": 2,
    "checkpoint": "Persist the exact record type and normalized schema fingerprint before retry."
  },
  "errors": [
    "authentication",
    "authorization",
    "validation",
    "conflict",
    "rate-limit",
    "unavailable",
    "retryable",
    "not-found",
    "unknown"
  ],
  "freshness": {
    "returnsProvenance": true,
    "returnsObservedAt": true,
    "maxAgeSeconds": 300
  },
  "health": {
    "check": "Read one contained normalized schema and prove choice values and provider identities cannot escape the portable result.",
    "fixture": "soter/fixtures/providers/notion/workspace-records.json",
    "containedVerification": "Prove exact record-type binding, closed fields, stable choice ordering, and current schema fingerprinting."
  },
  "providerLimitations": [
    "A normalized schema observation establishes only the mapped fields and choice values returned at one time; it does not establish future provider compatibility, write permission, or workflow readiness."
  ]
}
