{
  "$contract": "soter://contracts/capability/v1",
  "contractVersion": "1.0.0",
  "id": "communications.thread.read",
  "version": "1.0.0",
  "purpose": "Reads one complete bounded conversation thread by an exact explicitly selected root identity, whether or not that root falls inside a separate conversation window.",
  "portability": "portable",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["selectionMode", "workspaceId", "conversationId", "rootMessageId", "maximumMessages"],
    "properties": {
      "selectionMode": { "const": "explicit-root" },
      "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
      "conversationId": { "type": "string", "minLength": 1, "maxLength": 200 },
      "rootMessageId": { "type": "string", "minLength": 1, "maxLength": 200 },
      "maximumMessages": { "type": "integer", "minimum": 1, "maximum": 1000 }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["workspaceId", "conversationId", "rootMessageId", "messages", "coverage", "provenance", "observedAt"],
    "properties": {
      "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
      "conversationId": { "type": "string", "minLength": 1, "maxLength": 200 },
      "rootMessageId": { "type": "string", "minLength": 1, "maxLength": 200 },
      "messages": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["providerMessageId", "authorParticipantId", "sentAt", "isRoot", "content", "contentFingerprint", "fingerprint"],
          "properties": {
            "providerMessageId": { "type": "string", "minLength": 1, "maxLength": 200 },
            "authorParticipantId": { "type": ["string", "null"], "minLength": 1, "maxLength": 300 },
            "sentAt": { "type": "string", "minLength": 20, "maxLength": 40 },
            "isRoot": { "type": "boolean" },
            "content": { "type": "string", "maxLength": 100000 },
            "contentFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        }
      },
      "coverage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["complete", "cursorExhausted", "pagesRead", "observedCount", "includedCount"],
        "properties": {
          "complete": { "const": true },
          "cursorExhausted": { "const": true },
          "pagesRead": { "type": "integer", "minimum": 1 },
          "observedCount": { "type": "integer", "minimum": 1 },
          "includedCount": { "type": "integer", "minimum": 1 }
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "authority", "sourceKind", "sourceReferenceFingerprint"],
        "properties": {
          "provider": { "type": "string", "minLength": 3 },
          "authority": { "type": "string", "minLength": 3 },
          "sourceKind": { "enum": ["fixture", "connected"] },
          "sourceReferenceFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "observedAt": { "type": "string", "minLength": 20 }
    }
  },
  "authentication": { "required": true, "minimumScopes": ["messages:read"] },
  "effects": ["read", "disclosure"],
  "idempotency": { "mode": "not-applicable", "key": null },
  "retry": { "safe": true, "maxAttempts": 2, "checkpoint": "Persist the exact root and complete normalized thread fingerprint before retry." },
  "errors": ["authentication", "authorization", "validation", "conflict", "rate-limit", "unavailable", "retryable", "not-found", "unknown"],
  "freshness": { "returnsProvenance": true, "returnsObservedAt": true, "maxAgeSeconds": 300 },
  "health": {
    "check": "Read one complete bounded contained exact thread.",
    "fixture": "soter/fixtures/providers/slack/workspace.json",
    "containedVerification": "Prove exact root binding, complete pagination, unique message identities, bounded content, and structural privacy."
  },
  "providerLimitations": [
    "A thread read is permitted only for an exact selected root; the Integration does not choose which threads matter.",
    "The exact root identity and complete-thread message bound are the only thread scope; an explicitly selected root is not silently constrained to a separate conversation window.",
    "Normalized content remains private untrusted data and continuation cursors remain private to Core's bounded page checkpoint."
  ]
}
