{
  "$contract": "soter://contracts/capability/v1",
  "contractVersion": "1.0.0",
  "id": "meeting.transcript.read",
  "version": "1.0.0",
  "purpose": "Reads one meeting transcript from its configured provider and returns normalized speakers, segments, provenance, and freshness.",
  "portability": "portable",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["meetingId", "recordingUri"],
    "properties": {
      "meetingId": { "type": "string" },
      "recordingUri": { "type": "string" }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["meetingId", "recordingUri", "speakers", "segments", "provenance", "observedAt"],
    "properties": {
      "meetingId": { "type": "string" },
      "recordingUri": { "type": "string" },
      "speakers": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "displayName"],
          "properties": {
            "id": { "type": "string" },
            "displayName": { "type": "string" }
          }
        }
      },
      "segments": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["speakerId", "text", "startSeconds"],
          "properties": {
            "speakerId": { "type": "string" },
            "text": { "type": "string" },
            "startSeconds": { "type": "number" }
          }
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "authority", "sourceKind", "sourceReferenceFingerprint"],
        "properties": {
          "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
          "authority": { "type": "string", "minLength": 1, "maxLength": 500 },
          "sourceKind": { "enum": ["fixture", "connected"] },
          "sourceReferenceFingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "observedAt": { "type": "string" }
    }
  },
  "authentication": {
    "required": true,
    "minimumScopes": ["transcripts:read"]
  },
  "effects": ["read", "disclosure"],
  "idempotency": {
    "mode": "not-applicable",
    "key": null
  },
  "retry": {
    "safe": true,
    "maxAttempts": 3,
    "checkpoint": null
  },
  "errors": [
    "authentication",
    "authorization",
    "validation",
    "conflict",
    "rate-limit",
    "unavailable",
    "retryable",
    "not-found",
    "unknown"
  ],
  "freshness": {
    "returnsProvenance": true,
    "returnsObservedAt": true,
    "maxAgeSeconds": 300
  },
  "health": {
    "check": "Read a contained transcript fixture through the selected provider binding.",
    "fixture": "soter/scenarios/meeting-intake/happy-path.scenario.json",
    "containedVerification": "Prove speaker and segment normalization, provenance, missing-transcript behavior, and typed errors."
  },
  "providerLimitations": [
    "Provider calendar_participants data is excluded from portable output because observed name-to-email pairings are not reliable identity evidence.",
    "Provider action_items data is excluded from portable output and cannot ground summaries, commitments, tasks, or other proposed actions; only exact normalized transcript segments may do so."
  ]
}
