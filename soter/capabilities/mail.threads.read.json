{
  "$contract": "soter://contracts/capability/v1",
  "contractVersion": "1.0.0",
  "id": "mail.threads.read",
  "version": "2.0.0",
  "purpose": "Expands exact provider message IDs into bounded provider-neutral threads, distinguishes exact-request messages from contextual siblings, and returns RFC822 identity only for the exact requested window without classifying mail content.",
  "portability": "portable",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "messageIds", "maximumThreads", "maximumMessagesPerThread", "maximumTotalMessages"
    ],
    "properties": {
      "messageIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "maximumThreads": { "type": "integer", "minimum": 1, "maximum": 100 },
      "maximumMessagesPerThread": { "type": "integer", "minimum": 1, "maximum": 500 },
      "maximumTotalMessages": { "type": "integer", "minimum": 1, "maximum": 500 }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "requestedMessageIds", "returnedThreadCount", "returnedMessageCount", "threads",
      "provenance", "observedAt"
    ],
    "properties": {
      "requestedMessageIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "returnedThreadCount": { "type": "integer", "minimum": 1, "maximum": 100 },
      "returnedMessageCount": { "type": "integer", "minimum": 1, "maximum": 500 },
      "threads": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "messages"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 500 },
            "messages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": { "$ref": "#/$defs/message" }
            }
          }
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "authority", "sourceKind", "sourceReferenceFingerprint"],
        "properties": {
          "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
          "authority": { "type": "string", "minLength": 1, "maxLength": 500 },
          "sourceKind": { "enum": ["fixture", "connected"] },
          "sourceReferenceFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "observedAt": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
      }
    },
    "$defs": {
    "messageFields": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "from": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "to": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "sentAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
        },
        "labels": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "subject": { "type": "string", "maxLength": 10000 },
        "body": { "type": "string", "maxLength": 1000000 }
      }
    },
    "message": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "membership", "rfc822MessageId", "from", "to", "sentAt", "labels",
            "subject", "body"
          ],
          "properties": {
            "id": { "$ref": "#/$defs/messageFields/properties/id" },
            "membership": { "const": "exact-request" },
            "rfc822MessageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "from": { "$ref": "#/$defs/messageFields/properties/from" },
            "to": { "$ref": "#/$defs/messageFields/properties/to" },
            "sentAt": { "$ref": "#/$defs/messageFields/properties/sentAt" },
            "labels": { "$ref": "#/$defs/messageFields/properties/labels" },
            "subject": { "$ref": "#/$defs/messageFields/properties/subject" },
            "body": { "$ref": "#/$defs/messageFields/properties/body" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "membership", "rfc822MessageId", "from", "to", "sentAt", "labels",
            "subject", "body"
          ],
          "properties": {
            "id": { "$ref": "#/$defs/messageFields/properties/id" },
            "membership": { "const": "thread-context" },
            "rfc822MessageId": { "type": "null" },
            "from": { "$ref": "#/$defs/messageFields/properties/from" },
            "to": { "$ref": "#/$defs/messageFields/properties/to" },
            "sentAt": { "$ref": "#/$defs/messageFields/properties/sentAt" },
            "labels": { "$ref": "#/$defs/messageFields/properties/labels" },
            "subject": { "$ref": "#/$defs/messageFields/properties/subject" },
            "body": { "$ref": "#/$defs/messageFields/properties/body" }
          }
        }
      ]
    }
    }
  },
  "authentication": { "required": true, "minimumScopes": ["mail:read"] },
  "effects": ["read", "disclosure"],
  "idempotency": { "mode": "not-applicable", "key": null },
  "retry": { "safe": true, "maxAttempts": 3, "checkpoint": null },
  "errors": [
    "authentication", "authorization", "validation", "conflict", "rate-limit",
    "unavailable", "retryable", "not-found", "unknown"
  ],
  "freshness": { "returnsProvenance": true, "returnsObservedAt": true, "maxAgeSeconds": 300 },
  "health": {
    "check": "Expand exact provider-message identities into bounded private normalized threads while keeping exact-request membership distinct from contextual siblings.",
    "fixture": "soter/scenarios/email-triage/happy-path.scenario.json",
    "containedVerification": "Prove exact requested-message coverage, provider thread/message/RFC822 identity separation, explicit contextual-sibling membership, per-thread and total bounds, and raw response minimization."
  },
  "providerLimitations": [
    "Thread content remains private connected Context data and cannot enter workspace inspection, evidence, diagnostics, canonical fixtures, or general renderer state.",
    "RFC822 identity is returned only for exact-request messages. Contextual siblings remain private thread context with a structurally null RFC822 identity and cannot silently widen the bounded mailbox window.",
    "Integration returns transport facts only. It must not classify importance, reply need, prompt injection, handoffs, or proposed actions."
  ]
}
