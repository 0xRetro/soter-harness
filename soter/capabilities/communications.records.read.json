{
  "$contract": "soter://contracts/capability/v1",
  "contractVersion": "1.0.0",
  "id": "communications.records.read",
  "version": "1.0.0",
  "purpose": "Reads typed Communications directory and policy records from the configured instance authority with normalized provenance and freshness.",
  "portability": "portable",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["recordTypes"],
    "properties": {
      "recordTypes": {
        "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
      },
      "ids": {
        "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "filters": {
        "type": "object",
        "additionalProperties": { "type": ["string", "number", "boolean"] }
      },
      "filtersAny": {
        "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
        "items": {
          "type": "object", "minProperties": 1,
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      },
      "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["records", "provenance", "observedAt"],
    "properties": {
      "records": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "version", "fields", "identityBinding"],
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "version": { "type": "string" },
            "fields": { "type": "object" },
            "body": { "type": ["string", "object", "null"] },
            "identityBinding": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["state", "requestedIdFingerprint"],
                  "properties": {
                    "state": { "const": "exact-request" },
                    "requestedIdFingerprint": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["state", "requestedIdFingerprint"],
                  "properties": {
                    "state": { "const": "observed" },
                    "requestedIdFingerprint": { "type": "null" }
                  }
                }
              ]
            }
          }
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "authority", "mapping", "mappingVersion", "sourceKind", "sourceReferenceFingerprint"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 },
          "mapping": { "type": "string", "minLength": 1 },
          "mappingVersion": { "type": "string", "minLength": 1 },
          "sourceKind": { "enum": ["fixture", "connected"] },
          "sourceReferenceFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "observedAt": { "type": "string", "minLength": 20 }
    }
  },
  "authentication": { "required": true, "minimumScopes": ["records:read"] },
  "effects": ["read", "disclosure"],
  "idempotency": { "mode": "not-applicable", "key": null },
  "retry": { "safe": true, "maxAttempts": 3, "checkpoint": null },
  "errors": ["authentication", "authorization", "validation", "conflict", "rate-limit", "unavailable", "retryable", "not-found", "unknown"],
  "freshness": { "returnsProvenance": true, "returnsObservedAt": true, "maxAgeSeconds": 300 },
  "health": {
    "check": "Read contained Communications records through the selected provider mapping.",
    "fixture": "soter/fixtures/providers/notion/workspace-records.json",
    "containedVerification": "Prove exact record-type filtering, normalized fields, provenance, and not-found behavior."
  },
  "providerLimitations": [
    "Communication records contain directory identities and typed CRM resource links only; message content is not representable in this record capability."
  ]
}
