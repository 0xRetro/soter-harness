{
  "$contract": "soter://contracts/capability/v1",
  "contractVersion": "1.0.0",
  "id": "communications.records.update",
  "version": "1.0.0",
  "purpose": "Updates mutable fields on one typed Communications directory record through an expected-version precondition and explicit verification evidence.",
  "portability": "portable",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["recordType", "id", "expectedVersion", "patch"],
    "properties": {
      "recordType": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
      "id": { "type": "string", "minLength": 1 },
      "expectedVersion": { "type": "string", "minLength": 1 },
      "patch": { "type": "object", "minProperties": 1 }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["record", "changedFields", "provenance", "observedAt"],
    "properties": {
      "record": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "fields"],
        "properties": {
          "type": { "type": "string" },
          "id": { "type": "string" },
          "fields": { "type": "object" },
          "version": { "type": "string", "minLength": 1 },
          "deduplicationKey": { "type": "string", "minLength": 1 },
          "body": { "type": ["string", "object", "null"] }
        }
      },
      "changedFields": {
        "type": "array", "minItems": 1, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "authority", "mapping", "mappingVersion"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 },
          "mapping": { "type": "string", "minLength": 1 },
          "mappingVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "sourceKind": { "enum": ["fixture", "connected"] },
          "sourceReferenceFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "observedAt": { "type": "string", "minLength": 20 }
    }
  },
  "authentication": { "required": true, "minimumScopes": ["records:write"] },
  "effects": ["write"],
  "idempotency": { "mode": "conditional", "key": "recordType + id + expectedVersion + patch" },
  "retry": { "safe": false, "maxAttempts": 0, "checkpoint": "Ambiguous updates require exact read-only reconciliation; never retry the write automatically." },
  "errors": ["authentication", "authorization", "validation", "conflict", "rate-limit", "unavailable", "retryable", "not-found", "unknown"],
  "freshness": { "returnsProvenance": true, "returnsObservedAt": true, "maxAgeSeconds": null },
  "health": {
    "check": "Validate one contained expected-version Communications record update.",
    "fixture": "soter/fixtures/providers/notion/workspace-records.json",
    "containedVerification": "Prove immutable identity preservation, named-field updates, version conflicts, and exact read-after-write evidence."
  },
  "providerLimitations": [
    "Platform, workspace, conversation, and provider-identity fingerprint fields are immutable after create and cannot enter an update mapping."
  ]
}
