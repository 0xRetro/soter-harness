{
  "$contract": "soter://contracts/capability/v1",
  "contractVersion": "1.0.0",
  "id": "projects.records.update",
  "version": "1.1.0",
  "purpose": "Updates one exact non-empty portable Project patch through an expected-version precondition and explicit effect evidence.",
  "portability": "portable",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["recordType", "id", "expectedVersion", "patch"],
    "properties": {
      "recordType": { "enum": ["project", "project-feed-entry"] },
      "id": { "type": "string", "minLength": 1 },
      "expectedVersion": { "type": "string", "minLength": 1 },
      "patch": {}
    },
    "oneOf": [
      {
        "properties": {
          "recordType": { "const": "project" },
          "patch": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "maxProperties": 2,
            "properties": {
              "projectType": { "type": ["string", "null"], "minLength": 1 },
              "status": { "type": ["string", "null"], "minLength": 1 }
            }
          }
        }
      },
      {
        "properties": {
          "recordType": { "const": "project-feed-entry" },
          "patch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["processed"],
            "properties": {
              "processed": { "type": "boolean" }
            }
          }
        }
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "record",
      "changedFields",
      "provenance",
      "observedAt"
    ],
    "properties": {
      "record": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "fields"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "fields": {
            "type": "object"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "deduplicationKey": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": ["string", "object", "null"]
          }
        }
      },
      "changedFields": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "authority", "mapping", "mappingVersion"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 },
          "mapping": { "type": "string", "minLength": 1 },
          "mappingVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "sourceKind": { "enum": ["fixture", "connected"] },
          "sourceReferenceFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "observedAt": {
        "type": "string"
      }
    }
  },
  "authentication": {
    "required": true,
    "minimumScopes": [
      "records:write"
    ]
  },
  "effects": [
    "write"
  ],
  "idempotency": {
    "mode": "conditional",
    "key": "recordType + id + expectedVersion + patch"
  },
  "retry": {
    "safe": false,
    "maxAttempts": 0,
    "checkpoint": "Ambiguous Project updates require exact read-only checkpoint reconciliation; never retry the write automatically."
  },
  "errors": [
    "authentication",
    "authorization",
    "validation",
    "conflict",
    "rate-limit",
    "unavailable",
    "retryable",
    "not-found",
    "unknown"
  ],
  "freshness": {
    "returnsProvenance": true,
    "returnsObservedAt": true,
    "maxAgeSeconds": null
  },
  "health": {
    "check": "Validate contained expected-version Project and project-feed-entry updates against a fixture store.",
    "fixture": "soter/fixtures/providers/notion/workspace-records.json",
    "containedVerification": "Prove exact non-empty patch scope, untouched-field preservation, version conflicts, no automatic retry, and returned effect evidence."
  },
  "providerLimitations": [
    "Project updates are limited to projectType and status; name, relations, dates, page content, and structural edits require separate governed workflows.",
    "Project feed-entry updates remain limited to the processed flag."
  ]
}
