  "health": { "check": "Create one contained document-index record with deduplicated replay.", "fixture": "soter/fixtures/providers/notion/documents.json", "containedVerification": "Prove one create, exact fields, replay safety, and returned effect evidence." },
  "providerLimitations": ["This capability does not create, copy, move, rename, delete, or verify the underlying stored artifact."]
