{
  "$contract": "soter://contracts/capability/v1",
  "contractVersion": "1.0.0",
  "id": "mail.labels.read",
  "version": "2.0.0",
  "purpose": "Reads exact mail messages and returns only the requested exact label names for post-write verification and ambiguity reconciliation.",
  "portability": "portable",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["messageIds", "labelNames", "maximumMessages"],
    "properties": {
      "messageIds": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
      "labelNames": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^AI/", "maxLength": 500 } },
      "maximumMessages": { "type": "integer", "minimum": 1, "maximum": 100 }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["messages", "provenance", "observedAt"],
    "properties": {
      "messages": {
        "type": "array", "maxItems": 100,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["messageId", "labelNames"],
          "properties": {
            "messageId": { "type": "string", "minLength": 1, "maxLength": 500 },
            "labelNames": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^AI/", "maxLength": 500 } }
          }
        }
      },
      "provenance": {
        "type": "object", "additionalProperties": false,
        "required": ["provider", "authority", "sourceKind", "sourceReferenceFingerprint"],
        "properties": {
          "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
          "authority": { "type": "string", "minLength": 1, "maxLength": 500 },
          "sourceKind": { "enum": ["fixture", "connected"] },
          "sourceReferenceFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "observedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
      "coverage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "complete",
          "cursorExhausted",
          "pagesRead",
          "observedCount",
          "includedCount",
          "excludedCount"
        ],
        "properties": {
          "complete": { "const": true },
          "cursorExhausted": { "const": true },
          "pagesRead": { "type": "integer", "minimum": 1, "maximum": 100 },
          "observedCount": { "type": "integer", "minimum": 0, "maximum": 100 },
          "includedCount": { "type": "integer", "minimum": 0, "maximum": 100 },
          "excludedCount": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  },
  "authentication": { "required": true, "minimumScopes": ["mail:read"] },
  "effects": ["read", "disclosure"],
  "idempotency": { "mode": "idempotent", "key": "messageIds+labelNames" },
  "retry": { "safe": true, "maxAttempts": 2, "checkpoint": "The exact message identities and label names remain unchanged." },
  "errors": ["authentication", "authorization", "validation", "conflict", "rate-limit", "unavailable", "retryable", "not-found", "unknown"],
  "freshness": { "returnsProvenance": true, "returnsObservedAt": true, "maxAgeSeconds": 60 },
  "health": {
    "check": "Read-only exact-label verification may be probed only under an authorized connected mailbox.",
    "fixture": "soter/scenarios/email-triage/happy-path.scenario.json",
    "containedVerification": "Fixture verification proves exact message-ID and label-name matching only."
  },
  "providerLimitations": [
    "Verification must read the exact message identities and configured label names; provider importance or category fields are not substitutes."
  ]
}
