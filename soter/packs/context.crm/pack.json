{
  "$contract": "soter://contracts/pack/v1",
  "contractVersion": "1.0.0",
  "id": "context.crm",
  "version": "0.1.0",
  "layer": "context",
  "releaseStage": "experimental",
  "evidenceMaturity": "declared",
  "summary": "Defines portable CRM organizations, people, customer relationships, and CRM identity without owning communications, Projects, Tasks, or Meetings.",
  "dependencies": [
    {
      "pack": "core.runtime",
      "version": "^0.1.0",
      "optional": false,
      "reason": "CRM definitions and instances require portable context assembly and authority resolution."
    }
  ],
  "capabilities": {
    "requires": [],
    "provides": []
  },
  "authorities": [
    { "role": "definition", "subject": "crm.records", "required": true },
    { "role": "instance", "subject": "crm.records", "required": true }
  ],
  "effects": [],
  "artifacts": [
    {
      "path": "soter/contexts/crm/records.model.json",
      "role": "definition"
    },
    {
      "path": "soter/contexts/crm/vocabulary.json",
      "role": "definition"
    },
    {
      "path": "soter/contracts/organization-capture-policy.schema.json",
      "role": "definition"
    },
    {
      "path": "soter/contexts/crm/organization-capture.policy.json",
      "role": "definition"
    },
    {
      "path": "soter/contracts/contact-capture-policy.schema.json",
      "role": "definition"
    },
    {
      "path": "soter/contexts/crm/contact-capture.policy.json",
      "role": "definition"
    }
  ],
  "compatibility": {
    "baseContract": "^1.0.0",
    "hosts": ["codex", "claude"]
  },
  "verification": {
    "maxLevel": "static",
    "scenarios": []
  }
}
