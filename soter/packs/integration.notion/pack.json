{
  "$contract": "soter://contracts/pack/v1",
  "contractVersion": "1.0.0",
  "id": "integration.notion",
  "version": "0.4.0",
  "layer": "integration",
  "releaseStage": "experimental",
  "evidenceMaturity": "declared",
  "summary": "Implements explicitly mapped portable Context record capabilities through a configured Notion workspace.",
  "dependencies": [
    {
      "pack": "core.runtime",
      "version": "^0.1.0",
      "optional": false,
      "reason": "Integration binding, effect policy, evidence, and health are supplied by Core."
    },
    {
      "pack": "context.crm",
      "version": "^0.1.0",
      "optional": true,
      "reason": "When selected, Notion maps provider fields into the canonical portable CRM record model without requiring CRM in unrelated configurations."
    },
    {
      "pack": "context.communications.collaboration",
      "version": "^0.1.0",
      "optional": true,
      "reason": "When selected, Notion maps the portable Communications channel directory and policies without making provider layout or CRM responsible for communication meaning."
    },
    {
      "pack": "context.product",
      "version": "^0.1.0",
      "optional": true,
      "reason": "When selected, Notion maps one exact configured feature board into portable Product records without requiring Product in unrelated configurations."
    },
    {
      "pack": "context.process",
      "version": "^0.1.0",
      "optional": true,
      "reason": "When selected, Notion maps explicit process, role, service, run, and policy targets into portable Process records."
    },
    {
      "pack": "context.projects",
      "version": "^0.1.0",
      "optional": true,
      "reason": "When selected, Notion maps configured project databases into portable Project records without requiring Projects in unrelated configurations."
    },
    {
      "pack": "context.tasks",
      "version": "^0.1.0",
      "optional": true,
      "reason": "When selected, Notion maps configured task databases into portable Task records without requiring Tasks in unrelated configurations."
    },
    {
      "pack": "context.meetings",
      "version": "^0.1.0",
      "optional": true,
      "reason": "When selected, Notion maps configured meeting and summary databases into portable Meeting records without requiring Meetings in unrelated configurations."
    }
  ],
