{
  "$contract": "soter://contracts/scenario/v1",
  "contractVersion": "1.0.0",
  "id": "filing-a-drive-artifact.preparation",
  "automation": "automation.filing-a-drive-artifact",
  "intent": "operate",
  "input": {
    "artifact": {
      "identityState": "private-exact",
      "contentRead": false,
      "retentionDecision": "human-owned",
      "subjectSelection": "registered-only"
    }
  },
  "expected": {
    "capabilityOrder": [
      "storage.registry.read",
      "storage.artifacts.read",
      "documents.schema.read",
      "documents.records.read",
      "crm.records.read",
      "workspace.identity.read"
    ],
    "effectModes": {
      "read": "allow",
      "disclosure": "allow",
      "write": "confirm",
      "dispatch": "prohibit",
      "destructive": "prohibit"
    },
    "outcomes": [
      "storage-policy.grounded",
      "artifact-metadata.grounded",
      "registered-home.selected-or-inbox",
      "external-artifact.shortcut-form",
      "existing-artifact.human-move-only",
      "document-index.complete-or-held",
      "writes-held-for-separate-authority"
    ],
    "invariants": [
      "retention-remains-human-owned",
      "folders-never-invented",
      "copy-never-simulates-move",
      "move-rename-delete-never-automated",
      "index-requirement-not-silently-dropped",
      "relations-and-options-never-invented",
      "artifact-content-never-loaded",
      "no-write-or-approval-during-preparation"
    ],
    "evidence": [
      "exact-lock",
      "storage-registry-fingerprint",
      "artifact-metadata-fingerprint",
      "document-schema-fingerprint",
      "duplicate-query-fingerprint",
      "private-values-sanitized"
    ]
  }
}
