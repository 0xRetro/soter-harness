{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://automations/contact-capture/decision/v1",
  "title": "Contact Capture grounded decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["$contract", "contractVersion", "id", "automation", "runId", "createdAt", "configurationLockFingerprint", "graphFingerprint", "context", "producer", "state", "decisionType", "payload", "issues", "privacy", "decisionFingerprint"],
  "properties": {
    "$contract": { "const": "soter://contracts/automation-decision/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^decision\\.contact-capture\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "automation.contact-capture" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "runId": { "type": "string", "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "configurationLockFingerprint": { "$ref": "#/$defs/fingerprint" },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "snapshotFingerprint"],
      "properties": {
        "snapshotId": { "type": "string", "pattern": "^context\\.contact-capture\\.connected-acquisition\\.[a-f0-9]{24}$" },
        "snapshotFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "host"],
      "properties": {
        "kind": { "enum": ["host", "user", "fixture"] },
        "id": { "type": "string", "minLength": 1 },
        "host": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      },
      "allOf": [{
        "if": { "properties": { "kind": { "const": "host" } } },
        "then": { "properties": { "host": { "type": "string" } } },
        "else": { "properties": { "host": { "type": "null" } } }
      }]
    },
    "state": { "enum": ["ready", "needs-input"] },
    "decisionType": { "const": "contact-capture.grounded-create" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparedWork", "policy", "schema", "duplicates", "organizationResolution", "person", "warnings", "limitations"],
      "properties": {
        "preparedWork": { "$ref": "#/$defs/preparedWork" },
        "policy": { "$ref": "#/$defs/policy" },
        "schema": { "$ref": "#/$defs/schema" },
        "duplicates": { "$ref": "#/$defs/candidateSet" },
        "organizationResolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "entryId", "entryFingerprint", "candidates"],
          "properties": {
            "requested": { "type": "boolean" },
            "entryId": { "type": ["string", "null"], "enum": ["context.contact-capture.organization", null] },
            "entryFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
            "candidates": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/recordReference" } }
          },
          "allOf": [{
            "if": { "properties": { "requested": { "const": false } } },
            "then": { "properties": { "entryId": { "type": "null" }, "entryFingerprint": { "type": "null" }, "candidates": { "maxItems": 0 } } },
            "else": { "properties": { "entryId": { "type": "string" }, "entryFingerprint": { "$ref": "#/$defs/fingerprint" } } }
          }]
        },
        "person": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "email", "role", "status", "disposition", "authority", "tags", "telegram", "signal", "github", "timezoneUtc", "source", "organizationUris", "duplicateSearchValues", "afterFingerprint"],
          "properties": {
            "name": { "type": "string", "minLength": 2, "maxLength": 200 },
            "email": { "type": ["string", "null"], "minLength": 3, "maxLength": 320 },
            "role": { "$ref": "#/$defs/nullableText" },
            "status": { "$ref": "#/$defs/nullableText" },
            "disposition": { "$ref": "#/$defs/nullableText" },
            "authority": { "$ref": "#/$defs/textList" },
            "tags": { "$ref": "#/$defs/textList" },
            "telegram": { "$ref": "#/$defs/nullableText" },
            "signal": { "$ref": "#/$defs/nullableText" },
            "github": { "$ref": "#/$defs/nullableText" },
            "timezoneUtc": { "$ref": "#/$defs/nullableText" },
            "source": { "$ref": "#/$defs/nullableText" },
            "organizationUris": { "$ref": "#/$defs/textList" },
            "duplicateSearchValues": { "$ref": "#/$defs/textList" },
            "afterFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        "warnings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 12 } },
        "limitations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 12 } }
      }
    },
    "issues": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 12 } },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "redactions"],
      "properties": {
        "scope": { "const": "private" },
        "redactions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 12 } }
      }
    },
    "decisionFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "allOf": [{
    "if": { "properties": { "state": { "const": "ready" } } },
    "then": { "properties": { "issues": { "maxItems": 0 }, "payload": { "properties": { "duplicates": { "properties": { "candidates": { "maxItems": 0 } } } } } } },
    "else": { "properties": { "issues": { "minItems": 1 } } }
  }],
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableText": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
    "textList": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "recordReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "recordFingerprint"],
      "properties": { "recordId": { "type": "string", "minLength": 1, "maxLength": 500 }, "recordFingerprint": { "$ref": "#/$defs/fingerprint" } }
    },
    "preparedWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "reviewMaterialFingerprint", "inputContractFingerprint"],
      "properties": {
        "id": { "type": "string", "pattern": "^work\\.contact-capture\\.[a-f0-9]{24}$" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "reviewMaterialFingerprint": { "$ref": "#/$defs/fingerprint" },
        "inputContractFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionId", "definitionFingerprint", "entryId", "entryFingerprint", "externalRecordId", "externalRecordFingerprint"],
      "properties": {
        "definitionId": { "const": "policy.context.crm.contact-capture" },
        "definitionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "entryId": { "const": "context.contact-capture.policy-selection" },
        "entryFingerprint": { "$ref": "#/$defs/fingerprint" },
        "externalRecordId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "externalRecordFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "entryFingerprint", "schemaFingerprint"],
      "properties": {
        "entryId": { "const": "context.contact-capture.schema" },
        "entryFingerprint": { "$ref": "#/$defs/fingerprint" },
        "schemaFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "candidateSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "entryFingerprint", "candidates"],
      "properties": {
        "entryId": { "const": "context.contact-capture.duplicates" },
        "entryFingerprint": { "$ref": "#/$defs/fingerprint" },
        "candidates": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/recordReference" } }
      }
    }
  }
}
