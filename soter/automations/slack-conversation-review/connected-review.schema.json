{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/slack-conversation-review-connected-review/v1",
  "title": "Soter private selected-work connected Slack conversation review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "fingerprint", "createdAt", "work", "snapshot",
    "configuration", "window", "coverage", "conversations", "messages", "threads",
    "injection", "authority", "privacy"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/slack-conversation-review-connected-review/v1" },
    "contractVersion": { "const": "1.0.0" },
    "fingerprint": { "$ref": "#/$defs/fingerprint" },
    "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "checkpointFingerprint", "privateInputFingerprint"],
      "properties": {
        "id": { "type": "string", "pattern": "^work\\.slack-conversation-review\\.[a-f0-9]{24}$" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "checkpointFingerprint": { "$ref": "#/$defs/fingerprint" },
        "privateInputFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "runId"],
      "properties": {
        "id": { "type": "string", "pattern": "^context\\.slack-conversation-review\\.connected-acquisition\\.[a-f0-9]{24}$" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "runId": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lockFingerprint", "graphFingerprint", "host"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "host": { "const": "codex" }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "oldestInclusive", "latestExclusive", "fingerprint"],
      "properties": {
        "kind": { "enum": ["last-24-hours", "last-7-days"] },
        "oldestInclusive": { "type": "string", "minLength": 20, "maxLength": 40 },
        "latestExclusive": { "type": "string", "minLength": 20, "maxLength": 40 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "conversations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/conversation" }
    },
    "messages": {
      "type": "array",
      "items": { "$ref": "#/$defs/message" }
    },
    "threads": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/thread" }
    },
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suspected", "count", "fingerprint"],
      "properties": {
        "suspected": { "type": "boolean" },
        "count": { "$ref": "#/$defs/count" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "reasonCode", "approvalIncluded", "continuationIncluded",
        "providerWriteIncluded", "retryAuthorityIncluded"
      ],
      "properties": {
        "state": { "const": "none" },
        "reasonCode": { "const": "SLACK_CONNECTED_REVIEW_SELECTED_WORK_ONLY" },
        "approvalIncluded": { "const": false },
        "continuationIncluded": { "const": false },
        "providerWriteIncluded": { "const": false },
        "retryAuthorityIncluded": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope", "projection", "normalizedPrivateBodiesIncluded",
        "rawProviderResponsesIncluded", "paginationCursorsIncluded",
        "workspaceInspectionIncluded", "evidenceIncluded", "canonicalArtifactsIncluded"
      ],
      "properties": {
        "scope": { "const": "private-local-selected-work" },
        "projection": { "const": "explicit-selected-work-only" },
        "normalizedPrivateBodiesIncluded": { "const": true },
        "rawProviderResponsesIncluded": { "const": false },
        "paginationCursorsIncluded": { "const": false },
        "workspaceInspectionIncluded": { "const": false },
        "evidenceIncluded": { "const": false },
        "canonicalArtifactsIncluded": { "const": false }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableText": { "type": ["string", "null"], "maxLength": 2000 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete", "selectedConversationCount", "conversationObservedCount",
        "conversationIncludedCount", "conversationExcludedCount", "conversationPagesRead",
        "messageWindowCount", "messageObservedCount", "messageIncludedCount",
        "messageExcludedCount", "messagePagesRead", "windowThreadRootCount",
        "selectedThreadCount", "selectedWindowRootCount", "selectedExplicitCount",
        "unselectedWindowRootCount", "threadObservedCount", "threadIncludedCount",
        "threadExcludedCount", "threadMessageCount", "threadPagesRead",
        "conversationFingerprint", "messageWindowFingerprint", "threadFingerprint",
        "coverageFingerprint"
      ],
      "properties": {
        "complete": { "const": true },
        "selectedConversationCount": { "$ref": "#/$defs/count" },
        "conversationObservedCount": { "$ref": "#/$defs/count" },
        "conversationIncludedCount": { "$ref": "#/$defs/count" },
        "conversationExcludedCount": { "$ref": "#/$defs/count" },
        "conversationPagesRead": { "$ref": "#/$defs/count" },
        "messageWindowCount": { "$ref": "#/$defs/count" },
        "messageObservedCount": { "$ref": "#/$defs/count" },
        "messageIncludedCount": { "$ref": "#/$defs/count" },
        "messageExcludedCount": { "$ref": "#/$defs/count" },
        "messagePagesRead": { "$ref": "#/$defs/count" },
        "windowThreadRootCount": { "$ref": "#/$defs/count" },
        "selectedThreadCount": { "$ref": "#/$defs/count" },
        "selectedWindowRootCount": { "$ref": "#/$defs/count" },
        "selectedExplicitCount": { "$ref": "#/$defs/count" },
        "unselectedWindowRootCount": { "$ref": "#/$defs/count" },
        "threadObservedCount": { "$ref": "#/$defs/count" },
        "threadIncludedCount": { "$ref": "#/$defs/count" },
        "threadExcludedCount": { "$ref": "#/$defs/count" },
        "threadMessageCount": { "$ref": "#/$defs/count" },
        "threadPagesRead": { "$ref": "#/$defs/count" },
        "conversationFingerprint": { "$ref": "#/$defs/fingerprint" },
        "messageWindowFingerprint": { "$ref": "#/$defs/fingerprint" },
        "threadFingerprint": { "$ref": "#/$defs/fingerprint" },
        "coverageFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversationId", "kind", "name", "visibility", "shared", "permalink",
        "identityFingerprint", "fingerprint"
      ],
      "properties": {
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["public-channel", "private-channel"] },
        "name": { "$ref": "#/$defs/nullableText" },
        "visibility": { "enum": ["public", "private"] },
        "shared": { "type": "boolean" },
        "permalink": { "$ref": "#/$defs/nullableText" },
        "identityFingerprint": { "$ref": "#/$defs/fingerprint" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversationId", "messageId", "authorParticipantId", "sentAt", "replyCount",
        "content", "contentFingerprint", "messageFingerprint", "suspectedInjection"
      ],
      "properties": {
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "messageId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "authorParticipantId": { "$ref": "#/$defs/nullableText" },
        "sentAt": { "type": "string", "minLength": 20, "maxLength": 40 },
        "replyCount": { "$ref": "#/$defs/count" },
        "content": { "type": "string", "maxLength": 100000 },
        "contentFingerprint": { "$ref": "#/$defs/fingerprint" },
        "messageFingerprint": { "$ref": "#/$defs/fingerprint" },
        "suspectedInjection": { "type": "boolean" }
      }
    },
    "threadMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId", "authorParticipantId", "sentAt", "isRoot", "content",
        "contentFingerprint", "messageFingerprint", "suspectedInjection"
      ],
      "properties": {
        "messageId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "authorParticipantId": { "$ref": "#/$defs/nullableText" },
        "sentAt": { "type": "string", "minLength": 20, "maxLength": 40 },
        "isRoot": { "type": "boolean" },
        "content": { "type": "string", "maxLength": 100000 },
        "contentFingerprint": { "$ref": "#/$defs/fingerprint" },
        "messageFingerprint": { "$ref": "#/$defs/fingerprint" },
        "suspectedInjection": { "type": "boolean" }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversationId", "rootMessageId", "eligibility", "selectedReferenceFingerprint",
        "coverage", "messages", "fingerprint"
      ],
      "properties": {
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "rootMessageId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "eligibility": { "enum": ["window-root", "explicit-selection"] },
        "selectedReferenceFingerprint": { "$ref": "#/$defs/fingerprint" },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "observedCount", "includedCount", "excludedCount", "pagesRead"],
          "properties": {
            "complete": { "const": true },
            "observedCount": { "$ref": "#/$defs/count" },
            "includedCount": { "$ref": "#/$defs/count" },
            "excludedCount": { "$ref": "#/$defs/count" },
            "pagesRead": { "$ref": "#/$defs/count" }
          }
        },
        "messages": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/threadMessage" } },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
