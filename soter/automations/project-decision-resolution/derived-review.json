        { "id": "date", "label": "Decision date", "type": "text" },
        { "id": "summary", "label": "Complete decision summary", "type": "text" },
        { "id": "processed", "label": "Processed", "type": "boolean" },
        { "id": "visibility", "label": "Visibility", "type": "text" },
        { "id": "projectIds", "label": "Project identities", "type": "string-list" },
