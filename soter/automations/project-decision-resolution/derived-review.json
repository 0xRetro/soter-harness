        { "id": "workItemId", "label": "Exact work-item identity", "type": "text" },
        { "id": "oldText", "label": "Current work-item line", "type": "text" },
        { "id": "newText", "label": "Completed work-item line", "type": "text" },
        { "id": "batchActionIds", "label": "Required complete-group actions", "type": "string-list" }
      ]
