{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://automations/email-triage/proposal/v1",
  "title": "Email triage review proposal",
  "type": "object",
  "required": [
    "$contract", "id", "automation", "decision", "proposalType", "review"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/automation-proposal/v1" },
    "id": {
      "type": "string",
      "pattern": "^proposal\\.email-triage\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "automation": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "automation.email-triage" } }
    },
    "decision": {
      "type": "object",
      "required": ["id", "decisionType"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^decision\\.email-triage\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "decisionType": { "const": "email-triage.grounded-classification" }
      }
    },
    "proposalType": { "const": "email-triage.review-proposal" },
    "review": {
      "type": "object",
      "required": ["$contract", "kind", "privateReview"],
      "properties": {
        "$contract": { "const": "soter://contracts/automation-review/v1" },
        "kind": { "const": "email-triage-review" },
        "privateReview": {
          "type": "object",
          "required": ["state"],
          "properties": { "state": { "const": "available" } }
        }
      }
    }
  }
}
